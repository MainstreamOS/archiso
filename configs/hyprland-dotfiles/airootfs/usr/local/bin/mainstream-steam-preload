#!/bin/bash
# UNUSED. Former option-1 Steam pre-provision for Console Mode: it downloaded
# Steam's ~480MB Deck client DURING the install (network up, progress bar
# showing) to keep that cost off the first boot. Console installs now extract a
# Deck-client seed baked into the ISO via mainstream-steam-seed-extract, so
# nothing invokes this script -- it is kept only as a reference for the
# download-at-install approach.
#
# The Deck client BRANCH is forced via package/beta=steamdeck_stable so the
# pre-fetch matches what Big Picture downloads at boot
# (steam_client_steamdeck_stable_ubuntu12). Plain Steam fetches the regular client
# and the boot would just re-download the Deck one.
#
# It self-bounds (bounded poll loop, then steam -shutdown), so even if it were
# wired up again a stall could not hang the installer.
set -u

command -v steam >/dev/null 2>&1 || exit 0

# The account that boots into gaming is the lowest-uid human user -- the same one
# gaming-mode-arm-check's default_human_user() resolves at boot.
user="$(getent passwd 2>/dev/null \
    | awk -F: '$3 >= 1000 && $3 < 60000 { print $3":"$1 }' \
    | sort -t: -n | head -1 | cut -d: -f2)"
[[ -n "$user" ]] || exit 0
home="$(getent passwd "$user" | cut -d: -f6)"
[[ -d "$home" ]] || exit 0

# A virtual display is needed even just to run the client update. Pull it on
# demand (Console installs only) rather than carrying it on every system.
if ! command -v xvfb-run >/dev/null 2>&1; then
    pacman -Sy --needed --noconfirm xorg-server-xvfb >/dev/null 2>&1 || exit 0
fi

# Pre-extract the bootstrap launcher (so Steam skips its own bootstrap and can't
# clobber the branch marker), then force the Deck branch.
runuser -u "$user" -- bash -lc '
    if [ ! -e ~/.local/share/Steam/steam.sh ] && [ -f /usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz ]; then
        mkdir -p ~/.local/share/Steam
        tar -xf /usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz -C ~/.local/share/Steam 2>/dev/null
    fi
    mkdir -p ~/.local/share/Steam/package
    echo steamdeck_stable > ~/.local/share/Steam/package/beta
' || exit 0

# Launch Steam headless as the user; it reads package/beta and downloads the Deck
# client. Poll for the Deck client manifest, then stop Steam. The poll is bounded
# here and the whole job is bounded by the contextualprocess timeout, so a stall
# can never hang the installer.
marker="$home/.local/share/Steam/package/steam_client_steamdeck_stable_ubuntu12.installed"
runuser -u "$user" -- bash -lc 'setsid xvfb-run -a steam -silent </dev/null >/dev/null 2>&1 &' \
    >/dev/null 2>&1 || exit 0

for _ in $(seq 1 72); do
    [[ -s "$marker" ]] && break
    sleep 5
done

runuser -u "$user" -- steam -shutdown >/dev/null 2>&1 || true
sleep 3
pkill -u "$user" -f steam 2>/dev/null || true
pkill -u "$user" -f Xvfb  2>/dev/null || true
exit 0
