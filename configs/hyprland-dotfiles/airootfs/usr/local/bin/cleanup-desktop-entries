#!/usr/bin/env bash
# =============================================================================
# cleanup-desktop-entries
# Remove custom .desktop overrides for apps the user chose not to install.
# Runs after the Calamares "packages" module (netinstall selections).
# =============================================================================

set -euo pipefail

log()  { echo "[desktop-cleanup] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; _ms_health "WARN: $*"; }
_ms_health() {
    mkdir -p /var/log/mainstream-install 2>/dev/null || return 0
    printf '%s [%s] %s\n' "$(date '+%F %T')" "${0##*/}" "$*" \
        >> /var/log/mainstream-install/health.log 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# 1. IDENTIFY USER
# ---------------------------------------------------------------------------
MAIN_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 <= 1001 {print $1}' \
    | grep -vE '(liveuser|builduser|nobody|root)' | head -n 1 || true)

if [[ -z "$MAIN_USER" ]]; then
    warn "No target user found — skipping desktop entry cleanup."
    exit 0
fi

DESKTOP_DIR="/home/$MAIN_USER/.local/share/applications"

if [[ ! -d "$DESKTOP_DIR" ]]; then
    info "No user applications directory — nothing to clean."
    exit 0
fi

# ---------------------------------------------------------------------------
# 2. PACKAGE → DESKTOP FILE MAPPING
#    Each entry: "package_name:file1.desktop:file2.desktop:..."
#    Only list .desktop files that are custom launchers or hiders for
#    optional (netinstall) packages. System-junk hiders are left alone.
# ---------------------------------------------------------------------------
CLEANUP_MAP=(
    "gimp:gimp.desktop:org.gimp.GIMP.desktop"
    "mpv:mpv.desktop"
    "spotify-launcher:spotify-launcher.desktop"
    "resources:net.nokyan.Resources.desktop"
    "impression:io.gitlab.adhami3310.Impression.desktop"
    "chromium:chromium.desktop"
)

# ---------------------------------------------------------------------------
# 3. REMOVE .DESKTOP FILES FOR UNINSTALLED PACKAGES
# ---------------------------------------------------------------------------
removed=0
kept=0

for entry in "${CLEANUP_MAP[@]}"; do
    IFS=':' read -ra parts <<< "$entry"
    pkg="${parts[0]}"

    if pacman -Qq "$pkg" &>/dev/null; then
        info "  ✓ $pkg is installed — keeping desktop entries"
        (( kept++ )) || true
    else
        for df in "${parts[@]:1}"; do
            target="$DESKTOP_DIR/$df"
            if [[ -f "$target" ]]; then
                rm -f "$target"
                info "  ✗ $pkg not installed — removed $df"
                (( removed++ )) || true
            fi
        done
    fi
done

info "Desktop entry cleanup complete: $removed removed, $kept packages kept."

# ---------------------------------------------------------------------------
# 4. PRUNE DOCK PINNED-APP DEFAULTS FOR UNINSTALLED APPS
#    config.json does not exist yet at this stage — quickshell writes it on
#    first boot from the deployed Config.qml defaults. So prune those defaults
#    here and the first-boot config.json inherits the result. Only the dock
#    array (the one containing "settings") is touched; the launcher array is
#    left alone. Keep folders and the shell pseudo-apps; drop any id with no
#    resolvable .desktop. Runs after section 3, so a removed package's .desktop
#    is already gone and its pin is correctly dropped.
# ---------------------------------------------------------------------------
CONFIG_QML="/home/$MAIN_USER/.config/quickshell/ii/modules/common/Config.qml"

if [[ -f "$CONFIG_QML" ]]; then
    python3 - "$CONFIG_QML" "$MAIN_USER" <<'PYEOF' || warn "Dock prune skipped (Config.qml unreadable)."
import os, re, sys

qml_path, user = sys.argv[1], sys.argv[2]
exempt = {"settings", "welcome-tutorial"}
app_dirs = [
    "/usr/share/applications",
    f"/home/{user}/.local/share/applications",
    "/var/lib/flatpak/exports/share/applications",
    f"/home/{user}/.local/share/flatpak/exports/share/applications",
]

available = set()
for directory in app_dirs:
    try:
        for entry in os.listdir(directory):
            if entry.endswith(".desktop"):
                available.add(entry[:-8].lower())
    except OSError:
        pass

def keep(app_id):
    if app_id.startswith("folder:"):
        return True
    if app_id.lower() in exempt:
        return True
    return app_id.lower() in available

src = open(qml_path, encoding="utf-8").read()
pat = re.compile(r'(property\s+list<string>\s+pinnedApps\s*:\s*\[)(.*?)(\])', re.DOTALL)
dropped = []

def rewrite(m):
    head, body, tail = m.group(1), m.group(2), m.group(3)
    ids = re.findall(r'"([^"]+)"', body)
    if "settings" not in ids:            # dock array only; leave launcher alone
        return m.group(0)
    kept = [i for i in ids if keep(i)]
    if kept == ids:
        return m.group(0)
    dropped.extend(i for i in ids if i not in kept)
    new_body = "\n                    " + ", ".join(f'"{i}"' for i in kept) + ",\n                "
    return head + new_body + tail

new = pat.sub(rewrite, src)
if dropped:
    open(qml_path, "w", encoding="utf-8").write(new)
    print("[desktop-cleanup] INFO:  pruned dock defaults: " + ", ".join(dropped))
else:
    print("[desktop-cleanup] INFO:  dock defaults already clean")
PYEOF
    chown "$MAIN_USER:$MAIN_USER" "$CONFIG_QML" 2>/dev/null || true
fi
