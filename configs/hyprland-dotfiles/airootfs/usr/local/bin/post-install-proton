#!/usr/bin/env bash
# post-install-proton: Installing Proton for Steam
source /usr/local/lib/mainstream-postinstall-common.sh
# shellcheck source=/dev/null
source /usr/local/lib/mainstream-install-choices.sh

# ---------------------------------------------------------------------------
# PROTON: install every Proton picked in the app list (Proton Mainstream unless a
# Custom install changed that) and preseed Steam's compat-tool default
#
# Mirrors setup_proton() from 3.files.sh, adapted for chroot (root context):
#   1. Proton Mainstream comes from the repository; GE-Proton and Proton CachyOS
#      download their latest release into compatibilitytools.d.
#   2. Seed ~/.local/share/Steam/config/config.vdf with the global CompatToolMapping
#      default, the first picked Proton that installed; or patch the existing
#      file's "0" entry without touching per-game overrides or any other setting.
#   3. Link ~/.steam/{root,steam} to the store and fix ownership: everything
#      written under $MAIN_USER_HOME must belong to the user, not root.
#
# Notes:
#   - Steam is not running in chroot, so config.vdf writes are safe.
#   - Seed lands in ~/.local/share/Steam (the real store); ~/.steam/{root,steam}
#     are linked to it, matching the layout Steam builds on first launch.
#   - Variables are pre-initialised to "" so set -u is satisfied throughout.
# ---------------------------------------------------------------------------
# Makes $2 the global Steam default in config.vdf: a new file holds only that
# setting, an existing one has just its "0" CompatToolMapping entry replaced.
_proton_set_default() {  # $1 = label for the log  $2 = tool name
    if mkdir -p "$_GE_CFG_DIR" && [[ ! -f "$_GE_CFG" ]]; then
        info "$1: Creating $_GE_CFG seeded with $2..."
        cat > "$_GE_CFG" <<EOF
"InstallConfigStore"
{
	"Software"
	{
		"Valve"
		{
			"Steam"
			{
				"CompatToolMapping"
				{
					"0"
					{
						"name"		"$2"
						"config"	""
						"priority"	"1"
					}
				}
			}
		}
	}
}
EOF
        info "$1: $_GE_CFG created, global default: $2"
    else
        info "$1: Patching existing $_GE_CFG, global default: $2..."
        python3 - "$_GE_CFG" "$2" <<'PYEOF' \
            || warn "$1: config.vdf patch failed, set the Proton version in Steam."
import os, sys, tempfile

# Write through a symlink rather than replacing it with a plain file.
vdf_path, tool = os.path.realpath(sys.argv[1]), sys.argv[2]
with open(vdf_path, encoding="utf-8", errors="surrogateescape") as f:
    content = f.read()

def skip_space(text, i):
    while i < len(text) and text[i].isspace():
        i += 1
    return i

def string_end(text, i):
    if text[i] != '"':
        raise ValueError(f"expected a quoted token at offset {i}")
    i += 1
    while text[i] != '"':
        i += 2 if text[i] == "\\" else 1
    return i + 1

def value_end(text, i):
    # A value is a quoted string or a brace block of key and value pairs.
    if text[i] == '"':
        return string_end(text, i)
    if text[i] != "{":
        raise ValueError(f"expected a value at offset {i}")
    i = skip_space(text, i + 1)
    while text[i] != "}":
        i = skip_space(text, value_end(text, skip_space(text, string_end(text, i))))
    return i + 1

def patched(content):
    key = content.find('"CompatToolMapping"')
    if key < 0:
        return None
    start = skip_space(content, key + len('"CompatToolMapping"'))
    if content[start] != "{":
        raise ValueError("CompatToolMapping is not a block")
    zero_block = (
        '\n\t\t\t\t\t"0"\n'
        '\t\t\t\t\t{\n'
        f'\t\t\t\t\t\t"name"\t\t"{tool}"\n'
        '\t\t\t\t\t\t"config"\t\t""\n'
        '\t\t\t\t\t\t"priority"\t\t"1"\n'
        '\t\t\t\t\t}'
    )
    # Every earlier global default goes, so the new one is the only "0" entry.
    out, i = [content[:start + 1], zero_block], start + 1
    while True:
        entry = skip_space(content, i)
        if content[entry] == "}":
            out.append(content[i:])
            break
        name_end = string_end(content, entry)
        end = value_end(content, skip_space(content, name_end))
        if content[entry:name_end] != '"0"':
            out.append(content[i:end])
        i = end
    new_content = "".join(out)
    # Refuse to write anything that no longer reads as one whole document.
    root = skip_space(new_content, 0)
    if skip_space(new_content, value_end(new_content, skip_space(new_content, string_end(new_content, root)))) != len(new_content):
        raise ValueError("patched config.vdf does not parse")
    return new_content

try:
    new_content = patched(content)
except (ValueError, IndexError) as error:
    sys.stderr.write(f"Warning: config.vdf could not be read ({error}), leaving it alone.\n")
    sys.exit(1)
if new_content is None:
    sys.stderr.write("Warning: CompatToolMapping not found in config.vdf, skipping patch.\n")
    sys.exit(0)

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(vdf_path)), prefix=".config.vdf.")
try:
    with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write(new_content)
    os.chmod(tmp, os.stat(vdf_path).st_mode & 0o7777)
    os.replace(tmp, vdf_path)
except BaseException:
    os.unlink(tmp)
    raise
print(f"Patched: global Proton default is now {tool}")
PYEOF
    fi
}

_proton_link_and_own() {  # $1 = label for the log
    mkdir -p "$MAIN_USER_HOME/.steam"
    ln -sfnT "$_STEAM_STORE" "$MAIN_USER_HOME/.steam/steam"
    ln -sfnT "$_STEAM_STORE" "$MAIN_USER_HOME/.steam/root"

    # --- 3. Fix ownership ---
    # Everything written under $MAIN_USER_HOME must belong to the user,
    # not root (we are running in chroot as root).
    chown -R "$MAIN_USER:$MAIN_USER" "$_STEAM_STORE" 2>/dev/null || true
    chown -h "$MAIN_USER:$MAIN_USER" \
        "$MAIN_USER_HOME/.steam/steam" "$MAIN_USER_HOME/.steam/root" 2>/dev/null || true
    chown "$MAIN_USER:$MAIN_USER" \
        "$MAIN_USER_HOME/.steam" "$MAIN_USER_HOME/.local/share" "$MAIN_USER_HOME/.local" 2>/dev/null || true
    info "$1: Ownership of Steam dirs set to $MAIN_USER."
}

# Each installer below sets _PROTON_TOOL to the name Steam knows the tool by
# once it is in place.
# Mainstream's own build, which system updates keep current.
_install_proton_mainstream() {
    if ! pacman -Si proton-mainstream &>/dev/null; then
        warn "Proton Mainstream: The repository does not offer it."
        return 1
    fi
    info "Proton Mainstream: Installing from the repository..."
    if pacman -S --needed --noconfirm proton-mainstream; then
        info "Proton Mainstream: Installed."
        _PROTON_TOOL=proton-mainstream
        return 0
    fi
    warn "Proton Mainstream: Install failed."
    return 1
}

# Proton CachyOS has no package, so its latest GitHub release is unpacked into
# compatibilitytools.d like GE-Proton, after its published checksum matches.
_install_proton_cachyos() {
    local compat_dir="$_STEAM_STORE/compatibilitytools.d"
    local api="https://api.github.com/repos/CachyOS/proton-cachyos/releases/latest"
    local json="" levels="x86_64" name="" url="" sum_url="" install_dir="" stage="" expected="" actual="" tool=""
    info "Proton CachyOS: Installing latest release for $MAIN_USER..."
    json=$(curl -fsSL --connect-timeout 15 --max-time 30 "$api" 2>/dev/null) || true
    if [[ -z "$json" ]]; then
        warn "Proton CachyOS: GitHub API query failed, check the network. Skipping."
        return 1
    fi
    # The x86_64_v3 build is faster where the CPU runs it; every x86-64 CPU runs the other.
    cpu_runs_x86_64_v3 && levels="x86_64_v3 x86_64"
    IFS=$'\t' read -r name url sum_url < <(printf '%s' "$json" | python3 -c '
import sys, json
assets = {a.get("name"): a.get("browser_download_url") for a in json.load(sys.stdin).get("assets") or []}
for level in sys.argv[1].split():
    for asset in sorted(n for n in assets if n):
        if asset.startswith("proton-cachyos-") and asset.endswith("-" + level + ".tar.xz"):
            name = asset[:-len(".tar.xz")]
            if assets[asset] and assets.get(name + ".sha512sum"):
                print(name, assets[asset], assets[name + ".sha512sum"], sep="\t")
                sys.exit(0)
' "$levels" 2>/dev/null) || true
    if [[ -z "$name" || -z "$url" || -z "$sum_url" ]]; then
        warn "Proton CachyOS: No x86_64 archive with a checksum in the latest release, skipping."
        return 1
    fi
    # The name becomes a folder that a failed run removes, so it must look like one.
    if [[ ! "$name" =~ ^proton-cachyos-[0-9A-Za-z._-]+$ ]]; then
        warn "Proton CachyOS: unexpected release name '$name', skipping."
        return 1
    fi
    info "Proton CachyOS: Latest release is $name"
    install_dir="$compat_dir/$name"
    if [[ -f "$install_dir/compatibilitytool.vdf" ]]; then
        info "Proton CachyOS: $name already present, skipping download."
    else
        mkdir -p "$compat_dir"
        rm -rf "$compat_dir"/.proton-cachyos.* || true
        stage=$(mktemp -d "$compat_dir/.proton-cachyos.XXXXXX") || stage=""
        if [[ -z "$stage" ]]; then
            warn "Proton CachyOS: Could not create a download folder, skipping."
            return 1
        fi
        info "Proton CachyOS: Downloading $name..."
        if ! curl -fsSL --connect-timeout 15 --max-time 60 -o "$stage/download.sha512sum" "$sum_url"; then
            warn "Proton CachyOS: Checksum download failed, skipping."
        elif ! curl -fL --connect-timeout 15 --speed-limit 10240 --speed-time 60 \
                --max-time 2400 --progress-bar \
                -o "$stage/download.tar.xz" "$url"; then
            warn "Proton CachyOS: Download failed, skipping."
        elif ! read -r expected _ < "$stage/download.sha512sum" \
            || [[ ! "$expected" =~ ^[0-9a-fA-F]{128}$ ]] \
            || ! actual=$(sha512sum "$stage/download.tar.xz") \
            || [[ "${actual%% *}" != "${expected,,}" ]]; then
            warn "Proton CachyOS: $name does not match its published checksum, skipping."
        elif ! tar -xJf "$stage/download.tar.xz" -C "$stage" \
            || [[ ! -f "$stage/$name/compatibilitytool.vdf" ]]; then
            warn "Proton CachyOS: Archive did not unpack to $name, skipping."
        elif rm -rf "$install_dir" && mv "$stage/$name" "$install_dir"; then
            info "Proton CachyOS: Installed $name to $install_dir"
        else
            warn "Proton CachyOS: Could not move $name into place, skipping."
        fi
        rm -rf "$stage" || true
    fi

    if [[ ! -f "$install_dir/compatibilitytool.vdf" ]]; then
        warn "Proton CachyOS: $name is not installed."
        return 1
    else
        # Steam knows a tool by the name its compatibilitytool.vdf declares.
        tool=$(python3 -c '
import re, sys
m = re.search(r"\"compat_tools\"\s*\{\s*\"([^\"]+)\"", open(sys.argv[1], errors="replace").read())
print(m.group(1) if m else "")
' "$install_dir/compatibilitytool.vdf" 2>/dev/null) || true
        [[ -n "$tool" ]] || tool="$name"
        _PROTON_TOOL="$tool"
    fi
}

_STEAM_STORE="$MAIN_USER_HOME/.local/share/Steam"
_GE_CFG_DIR="$_STEAM_STORE/config"
_GE_CFG="$_GE_CFG_DIR/config.vdf"
# The latest GE-Proton release, unpacked into compatibilitytools.d.
_install_ge_proton() {
    local _GE_COMPAT_DIR _GE_API _GE_JSON _GE_TAG _GE_NAME _GE_URL _GE_TOOL _GE_INSTALL_DIR _GE_STAGE
    info "GE-Proton: Installing latest release for $MAIN_USER..."

    _GE_COMPAT_DIR="$_STEAM_STORE/compatibilitytools.d"
    _GE_API="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"

    # --- Resolve the latest tag (e.g. "GE-Proton10-5") ---
    _GE_JSON=""
    _GE_JSON=$(curl -fsSL --connect-timeout 15 --max-time 30 "$_GE_API" 2>/dev/null) || true

    if [[ -z "$_GE_JSON" ]]; then
        warn "GE-Proton: GitHub API query failed — check network. Skipping."
    else
        _GE_TAG=""
        if command -v jq &>/dev/null; then
            _GE_TAG=$(echo "$_GE_JSON" | jq -r '.tag_name' 2>/dev/null) || true
        else
            _GE_TAG=$(echo "$_GE_JSON" | python3 -c \
                "import sys,json; print(json.load(sys.stdin)['tag_name'])" 2>/dev/null) || true
        fi

        if [[ -z "$_GE_TAG" || "$_GE_TAG" == "null" ]]; then
            warn "GE-Proton: Could not determine latest tag — skipping."
        elif [[ ! "$_GE_TAG" =~ ^GE-Proton[0-9A-Za-z._-]+$ ]]; then
            # The tag names a directory and is handed to a program; a value
            # outside its known shape is not used for either.
            warn "GE-Proton: unexpected tag name '$_GE_TAG' — skipping."
        else
            info "GE-Proton: Latest tag is $_GE_TAG"

            # --- Download and extract ---
            # Newer releases ship "<tag>-x86_64.tar.gz", which unpacks to a folder of
            # that name; older ones drop the suffix. ARM archives never match.
            _GE_NAME=""
            _GE_URL=""
            _GE_TOOL=""
            IFS=$'\t' read -r _GE_NAME _GE_URL < <(printf '%s' "$_GE_JSON" | python3 -c '
import sys, json
tag = sys.argv[1]
assets = {a.get("name"): a.get("browser_download_url") for a in json.load(sys.stdin).get("assets") or []}
for name in (tag + "-x86_64", tag):
    if assets.get(name + ".tar.gz"):
        print(name, assets[name + ".tar.gz"], sep="\t")
        break
' "$_GE_TAG" 2>/dev/null) || true
            _GE_INSTALL_DIR="$_GE_COMPAT_DIR/$_GE_NAME"
            if [[ -z "$_GE_NAME" || -z "$_GE_URL" ]]; then
                warn "GE-Proton: No x86_64 archive found for $_GE_TAG, skipping."
            elif [[ -f "$_GE_INSTALL_DIR/compatibilitytool.vdf" ]]; then
                info "GE-Proton: $_GE_NAME already present, skipping download."
            else
                mkdir -p "$_GE_COMPAT_DIR"
                # Unpack beside the final folder and move it in whole, so a failed run
                # never leaves a half-unpacked tool that looks installed.
                rm -rf "$_GE_COMPAT_DIR"/.ge-proton.* || true
                _GE_STAGE=$(mktemp -d "$_GE_COMPAT_DIR/.ge-proton.XXXXXX") || _GE_STAGE=""
                if [[ -z "$_GE_STAGE" ]]; then
                    warn "GE-Proton: Could not create a download folder, skipping."
                else
                    info "GE-Proton: Downloading $_GE_NAME..."
                    # Gives up on a stalled transfer, not on a slow one.
                    if ! curl -fL --connect-timeout 15 --speed-limit 10240 --speed-time 60 \
                            --max-time 2400 --progress-bar \
                            -o "$_GE_STAGE/download.tar.gz" "$_GE_URL"; then
                        warn "GE-Proton: Download failed, skipping."
                    elif ! tar -xzf "$_GE_STAGE/download.tar.gz" -C "$_GE_STAGE" \
                        || [[ ! -f "$_GE_STAGE/$_GE_NAME/compatibilitytool.vdf" ]]; then
                        warn "GE-Proton: Archive did not unpack to $_GE_NAME, skipping."
                    elif rm -rf "$_GE_INSTALL_DIR" && mv "$_GE_STAGE/$_GE_NAME" "$_GE_INSTALL_DIR"; then
                        info "GE-Proton: Installed $_GE_NAME to $_GE_INSTALL_DIR"
                    else
                        warn "GE-Proton: Could not move $_GE_NAME into place, skipping."
                    fi
                    rm -rf "$_GE_STAGE" || true
                fi
            fi

            # Pointing Steam at a tool directory that is not there breaks every
            # game launch until the user notices the setting.
            if [[ -z "$_GE_NAME" || ! -f "$_GE_INSTALL_DIR/compatibilitytool.vdf" ]]; then
                warn "GE-Proton: $_GE_TAG is not installed."
            else
                # Steam knows a tool by the name its compatibilitytool.vdf declares,
                # which so far has always matched the folder.
                _GE_TOOL=$(python3 -c '
import re, sys
m = re.search(r"\"compat_tools\"\s*\{\s*\"([^\"]+)\"", open(sys.argv[1], errors="replace").read())
print(m.group(1) if m else "")
' "$_GE_INSTALL_DIR/compatibilitytool.vdf" 2>/dev/null) || true
                [[ -n "$_GE_TOOL" ]] || _GE_TOOL="$_GE_NAME"
                _PROTON_TOOL="$_GE_TOOL"
                return 0
            fi
        fi
    fi
    return 1
}

_PROTONS=$(chosen_protons)
if [[ -n "$MAIN_USER" ]] && ! command -v steam &>/dev/null; then
    info "Proton: Steam is not installed, skipping."
elif [[ -n "$MAIN_USER" && -z "$_PROTONS" ]]; then
    info "Proton: none was picked, so Steam keeps its own."
elif [[ -n "$MAIN_USER" ]]; then
    # Every picked Proton goes in; Steam's default is the first that did, in
    # the order of preference chosen_protons keeps.
    _DEFAULT_TOOL="" _DEFAULT_LABEL=""
    for _p in $_PROTONS; do
        _PROTON_TOOL=""
        case "$_p" in
            mainstream) _label="Proton Mainstream"; _install_proton_mainstream || true ;;
            ge) _label="GE-Proton"; _install_ge_proton || true ;;
            cachyos) _label="Proton CachyOS"; _install_proton_cachyos || true ;;
        esac
        if [[ -n "$_PROTON_TOOL" && -z "$_DEFAULT_TOOL" ]]; then
            _DEFAULT_TOOL="$_PROTON_TOOL" _DEFAULT_LABEL="$_label"
        fi
    done
    if [[ -n "$_DEFAULT_TOOL" ]]; then
        _proton_set_default "$_DEFAULT_LABEL" "$_DEFAULT_TOOL"
    fi
    # A download that failed can still have created Steam's folders as root.
    if [[ -e "$_STEAM_STORE" ]]; then
        _proton_link_and_own "${_DEFAULT_LABEL:-Proton}"
    fi
fi

info "Post-install synchronization complete. System is ready for reboot."

