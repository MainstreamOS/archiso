#!/usr/bin/env bash
# post-install-boot — Configuring boot and graphics
source /usr/local/lib/mainstream-postinstall-common.sh

info "Verifying target environment..."
if [[ -z "$MAIN_USER" ]]; then
    log "ERROR: Primary user (UID 1000) not detected. Check Calamares logs."
fi

# ---------------------------------------------------------------------------
# 2. THE CALAMARES & BOOT PURGE
# ---------------------------------------------------------------------------
info "Removing installer artifacts and masking redundant setup..."

# Remove Calamares and its autostart triggers
pacman -Rs --noconfirm calamares-mainstream || true
rm -f /etc/xdg/autostart/calamares* || true
rm -f /usr/share/applications/calamares.desktop || true

if [[ -n "$MAIN_USER" ]]; then
    rm -rf "$MAIN_USER_HOME/.config/autostart/calamares"* || true
    rm -f "$MAIN_USER_HOME/Desktop/install-arch.desktop" || true
fi

# ---------------------------------------------------------------------------
# 3. LIVE SERVICE CLEANUP
# ---------------------------------------------------------------------------
info "Removing live-only services..."

# Remove live-ISO-only unit files entirely — disabling is not enough because
# etc-pacman.d-gnupg.mount mounts a tmpfs over the keyring directory,
# destroying any keys written there on every reboot.
for unit in \
    /etc/systemd/system/etc-pacman.d-gnupg.mount \
    /etc/systemd/system/pacman-init.service; do
    if [[ -f "$unit" ]]; then
        systemctl disable "$(basename "$unit")" 2>/dev/null || true
        rm -f "$unit"
        info "Removed live-only unit: $(basename "$unit")"
    fi
done

# Disable other live-ISO-only services (unit files owned by packages, so
# disable only — don't delete).
for svc in \
    reflector.service \
    reflector.timer \
    sshd.service; do
    if systemctl is-enabled "$svc" &>/dev/null; then
        info "Disabling live-only service: $svc"
        systemctl disable "$svc" || true
    fi
done

# Mask systemd-networkd — redundant alongside NetworkManager and can
# cause conflicts if both try to manage the same interface.
# Does NOT affect DNS resolution or keyring connectivity.
systemctl mask systemd-networkd.service || true
systemctl mask systemd-networkd.socket || true
systemctl mask systemd-networkd-persistent-storage.service || true

# ---------------------------------------------------------------------------
# 4. MKINITCPIO PREP
# GPU detection, module injection, modprobe config, and env vars are all
# handled by the install-gpu-drivers shellprocess which runs before this.
# Here we only: clean up the archiso preset and restore the standard
# linux.preset before the final mkinitcpio -P call.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 4b. PLYMOUTH WITH MAINSTREAM THEME
# ---------------------------------------------------------------------------
info "Installing Plymouth boot splash..."
if pacman -S --noconfirm --needed plymouth; then
    THEME_SRC="/tmp/dotfiles-setup/sdata/plymouth/mainstream"
    THEME_DST="/usr/share/plymouth/themes/mainstream"

    if [[ -d "$THEME_SRC" ]]; then
        info "Deploying Mainstream Plymouth theme..."
        rm -rf "$THEME_DST"
        cp -r "$THEME_SRC" "$THEME_DST"
        chown -R root:root "$THEME_DST"
        find "$THEME_DST" -type d -exec chmod 755 {} +
        find "$THEME_DST" -type f -exec chmod 644 {} +
        plymouth-set-default-theme mainstream
        info "Mainstream Plymouth theme configured."
    else
        warn "Mainstream Plymouth theme not found in cloned dotfiles repo — falling back to BGRT."
        plymouth-set-default-theme bgrt
        info "Plymouth BGRT theme configured."
    fi

else
    warn "Plymouth failed to install — boot splash will be skipped."
fi

# Remove archiso-specific mkinitcpio config — it is only valid on the live ISO.
# If left in place, mkinitcpio -P will attempt to build with archiso hooks
# (archiso, archiso_loop_mnt, etc.) that do not exist on the installed system.
info "Removing archiso-specific mkinitcpio config..."
rm -f /etc/mkinitcpio.conf.d/archiso.conf

# The same reading of the disks install-limine used, rather than a second set
# of tests that could disagree with it. The swap probe and the encryption
# hooks below read their answers from it too.
BOOT_LIB="/usr/local/lib/boot-layout.sh"
if [[ ! -r "$BOOT_LIB" ]]; then
    log "ERROR: the boot layout library is missing from $BOOT_LIB; this image is incomplete."
    exit 1
fi
# shellcheck source=/dev/null
source "$BOOT_LIB"
if ! boot_layout_detect; then
    log "ERROR: this layout cannot be booted: ${BOOT_LAYOUT_ERROR}."
    exit 1
fi

# ---------------------------------------------------------------------------
# 4c. GPU DETECTION & CONFIGURATION (shared library)
# Runs after archiso.conf is removed so mkinitcpio.conf changes are safe.
# Sources the single source of truth shared with the dots ./setup path
# (sdata/lib/gpu-config.sh, baked into the ISO at /usr/local/lib/gpu-config.sh). In this
# Calamares chroot we run as root (GPU_SUDO='') and target the install user's
# home for the Hyprland tweaks. The library's small-ESP guard (default 512 MiB)
# skips the explicit early-KMS MODULES on a small reused dual-boot ESP so the
# UKI still fits. The initramfs is rebuilt later by the unconditional
# mkinitcpio -P below, so this only stages the config.
# ---------------------------------------------------------------------------
GPU_LIB="/usr/local/lib/gpu-config.sh"
if [[ -r "$GPU_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$GPU_LIB"
    GPU_SUDO=''

    # resume= is decided after this block, on every install, GPU or none. The
    # library's own probe sees every swap on every attached disk and cannot
    # tell which one the installed system turns on, so it adds nothing here.
    _gpu_swap_partuuid() { :; }

    info "Detecting GPU hardware..."
    if gpu_detect; then
        info "Detected GPU(s):"
        lspci 2>/dev/null | grep -iE "VGA|3D|Display" | while read -r line; do info "  $line"; done || true
        info "GPU autoconfig — Intel=$HAS_INTEL AMD=$HAS_AMD NVIDIA=$HAS_NVIDIA Hybrid=$IS_HYBRID"
        gpu_apply_autoconfig
        if [[ -n "${MAIN_USER:-}" ]]; then
            gpu_apply_hypr_tweaks "$MAIN_USER_HOME"
        fi
        # Anything the configuration could not do is only in memory until this
        # is called, and a reason nobody can read is the same as no reason.
        flush_failures
        info "GPU configuration complete. Intel=$HAS_INTEL AMD=$HAS_AMD NVIDIA=$HAS_NVIDIA Hybrid=$IS_HYBRID"
    else
        warn "No GPU detected via lspci — skipping GPU configuration."
    fi
else
    warn "Shared GPU library not found at $GPU_LIB — skipping GPU configuration."
fi

# Holding back resume= alone does not stop hibernation: on UEFI, systemd
# records where the image went in the HibernateLocation EFI variable and
# resumes from that. This turns hibernation off outright, so logind stops
# offering it.
_block_hibernation() {
    mkdir -p /etc/systemd/sleep.conf.d \
        && printf '%s\n' '[Sleep]' AllowHibernation=no \
            AllowSuspendThenHibernate=no AllowHybridSleep=no \
            > /etc/systemd/sleep.conf.d/50-mainstream-no-hibernate.conf \
        || warn "Could not write /etc/systemd/sleep.conf.d/50-mainstream-no-hibernate.conf; hibernation stays on."
}

# The swap partitions systemd-gpt-auto-generator may turn on by itself when
# /etc/fstab names no swap, in partition order: those of the swap type on the
# root's disk, less any carrying the GPT no-auto attribute (bit 63, which lsblk
# prints in hex). Both partition configs require GPT. It turns on only the
# first it finds and passes over one labeled "_empty" as well, but its manual
# promises every one, and the first it takes need not be the first listed
# here, so anything judged for safety below is judged for any of them.
_gpt_auto_swaps() {
    local disk name ptype flags
    disk=$(lsblk -dno PKNAME "$DISK_HOST_DEV" 2>/dev/null) || disk=""
    [[ -n "$disk" ]] || return 0
    [[ "$disk" == /* ]] || disk="/dev/$disk"
    while read -r name ptype flags; do
        [[ "${ptype,,}" == 0657fd6d-a4ab-43c4-84e5-0933c84b4f4f ]] || continue
        if [[ "$flags" =~ ^0x[0-9a-fA-F]{1,16}$ ]] && (( flags & (1 << 63) )); then
            continue
        fi
        printf '%s\n' "$name"
    done < <(lsblk -nlpo NAME,PARTTYPE,PARTFLAGS "$disk" 2>/dev/null | sort -V)
}

# Only the root is unlocked in the initramfs. An encrypted swap is opened once
# the root is up, from /etc/crypttab or by the generator above, too late for
# the kernel to resume from it.
_swap_is_encrypted() {
    local dtype="" fstype=""
    [[ "$1" == /dev/mapper/* ]] && return 0
    read -r dtype fstype < <(lsblk -dno TYPE,FSTYPE "$1" 2>/dev/null) || true
    [[ "$dtype" == crypt || "$fstype" == crypto_LUKS ]]
}

# Any swap line in /etc/fstab, noauto included, stops the generator from
# turning on a swap partition by its type, and noauto keeps the ones named off.
# Left to the generator, a swap this install did not set up would take memory
# unencrypted beside an encrypted root, ask at every boot for the passphrase of
# one that is LUKS, and lose any hibernation image another system left in it,
# since turning a swap on rewrites its signature. It fails when fstab still
# names none of them, because the generator then turns one on after all.
_fstab_keep_swaps_off() {
    local fstab=/etc/fstab dev partuuid lead="" named=0
    local -a notes=(
        "# Swap partitions on this disk that this install did not set up, kept off."
        "# Any swap line here stops systemd from turning one on by its GPT type."
    ) lines=() devs=()
    (( $# > 0 )) || return 0
    if [[ ! -f "$fstab" ]]; then
        warn "No $fstab to name swap partitions $* in, so systemd will still turn one on by its GPT type at boot."
        return 1
    fi
    for dev in "$@"; do
        partuuid=$(lsblk -dno PARTUUID "$dev" 2>/dev/null) || partuuid=""
        if [[ -z "$partuuid" ]]; then
            warn "Could not read the PARTUUID of swap partition $dev, so $fstab cannot name it."
            continue
        fi
        named=$((named + 1))
        # A rerun finds the line it wrote before.
        if awk -v s="partuuid=${partuuid,,}" \
            'tolower($1) == s && $3 == "swap" { found = 1 } END { exit !found }' "$fstab"; then
            continue
        fi
        lines+=("PARTUUID=$partuuid none swap noauto 0 0")
        devs+=("$dev")
    done
    if (( named == 0 )); then
        warn "No swap partition could be named in $fstab, so systemd will still turn one on by its GPT type at boot."
        return 1
    fi
    (( ${#lines[@]} > 0 )) || return 0
    [[ -n "$(tail -c1 "$fstab")" ]] && lead=$'\n'
    grep -qxF "${notes[0]}" "$fstab" || lead+=$'\n'"$(printf '%s\n' "${notes[@]}")"$'\n'
    if { printf '%s' "$lead"; printf '%s\n' "${lines[@]}"; } >> "$fstab"; then
        info "Kept swap partitions ${devs[*]} off with noauto lines in $fstab."
    else
        warn "Could not write $fstab, so systemd will still turn one of the swap partitions ${devs[*]} on by its GPT type at boot."
        return 1
    fi
}

# Where hibernation may write memory has nothing to do with the graphics, so
# this runs whether or not a GPU was found. /etc/fstab, which the fstab step
# has already written, decides which swap the installed system turns on only
# when it names one. When it names none, as in the default zram layout or when
# Calamares leaves out a swap partition it did not format, systemd turns on a
# swap partition it finds on the root's disk, another system's included.
_apply_hibernation_policy() {
    local src swap_dev partuuid kept_off=0 kc="${KERNEL_CMDLINE:-/etc/kernel/cmdline}"
    local -a fstab_swaps=() swaps=()
    # UUID= and PARTUUID= come back as device paths, and an entry that matches
    # no device as an empty line. Any swap line at all, a swap file's or a
    # noauto one's too, keeps the generator from turning on a partition.
    mapfile -t fstab_swaps < <(findmnt --fstab -n -e -t swap -o SOURCE 2>/dev/null)
    if (( ${#fstab_swaps[@]} > 0 )); then
        # Only a swap that fstab turns on can take a hibernation image. A
        # noauto line keeps its swap off, and the ones this install writes
        # name another system's partitions: resuming from one would restore
        # or throw away that system's hibernation. With none turned on,
        # hibernation stays as an earlier run of this step left it.
        mapfile -t fstab_swaps < <(findmnt --fstab -n -e -t swap -O nonoauto -o SOURCE 2>/dev/null)
        # The first swap entry on a partition. A swap file has no PARTUUID to
        # resume from.
        for src in "${fstab_swaps[@]}"; do
            # Calamares names an encrypted swap by its /dev/mapper path, which
            # exists only while the installer holds the container open.
            if [[ -b "$src" || "$src" == /dev/mapper/* ]]; then
                swaps=("$src")
                break
            fi
        done
    else
        mapfile -t swaps < <(_gpt_auto_swaps)
        if (( ${#swaps[@]} > 0 )); then
            info "No swap in /etc/fstab, so systemd would turn on a swap partition of the root's disk by its GPT type: ${swaps[*]}."
        fi
        # A plain swap beside a plain root stays with systemd, so hibernation
        # still has somewhere to go. Once one swap line is written systemd
        # turns on none of them, so they are all named then, and fstab says
        # which partitions are off.
        for swap_dev in "${swaps[@]}"; do
            if [[ -n "$LUKS_UUID" ]] || _swap_is_encrypted "$swap_dev"; then
                _fstab_keep_swaps_off "${swaps[@]}" && kept_off=1
                break
            fi
        done
    fi
    (( ${#swaps[@]} > 0 )) || return 0
    for swap_dev in "${swaps[@]}"; do
        if _swap_is_encrypted "$swap_dev"; then
            if (( kept_off )); then
                info "Swap $swap_dev is encrypted, so it is kept off and hibernation is turned off."
            else
                info "Swap $swap_dev is encrypted and opens only after the root, too late to resume from, so hibernation is turned off."
            fi
            _block_hibernation
            return 0
        fi
        if [[ -n "$LUKS_UUID" ]]; then
            if (( kept_off )); then
                info "Root is encrypted and swap partition $swap_dev is not, so it is kept off and hibernation is turned off."
            else
                warn "Root is encrypted but swap partition $swap_dev is not, so hibernation is turned off: it would write memory, encryption keys included, to that partition unencrypted."
            fi
            _block_hibernation
            return 0
        fi
    done
    swap_dev=${swaps[0]}
    partuuid=$(lsblk -dno PARTUUID "$swap_dev" 2>/dev/null) || partuuid=""
    [[ -n "$partuuid" ]] || return 0
    if grep -Eq '(^|[[:space:]])resume=' "$kc" 2>/dev/null; then
        return 0
    fi
    # The one cmdline writer lives in the GPU library, and install-limine
    # refuses an image without it, so this branch is only a guard.
    if ! declare -F cmdline_upsert >/dev/null; then
        warn "No resume= for swap $swap_dev: the GPU library that writes the kernel command line is missing."
        return 0
    fi
    cmdline_upsert "resume=PARTUUID=$partuuid"
    info "Hibernation resumes from swap partition $swap_dev."
}
_apply_hibernation_policy

# Apple hardware quirks. Sourced after the GPU library because it reuses
# mkinitcpio_add_modules from it, and a no-op on everything that is not a Mac.
MAC_LIB="/usr/local/lib/mac-config.sh"
if [[ -r "$MAC_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$MAC_LIB"
    if [[ "$(mac_class)" != none ]]; then
        info "Detected Apple hardware, applying Mac quirks..."
        mac_report | while read -r line; do info "  $line"; done || true
        # Nothing has refreshed the sync databases yet: the only refresh in
        # this script belongs to the Limine step further down. arch-mact2 in
        # particular was written into pacman.conf minutes ago and has no
        # database on disk at all, so `pacman -Sl arch-mact2` fails and the
        # firmware install below is skipped on the one edition built to carry
        # it. Refresh here, and only when a package step is actually coming.
        if mac_needs_wl_driver || mac_needs_apple_firmware; then
            pacman -Sy --noconfirm >/dev/null 2>&1 \
                || warn "Pacman database refresh failed before the Mac package steps."
        fi
        # The wl driver for the 2012-2015 Broadcom chips rides on the image as
        # plain package files, since a machine that needs it has no Wi-Fi to
        # fetch it with. Its DKMS hook builds the module against the kernel
        # installed here. The sync repos are the fallback for a wired install
        # on an image that did not carry them.
        if mac_needs_wl_driver; then
            wl_files=()
            # The staged headers are Arch's. On the MacBook edition the kernel
            # is linux-t2, so building against them would build for a kernel
            # that is not running: take the whole set from the repositories
            # instead, where the matching headers live.
            if mac_kernel_is_stock; then
                for pat in broadcom-wl-dkms dkms linux-headers pahole; do
                    for f in /usr/local/share/pkgs/${pat}-[0-9]*.pkg.tar.zst; do
                        [[ -f "$f" ]] && wl_files+=("$f")
                    done
                done
            fi
            if (( ${#wl_files[@]} > 0 )); then
                info "Installing the Broadcom wl driver from the image: ${wl_files[*]##*/}"
                pacman -U --noconfirm --needed "${wl_files[@]}" 2>&1 \
                    || note_failure "wl driver install failed from the bundled packages"
            else
                # shellcheck disable=SC2046
                pacman -S --noconfirm --needed $(mac_wl_packages) 2>&1 \
                    || note_failure "wl driver install failed (no bundled packages, sync repos unreachable)"
            fi
        fi
        mac_apply_autoconfig
        # The MacBook edition carries the arch-mact2 repository, which packages
        # the Wi-Fi and Bluetooth firmware this machine needs. A few megabytes
        # from there beats 850 MB of recovery image from Apple, so it is tried
        # first; the fetch below still runs and does nothing if the files
        # arrived, and is the only route on every other edition.
        if mac_needs_apple_firmware && pacman -Sl arch-mact2 >/dev/null 2>&1; then
            info "Installing Apple Wi-Fi and Bluetooth firmware from arch-mact2..."
            pacman -S --noconfirm --needed apple-bcm-firmware 2>&1 \
                || note_failure "apple-bcm-firmware install failed; falling back to the fetch from Apple"
        fi
        mac_fetch_firmware_now
        info "Mac configuration complete."
    fi
fi

# Encrypted installs: install-limine puts rd.luks.name= on the kernel
# cmdline, which only the sd-encrypt hook honors — without it the initramfs
# cannot unlock the root volume. Insert it after sd-vconsole so plymouth
# still owns the passphrase prompt.
if [[ -n "$LUKS_UUID" ]]; then
    if ! grep -qE '^HOOKS=.*sd-encrypt' /etc/mkinitcpio.conf; then
        sed -i 's/\(^HOOKS=.*sd-vconsole\)/\1 sd-encrypt/' /etc/mkinitcpio.conf
        if grep -qE '^HOOKS=.*sd-encrypt' /etc/mkinitcpio.conf; then
            info "Encrypted root detected — added sd-encrypt to mkinitcpio HOOKS."
        else
            warn "Encrypted root detected but sd-encrypt could not be inserted into HOOKS — initramfs will not unlock the root volume."
        fi
    fi
fi

# initcpiocfg adds /crypto_keyfile.bin to FILES for an encrypted root when that
# file exists on the target and /boot is not a partition of its own. No install
# step creates one, since sd-encrypt unlocks the root from the passphrase, so
# this is a backstop: every boot image lands on an unencrypted partition (the
# UKI on the EFI system partition, the initramfs on BIOS's FAT /boot), where a
# key that unlocks the root would sit in the clear.
if grep -qE '^FILES=.*crypto_keyfile\.bin' /etc/mkinitcpio.conf; then
    sed -i -E '/^FILES=/{
        s#(\(|[[:space:]])"?/crypto_keyfile\.bin"?([[:space:]]|\))#\1\2#g
        s#[[:space:]]+# #g
        s#\( #(#
        s# \)#)#
    }' /etc/mkinitcpio.conf
    if grep -qE '^FILES=.*crypto_keyfile\.bin' /etc/mkinitcpio.conf; then
        warn "/crypto_keyfile.bin could not be taken out of FILES in /etc/mkinitcpio.conf; the boot image will carry the root's key unencrypted. Remove it there and run mkinitcpio -P."
    else
        info "Kept /crypto_keyfile.bin out of the boot image."
    fi
fi

# Restore a standard installed-system mkinitcpio preset. On UEFI installs,
# also emit UKIs that Limine can chainload from the ESP.
# Which kernel this image carries. Editions differ: the MacBook one ships
# linux-t2 in place of Arch's linux, and the preset below names the kernel in
# three separate filenames. pkgbase is what pacman recorded for the package that
# owns the modules; uname would report the live ISO's kernel instead.
KERNEL_PKG="$(for d in /usr/lib/modules/*/; do
    [[ -r "$d/pkgbase" ]] || continue
    printf '%s %s\n' "$(basename "$d")" "$(<"$d/pkgbase")"
done | sort -V | tail -n1 | cut -d' ' -f2)"
[[ -n "$KERNEL_PKG" ]] || KERNEL_PKG=linux
# The UKI keeps one name across every edition, because limine.conf.template and
# the checks below look for it by name.
if [[ "$IS_UEFI" == true ]]; then
    mkdir -p /boot/efi/EFI/Linux
    # UEFI: build only the default UKI; no fallback entry means no fallback in menu
    cat > "/etc/mkinitcpio.d/${KERNEL_PKG}.preset" << PRESET
PRESETS=('default')
ALL_kver='/boot/vmlinuz-${KERNEL_PKG}'
default_config='/etc/mkinitcpio.conf'
default_image='/boot/initramfs-${KERNEL_PKG}.img'
default_uki='/boot/efi/EFI/Linux/mainstream_linux.efi'
PRESET
else
    cat > "/etc/mkinitcpio.d/${KERNEL_PKG}.preset" << PRESET
PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-${KERNEL_PKG}'
default_config='/etc/mkinitcpio.conf'
default_image='/boot/initramfs-${KERNEL_PKG}.img'
fallback_config='/etc/mkinitcpio.conf'
fallback_options='-S autodetect'
PRESET
fi
# A preset for a kernel that is not installed fails mkinitcpio -P and takes the
# whole install down with it, so nothing but this one is left in place.
for _p in /etc/mkinitcpio.d/*.preset; do
    [[ -e "$_p" ]] || continue
    [[ "$_p" == "/etc/mkinitcpio.d/${KERNEL_PKG}.preset" ]] || rm -f "$_p"
done

# ---------------------------------------------------------------------------
# ENSURE VALID MACHINE-ID (required by limine-mkinitcpio-hook)
# ---------------------------------------------------------------------------
# mkarchiso sets /etc/machine-id to "uninitialized" (13 chars) for systemd
# first-boot semantics.  limine-mkinitcpio-hook requires a valid 32-char hex
# machine-id to place kernel/initramfs on the EFI partition.  Calamares'
# machineid module should have generated one, but verify and fix if needed.
if ! grep -qE '^[0-9a-f]{32}$' /etc/machine-id 2>/dev/null; then
    warn "Invalid or missing machine-id — generating one..."
    systemd-machine-id-setup 2>/dev/null || \
        tr -d '-' < /proc/sys/kernel/random/uuid > /etc/machine-id
    info "Machine-id set to: $(cat /etc/machine-id)"
fi

# Write Limine's config (branded TARGET_OS_NAME + FIND_BOOTLOADERS=no) BEFORE
# installing limine-mkinitcpio-hook below. The package's deploy hook fixes the
# OS entry's display name and fallback handling at creation time during that
# pacman transaction, so the config must already be in place — otherwise the
# entry is created unbranded ("Mainstream OS", not "Mainstream OS\\") and a
# stray "EFI fallback" entry gets added.
write_limine_defaults "$BOOT_PATH"

# ---------------------------------------------------------------------------
# INSTALL SNAPPER + LIMINE AUR PACKAGES (before mkinitcpio -P)
# ---------------------------------------------------------------------------
# These can't be in packages.x86_64 (limine-mkinitcpio-hook breaks the
# archiso build chroot). snapper/snap-pac are in the official repos and the
# two limine packages are pre-built into the [mainstream] file repo
# (file:///usr/local/share/pkgs, on the target's pacman.conf), so pacman -S
# resolves all four — no AUR helper needed.
#
# IMPORTANT: limine-mkinitcpio-hook must be installed BEFORE mkinitcpio -P
# so the hook can manage kernel/initramfs placement on the EFI partition and
# generate proper //linux sub-entries in limine.conf.
info "Installing snapper and Limine integration packages..."
# A successful install must have limine-mkinitcpio-hook: it creates the UKI and
# Limine OS entry. Continuing without it leaves only a temporary entry whose
# kernel and initramfs are intentionally not copied to the ESP. Snapshot support
# is useful but is not allowed to hide a bootable-system failure.
pacman -Sy --noconfirm || warn "Pacman database refresh failed — attempting the mandatory boot package install from bundled databases."
if ! pacman -S --noconfirm --needed limine-mkinitcpio-hook; then
    log "ERROR: the required Limine boot integration package could not be installed."
    exit 1
fi
if ! command -v limine-mkinitcpio >/dev/null 2>&1; then
    log "ERROR: limine-mkinitcpio is unavailable after package installation."
    exit 1
fi
pacman -S --noconfirm --needed snapper snap-pac limine-snapper-sync \
    || warn "Snapshot integration packages could not be installed; boot installation will continue."

# ---------------------------------------------------------------------------
# MKINITCPIO — build the target initramfs in-chroot for every GPU path
# ---------------------------------------------------------------------------
# Used to need a first-boot deferral here for the legacy NVIDIA DKMS
# generations (580xx / 470xx / 390xx): DKMS post-install runs `dkms install`
# without -k, picks up the chroot host's `uname -r` (which is the build
# machine's kernel, not the target's), fails to find that kernel's headers,
# and leaves /lib/modules/<target>/extra/ empty. Then mkinitcpio -P built
# an initramfs missing nvidia.ko, the user booted to a kernel panic, and
# we worked around it with a firstboot systemd unit that rebuilt the
# initramfs after DKMS had a real running kernel to compile against —
# followed by an auto-reboot prompt the user had to accept on first login.
#
# install-gpu-drivers now pre-builds the DKMS source packages into the
# airootfs (build.sh's AUR_DEPS section), pacman -U's them at chroot time,
# and calls `dkms install -k <target_kernel>` so modules land in
# /lib/modules/<target>/extra/ during the install. With modules present,
# mkinitcpio -P succeeds in chroot for every GPU generation — no deferral,
# no firstboot unit, no auto-reboot.

# Free the ESP before building the UKI: drop any stale standalone kernel +
# initramfs left on the ESP root (e.g. from an earlier failed attempt on a
# reused dual-boot ESP). UEFI boots the UKI, so these aren't needed, and on a
# small shared ESP they can fill it and make the UKI write fail.
if [[ "$IS_UEFI" == true ]]; then
    rm -f "/boot/efi/vmlinuz-${KERNEL_PKG}" "/boot/efi/initramfs-${KERNEL_PKG}.img"
fi

info "Regenerating initramfs..."
if ! /usr/bin/mkinitcpio -P; then
    log "ERROR: mkinitcpio failed; refusing to install an unbootable system."
    exit 1
fi

info "Building Limine boot entries..."
if ! limine-mkinitcpio; then
    log "ERROR: limine-mkinitcpio failed; refusing to install an unbootable system."
    exit 1
fi
if [[ "$IS_UEFI" == true ]] && ! compgen -G "/boot/efi/EFI/Linux/*.efi" >/dev/null 2>&1; then
    esp_free=$(df -m /boot/efi 2>/dev/null | awk 'NR==2 {print $4}')
    log "ERROR: UKI missing after Limine build (free ESP space: ${esp_free:-?} MiB)."
    exit 1
fi

# limine-mkinitcpio-hook owns the OS entry (machine-id tracked, real UKI hash +
# cmdline). Two cleanups leave the menu as exactly that entry + Windows:
#   - prune the install-limine bootstrap "/Mainstream OS\\" entry (no "+",
#     protocol: linux) and any generic "/EFI fallback" entry. The hook entry
#     starts "/+", so "^/Mainstream"/"^/EFI fallback" match only the strays.
#   - force the branded name on the hook entry in case it was created before
#     write_limine_defaults set TARGET_OS_NAME (idempotent if already branded).
if [[ -f /boot/efi/limine.conf ]]; then
    awk '
        /^\/Mainstream OS/ { skip=1; next }
        /^\/EFI fallback/  { skip=1; next }
        /^\/[^\/]/         { if (skip) skip=0 }
        skip { next }
        { print }
    ' /boot/efi/limine.conf > /boot/efi/limine.conf.tmp \
        && mv /boot/efi/limine.conf.tmp /boot/efi/limine.conf
    sed -i -E 's,^/\+Mainstream OS\\*$,/+Mainstream OS\\\\,; s,^comment: Mainstream OS\\*$,comment: Mainstream OS\\\\,' \
        /boot/efi/limine.conf
    info "Pruned stray limine entries; hook 'Mainstream OS\\' entry branded."
fi

# Add a boot entry for every Windows install on the machine, not only one that
# shares this ESP. limine's FIND_BOOTLOADERS only probes systemd-boot, rEFInd
# and the generic EFI/BOOT fallback, never Microsoft's bootmgfw.efi. The
# limine-entry-tool EFI entries persist across kernel updates like the others.
if [[ -x /usr/local/bin/mainstream-limine-windows ]]; then
    info "Looking for Windows installs to add to the boot menu..."
    /usr/local/bin/mainstream-limine-windows || warn "The Windows boot entry scan did not finish."
fi

# Clean up plain kernel/initramfs from ESP root now that UKI is in place.
# These stale files can be left by an earlier install attempt. The UKI
# supersedes them and limine-mkinitcpio will only generate entries for files it
# finds, so remove them to prevent a stale non-UKI menu entry.
if [[ "$IS_UEFI" == true ]] && [ -f "/boot/efi/EFI/Linux/mainstream_linux.efi" ]; then
    rm -f "/boot/efi/vmlinuz-${KERNEL_PKG}" "/boot/efi/initramfs-${KERNEL_PKG}.img" || true
fi

# ---------------------------------------------------------------------------
# 5. SDDM THEME, WAYLAND CONFIG & BTRFS FIXES
# ---------------------------------------------------------------------------
