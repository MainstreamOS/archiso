#!/usr/bin/env bash
# =============================================================================
# install-limine (Unified EFI/BIOS & Hardware-Aware Setup)
# =============================================================================

set -euo pipefail

log()  { echo "[install-limine] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; _ms_health "WARN: $*"; }
_ms_health() {
    mkdir -p /var/log/mainstream-install 2>/dev/null || return 0
    printf '%s [%s] %s\n' "$(date '+%F %T')" "${0##*/}" "$*" \
        >> /var/log/mainstream-install/health.log 2>/dev/null || true
}
# A boot problem the install carries on past. post-install-verify reads this
# file and reports what is in it at the first login.
note_boot_failure() {
    mkdir -p /var/lib/mainstream 2>/dev/null || return 0
    printf '%s\n' "$*" >> /var/lib/mainstream/boot-install-failed.log 2>/dev/null || true
}

# --- Boot Layout Check ---
# The shared library reads what the partitioning step built and refuses, in
# words the person can act on, a layout the boot loader cannot start. It is a
# file of the image, beside gpu-config.sh, so a missing one means the image is
# incomplete rather than that this should guess. It runs before anything below
# writes to the target, so a refused layout leaves the target as it was.
BOOT_LIB="/usr/local/lib/boot-layout.sh"
if [[ ! -r "$BOOT_LIB" ]]; then
    log "ERROR: the boot layout library is missing from $BOOT_LIB; this image is incomplete."
    exit 1
fi
# shellcheck source=/dev/null
source "$BOOT_LIB"
if ! boot_layout_detect; then
    log "ERROR: this layout cannot be booted: ${BOOT_LAYOUT_ERROR}."
    exit 1
fi

# --- 0. Kernel & Environment Setup ---
# Which kernel this image carries. Every path below puts the kernel's name in a
# filename, so the name is read rather than assumed. pkgbase is what pacman
# recorded for the package owning the modules, which is the only source that
# tells the truth in here — uname reports the live ISO's kernel, not the
# target's. Highest version wins if an image somehow carries two.
KERNEL_PKG="$(for d in /usr/lib/modules/*/; do
    [[ -r "$d/pkgbase" ]] || continue
    printf '%s %s\n' "$(basename "$d")" "$(<"$d/pkgbase")"
done | sort -V | tail -n1 | cut -d' ' -f2)"
[[ -n "$KERNEL_PKG" ]] || KERNEL_PKG=linux-mainstream
info "Target kernel package: $KERNEL_PKG"

info "Removing archiso mkinitcpio configs..."
rm -f /etc/mkinitcpio.conf.d/archiso.conf || true
# Every preset, not just the stock name: the archiso preset is named for the
# kernel the image carries, and one left behind points at an archiso config
# that is being deleted on this line and at a kernel image that mkarchiso
# emptied out of /boot. mkinitcpio -P walks the whole directory and fails on it,
# which stops the install. The kernel package restores its own preset when it is
# reinstalled below, and post-install-boot writes the final one either way.
rm -f /etc/mkinitcpio.d/*.preset || true

# The Mainstream kernel stays the image's own, with the NVIDIA module DKMS built
# for it there; the image's package store does not list it to reinstall from.
# Another edition's kernel comes from the repos when there is a connection, so
# it moves in lockstep with the driver packages install-gpu-drivers upgrades.
KERNEL_REINSTALLED=false
if [[ "$KERNEL_PKG" != linux-mainstream* ]] \
   && curl -fsS --max-time 8 -o /dev/null https://archlinux.org &>/dev/null; then
    info "Network available — reinstalling the $KERNEL_PKG kernel..."
    # The --overwrite "*" ensures we clean up any symlink mess from the live environment
    #
    # Bounded below this step's own timeout, and stopped with the interrupt
    # pacman handles by releasing its database lock.
    if timeout -k 30 -s INT 1500 pacman -S --noconfirm --overwrite "*" "$KERNEL_PKG"; then
        KERNEL_REINSTALLED=true
    else
        warn "The $KERNEL_PKG package could not be reinstalled from the repositories; using the kernel this image carries instead."
        # A pacman that had to be killed leaves its lock behind, and every
        # later package step of the install would stop on it.
        rm -f /var/lib/pacman/db.lck
    fi
fi
if [[ "$KERNEL_REINSTALLED" != true ]]; then
    # Otherwise the live image itself is the kernel source. The ISO build empties
    # /boot before squashing and the linux package ships no /boot files — the
    # image there is produced by the mkinitcpio hook during a pacman
    # transaction — but the package's own copy at /usr/lib/modules/<kver>/vmlinuz
    # survives the build, and it is by construction the same version as the
    # modules unpacked beside it and as every driver already baked in.
    KVER=$(for d in /usr/lib/modules/*/; do
        [[ -f "$d/vmlinuz" && -r "$d/pkgbase" ]] || continue
        [[ "$(<"$d/pkgbase")" == "$KERNEL_PKG" ]] || continue
        basename "$d"
    done | sort -V | tail -n1)

    if [[ -n "$KVER" ]]; then
        info "Restoring /boot/vmlinuz-$KERNEL_PKG from the live image (kernel $KVER)..."
        install -Dm644 "/usr/lib/modules/$KVER/vmlinuz" "/boot/vmlinuz-$KERNEL_PKG"
    else
        log "ERROR: no kernel image under /usr/lib/modules and none could be fetched, so the system would not boot."
        exit 1
    fi
fi

# The other chosen kernels go in before the GPU step, which builds the NVIDIA
# module for every kernel; post-install-boot removes the ones not chosen.
CHOICES_LIB=/usr/local/lib/mainstream-install-choices.sh
# shellcheck source=/dev/null
[[ -r "$CHOICES_LIB" ]] && source "$CHOICES_LIB"
CHOSEN_KERNELS=(linux-mainstream)
if declare -F chosen_kernels >/dev/null; then
    read -ra CHOSEN_KERNELS <<< "$(chosen_kernels)"
fi
# Room on the boot partition for each one's boot image and its snapshot copies.
KERNEL_MIN_FREE_MIB=512
install_chosen_kernels() {
    local k free added=0
    for k in "${CHOSEN_KERNELS[@]}"; do
        # By exact name: pacman -Qq also answers for a package that only provides it.
        [[ "$(pacman -Qq "$k" 2>/dev/null)" == "$k" ]] && continue
        # Arch's kernel and its headers come from core, the Mainstream ones from
        # the image's package store, where the installer fetched them.
        if ! pacman -Si "$k" &>/dev/null || ! pacman -Si "$k-headers" &>/dev/null; then
            if [[ "$k" == linux ]]; then
                warn "Arch's kernel needs a connection to the Arch repositories, so it is left out and $KERNEL_PKG stays."
            else
                info "The repository does not offer $k."
            fi
            continue
        fi
        free=$(df -Pm "$BOOT_PATH" 2>/dev/null | awk 'NR==2 {print $4}') || free=""
        if [[ ! "$free" =~ ^[0-9]+$ ]] || (( free < KERNEL_MIN_FREE_MIB * (added + 1) )); then
            info "$BOOT_PATH has ${free:-unknown} MiB free, too little for $k as well; it is left out."
            continue
        fi
        info "Installing $k beside $KERNEL_PKG..."
        if timeout -k 30 -s INT 1500 pacman -S --needed --noconfirm "$k" "$k-headers"; then
            info "$k installed beside $KERNEL_PKG."
            added=$((added + 1))
        else
            warn "$k could not be installed."
            rm -f /var/lib/pacman/db.lck
        fi
    done
}
install_chosen_kernels

# NOTE: mkinitcpio -P is intentionally NOT called here.
# post-install runs after this and modifies mkinitcpio.conf (GPU modules, resume hook),
# so it owns the final mkinitcpio -P call to avoid building the initramfs twice.

# --- 1. Layout Summary & Kernel Command Line ---
if [[ -n "$LUKS_UUID" ]]; then
    info "Encrypted root: $LUKS_BACKING_DEV (LUKS UUID=$LUKS_UUID) → mapper=$LUKS_MAPPER_NAME"
else
    info "Plaintext root: $ROOT_PART_DEV (PARTUUID=$ROOT_PARTUUID)"
fi
info "Root filesystem: $ROOT_FSTYPE${ROOT_SUBVOL:+ on subvolume $ROOT_SUBVOL}"

info "Target Disk: $TARGET_DISK"
info "Root spec: $ROOT_SPEC"
info "Boot Path: $BOOT_PATH (UEFI: $IS_UEFI)"

# The one canonical base command line, from the library the dots ./setup path
# uses as well, baked into the image by build.sh.
GPU_LIB="/usr/local/lib/gpu-config.sh"
if [[ ! -r "$GPU_LIB" ]]; then
    log "ERROR: the shared GPU library is missing from $GPU_LIB; this image is incomplete."
    exit 1
fi
# shellcheck source=/dev/null
source "$GPU_LIB"
KERNEL_CMDLINE="$(gpu_base_cmdline_tokens "$ROOT_SPEC" "$ROOT_SUBVOL" "$ROOT_FSTYPE")"
mkdir -p /etc/kernel
printf '%s\n' "$KERNEL_CMDLINE" > /etc/kernel/cmdline
info "Kernel command line written to /etc/kernel/cmdline"

# --- 2. UEFI boots the UKI (built by post-install), not a standalone
# kernel+initramfs, so do NOT copy those to the ESP: they can be large (the
# legacy NVIDIA live initramfs is ~124 MiB) and would overflow a small shared
# dual-boot ESP before the UKI can be written. post-install prunes the
# template's bootstrap entry. BIOS has no ESP and reads /boot directly.

# --- 3. Installation ---
if [ "$IS_UEFI" = true ]; then
    info "Force-creating EFI directory structure..."
    mkdir -p "$BOOT_PATH/EFI/limine" || exit 1
    mkdir -p "$BOOT_PATH/EFI/BOOT" || exit 1

    # The live ISO boots via systemd-boot, so there is no Limine binary in play
    # at boot for the target to match. The limine package in the airootfs is the
    # single source, which keeps the installed bootloader on Arch's update path.
    INSTALLER_EFI="/usr/share/limine/BOOTX64.EFI"
    info "Copying Limine binary from $INSTALLER_EFI..."
    if [ -f "$INSTALLER_EFI" ]; then
        cp -f "$INSTALLER_EFI" "$BOOT_PATH/EFI/limine/BOOTX64.EFI"
        cp -f "$INSTALLER_EFI" "$BOOT_PATH/EFI/BOOT/BOOTX64.EFI"
        # limine_x64.efi is the copy limine-install replaces on every Limine
        # upgrade, so it is the one the firmware entry below names. One that
        # is already there is left for limine-install to judge and update.
        [ -s "$BOOT_PATH/EFI/limine/limine_x64.efi" ] \
            || cp -f "$INSTALLER_EFI" "$BOOT_PATH/EFI/limine/limine_x64.efi"
    else
        log "CRITICAL: no Limine BOOTX64.EFI available in chroot!"
        exit 1
    fi

    PART_NUM=$(lsblk -no PARTN "$EFI_DEV")
    # Firmware entries an earlier install left for the Limine loader on this
    # partition. They are removed once the new entry exists, so one is listed.
    EFI_PARTUUID=$(lsblk -no PARTUUID "$EFI_DEV" 2>/dev/null) || EFI_PARTUUID=""
    OLD_BOOTNUMS=()
    if [[ -n "$EFI_PARTUUID" ]]; then
        while IFS= read -r _entry; do
            [[ "$_entry" =~ ^Boot([0-9A-Fa-f]{4})[*[:space:]] ]] || continue
            _num=${BASH_REMATCH[1]}
            _entry=${_entry,,}
            if [[ "$_entry" == *",${EFI_PARTUUID,,},"* && "$_entry" == *'\efi\limine\'* ]]; then
                OLD_BOOTNUMS+=("$_num")
            fi
        done < <(efibootmgr -v 2>/dev/null || true)
    fi
    if efibootmgr --create --disk "$TARGET_DISK" --part "$PART_NUM" \
        --label "Mainstream" \
        --loader "\\EFI\\limine\\limine_x64.efi" \
        --unicode; then
        for _num in "${OLD_BOOTNUMS[@]}"; do
            efibootmgr --bootnum "$_num" --delete-bootnum >/dev/null \
                || info "Could not remove the earlier firmware boot entry Boot$_num."
        done
    else
        # Not fatal: the firmware finds the copy at EFI/BOOT/BOOTX64.EFI
        # written above without any entry of its own.
        warn "Could not create the Mainstream firmware boot entry; this system starts from the default loader path instead."
        note_boot_failure "The firmware boot entry could not be written. If this computer does not start Mainstream OS by itself, choose its disk from the firmware boot menu."
    fi
else
    info "Installing BIOS MBR..."
    # Stage 3 lives on the /boot partition; `limine bios-install` only
    # writes stages 1-2. Without this copy the bootstrap panics with
    # "Stage 3 file not found".
    if [ -f "/usr/share/limine/limine-bios.sys" ]; then
        cp -f /usr/share/limine/limine-bios.sys "$BOOT_PATH/limine-bios.sys"
    else
        log "CRITICAL: /usr/share/limine/limine-bios.sys missing in chroot!"
        exit 1
    fi
    # Use modern limine CLI syntax. Still non-fatal, since a half-installed
    # system is worse than one the user can repair from a live USB, but not
    # silent: post-install-verify only checks that the files exist, so the
    # failure is recorded where it reports from.
    if limine bios-install "$TARGET_DISK"; then
        info "BIOS stages written to $TARGET_DISK"
    else
        warn "limine bios-install failed on $TARGET_DISK — this system may not boot. Repair with: limine bios-install $TARGET_DISK"
        note_boot_failure "The boot loader could not be written to $TARGET_DISK, so this system may not start. Repair from a live USB with: limine bios-install $TARGET_DISK"
    fi

    # Keeping stages 1-2 (MBR) and stage 3 (limine-bios.sys) in step across
    # future limine upgrades is handled by 61-limine-bios.hook, shipped by the
    # mainstream-system package (packages.x86_64) rather than written here — so
    # one copy covers both fresh installs and machines already in the field.
    if [[ ! -x /usr/bin/limine-bios-sync ]]; then
        warn "limine-bios-sync missing — mainstream-system may be too old. Future limine upgrades will not re-write the MBR."
    fi
fi

# An earlier Mainstream OS keeps copies of its boot images for its snapshots on
# the EFI partition, in a folder named by its machine id, and they would stay
# there for good once its menu block is gone. $1 holds the menu blocks just
# taken out, $2 the menu that is kept. A folder goes only when the removed
# blocks name it, nothing kept names it, and every root partition those blocks
# start is gone or is the one being installed to; anything less certain stays.
remove_gone_boot_copies() {
    local gone="$1" kept="$2" id spec dev roots=0 own target
    own="$(tr -d '[:space:]' < /etc/machine-id 2>/dev/null || true)"
    target="$(readlink -f -- "${LUKS_BACKING_DEV:-$ROOT_PART_DEV}" 2>/dev/null || true)"
    [[ -s "$gone" && -n "$target" ]] || return 0
    while IFS= read -r spec; do
        roots=$((roots + 1))
        case "$spec" in
            root=PARTUUID=*)  dev="/dev/disk/by-partuuid/${spec#root=PARTUUID=}" ;;
            rd.luks.name=*)   spec="${spec#rd.luks.name=}"; dev="/dev/disk/by-uuid/${spec%%=*}" ;;
            *)                return 0 ;;
        esac
        if [[ -e "$dev" && "$(readlink -f -- "$dev")" != "$target" ]]; then
            info "A Mainstream OS install taken out of the boot menu still has its root partition ($dev), so its boot image copies are left on the EFI partition."
            return 0
        fi
    done < <(grep -oE '(root=[^[:space:]]+|rd\.luks\.name=[^[:space:]]+)' "$gone" | grep -v '^root=/dev/mapper/' | sort -u)
    (( roots > 0 )) || return 0
    while IFS= read -r id; do
        [[ "$id" != "$own" && -d "$BOOT_PATH/$id/limine_history" ]] || continue
        grep -qiF -- "$id" "$kept" 2>/dev/null && continue
        if rm -rf -- "$BOOT_PATH/$id/limine_history"; then
            rmdir -- "$BOOT_PATH/$id" 2>/dev/null || true
            info "Removed the boot image copies of an earlier Mainstream OS install from the EFI partition ($BOOT_PATH/$id/limine_history)."
            _ms_health "INFO: Removed the boot image copies of an earlier Mainstream OS install from the EFI partition ($BOOT_PATH/$id/limine_history)."
        else
            info "The boot image copies of an earlier Mainstream OS install could not be removed from $BOOT_PATH/$id/limine_history."
        fi
    done < <(grep -oE '(machine-id=[0-9a-f]{32}|boot\(\):/[0-9a-f]{32}/limine_history/)' "$gone" | grep -oE '[0-9a-f]{32}' | sort -u)
}

# --- 4. Configuration Deployment ---
TEMPLATE="/etc/limine.conf.template"

CONF_DEST="$BOOT_PATH/limine.conf"
# Where the config made from the template is written: into place, unless the
# EFI partition is shared and another system's boot menu is already on it.
# That file stays, with a dated copy beside it, for limine-mkinitcpio to add
# this system's entry to, and the config from the template is set aside for
# post-install-boot to fall back on if the kept file cannot take the entry.
CONF_OUT="$CONF_DEST"
CONF_FRESH="/var/lib/mainstream/limine.conf.fresh"

if [ -f "$TEMPLATE" ]; then
    if [ "$IS_UEFI" = true ] && grep -qE '^[[:space:]]*/' "$CONF_DEST" 2>/dev/null; then
        CONF_BACKUP="$CONF_DEST.$(date +%Y%m%d-%H%M%S).bak"
        cp -f "$CONF_DEST" "$CONF_BACKUP" || CONF_BACKUP=""
        # A Mainstream OS block in that file starts the boot image this install
        # is about to replace, so it belongs to a system that is going away and
        # is not a reason to keep the file. A top-level entry starts a line
        # with a single "/".
        mkdir -p "${CONF_FRESH%/*}"
        CONF_PRUNED="$CONF_FRESH.kept"
        CONF_GONE="$CONF_FRESH.gone"
        : > "$CONF_GONE"
        awk -v gone="$CONF_GONE" '
            /^\/\+?Mainstream OS/ { skip=1; next }
            /^\/[^\/]/            { skip=0 }
            skip { print > gone; next }
            { print }
        ' "$CONF_DEST" > "$CONF_PRUNED" || { cp -f "$CONF_DEST" "$CONF_PRUNED"; : > "$CONF_GONE"; }
        remove_gone_boot_copies "$CONF_GONE" "$CONF_PRUNED"
        if grep -qE '^[[:space:]]*/' "$CONF_PRUNED"; then
            if ! cmp -s "$CONF_PRUNED" "$CONF_DEST"; then
                cp -f "$CONF_PRUNED" "$CONF_DEST.new" && mv -f "$CONF_DEST.new" "$CONF_DEST" \
                    || warn "The entry of an earlier Mainstream OS install could not be removed from the boot menu kept on the EFI partition."
            fi
            if [ -n "$CONF_BACKUP" ]; then
                warn "Kept the boot menu already on the EFI partition ($CONF_DEST, copy saved as $CONF_BACKUP). Mainstream OS is added to it, and its default entry stays as that menu set it."
            else
                warn "Kept the boot menu already on the EFI partition ($CONF_DEST); a copy of it could not be saved. Mainstream OS is added to it."
            fi
            CONF_OUT="$CONF_FRESH"
        elif [ -n "$CONF_BACKUP" ]; then
            _msg="Replaced the boot menu of an earlier Mainstream OS install on the EFI partition ($CONF_DEST, copy saved as $CONF_BACKUP)."
            info "$_msg"
            _ms_health "INFO: $_msg"
        else
            warn "Replaced the boot menu of an earlier Mainstream OS install on the EFI partition ($CONF_DEST); a copy of it could not be saved."
        fi
        rm -f "$CONF_PRUNED" "$CONF_GONE"
    fi
    info "Deploying configuration..."
    # `|` delimiter avoids clashes with the `/dev/mapper/...` path in the LUKS
    # branch. The current template carries REPLACE_ME_CMDLINE and gets the whole
    # canonical cmdline substituted in; REPLACE_ME_ROOT_SPEC / REPLACE_ME_UUID
    # are accepted for backwards compatibility with older templates.
    # REPLACE_ME_KERNEL names the temporary entry after the kernel this image
    # carries, which is the name limine-mkinitcpio looks for when it replaces it.
    if grep -q 'REPLACE_ME_CMDLINE' "$TEMPLATE"; then
        sed -e "s|REPLACE_ME_KERNEL|$KERNEL_PKG|g" \
            -e "s|REPLACE_ME_CMDLINE|$KERNEL_CMDLINE|g" "$TEMPLATE" > "$CONF_OUT"
    elif grep -q 'REPLACE_ME_ROOT_SPEC' "$TEMPLATE"; then
        sed "s|REPLACE_ME_ROOT_SPEC|$ROOT_SPEC|g" "$TEMPLATE" > "$CONF_OUT"
    else
        sed "s|REPLACE_ME_UUID|${ROOT_PARTUUID:-}|g" "$TEMPLATE" > "$CONF_OUT"
    fi
    rm -f "$TEMPLATE"
    info "Config deployed to $CONF_OUT, template removed."
elif [ -f "$CONF_DEST" ]; then
    info "Config already deployed at $CONF_DEST — skipping."
else
    log "ERROR: Template missing at $TEMPLATE and no existing config at $CONF_DEST"
    exit 1
fi

info "Limine installation complete."
