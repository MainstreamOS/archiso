#!/usr/bin/env bash
# =============================================================================
# install-limine (Unified EFI/BIOS & Hardware-Aware Setup)
# =============================================================================

set -euo pipefail

log()  { echo "[install-limine] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; _ms_health "WARN: $*"; }
_ms_health() {
    mkdir -p /var/log/mainstream-install 2>/dev/null || return 0
    printf '%s [%s] %s\n' "$(date '+%F %T')" "${0##*/}" "$*" \
        >> /var/log/mainstream-install/health.log 2>/dev/null || true
}

# --- 0. Kernel & Environment Setup ---
info "Removing archiso mkinitcpio configs..."
rm -f /etc/mkinitcpio.conf.d/archiso.conf || true
rm -f /etc/mkinitcpio.d/linux.preset || true

# With a network connection the kernel MUST come from the repos, not the
# squashfs: install-gpu-drivers runs next and upgrades kernel-locked driver
# packages (nvidia-open's dependency on linux is unversioned), so a target
# left on the ISO's baked kernel would have its only matching NVIDIA modules
# replaced by ones built for a kernel it does not have — a driverless first
# boot that every check still reports as clean. Reinstalling linux here keeps
# the kernel in lockstep with whatever the driver step installs minutes later.
if ping -c1 -W3 archlinux.org &>/dev/null; then
    info "Network available — reinstalling linux kernel..."
    # The --overwrite "*" ensures we clean up any symlink mess from the live environment
    if ! pacman -S --noconfirm --overwrite "*" linux; then
        log "ERROR: the linux package could not be reinstalled — the system would not boot."
        exit 1
    fi
else
    # Offline, the squashfs itself is the kernel source. The ISO build empties
    # /boot before squashing and the linux package ships no /boot files — the
    # image there is produced by the mkinitcpio hook during a pacman
    # transaction — but the package's own copy at /usr/lib/modules/<kver>/vmlinuz
    # survives the build, and it is by construction the same version as the
    # modules unpacked beside it and as every driver already baked in.
    KVER=$(for d in /usr/lib/modules/*/; do
        [[ -f "$d/vmlinuz" && -r "$d/pkgbase" ]] || continue
        [[ "$(<"$d/pkgbase")" == "linux" ]] || continue
        basename "$d"
    done | sort -V | tail -n1)

    if [[ -n "$KVER" ]]; then
        info "No network — restoring /boot/vmlinuz-linux from the squashfs (kernel $KVER)..."
        install -Dm644 "/usr/lib/modules/$KVER/vmlinuz" /boot/vmlinuz-linux
    else
        log "ERROR: no kernel image under /usr/lib/modules and no network to fetch one — the system would not boot."
        exit 1
    fi
fi

# NOTE: mkinitcpio -P is intentionally NOT called here.
# post-install runs after this and modifies mkinitcpio.conf (GPU modules, resume hook),
# so it owns the final mkinitcpio -P call to avoid building the initramfs twice.

# --- 1. Hardware Detection ---
# Get the real root partition. For an encrypted install findmnt returns the
# LUKS mapper (e.g. /dev/mapper/luks-<uuid>) — the underlying partition is
# what owns the LUKS UUID we need on the kernel cmdline.
ROOT_PART_DEV=$(findmnt -n -o SOURCE / | sed 's/\[.*\]//')

# ROOT_SPEC is what gets substituted into the cmdline. For plain installs
# this is `root=PARTUUID=<partuuid>`; for LUKS installs it is
# `rd.luks.name=<luksuuid>=<mapper> root=/dev/mapper/<mapper>` so that
# sd-encrypt unlocks the partition before the kernel mounts root.
# DISK_HOST_DEV is the partition we hand to lsblk PKNAME to learn which
# whole disk hosts the install (used when there is no separate ESP).
if [[ "$ROOT_PART_DEV" == /dev/mapper/* ]]; then
    LUKS_MAPPER_NAME=$(basename "$ROOT_PART_DEV")
    LUKS_BACKING_DEV=$(cryptsetup status "$LUKS_MAPPER_NAME" 2>/dev/null \
        | awk '/^[[:space:]]*device:/ {print $2; exit}')
    if [[ -z "$LUKS_BACKING_DEV" ]]; then
        log "ERROR: cannot resolve LUKS backing device for $LUKS_MAPPER_NAME"
        exit 1
    fi
    LUKS_UUID=$(cryptsetup luksUUID "$LUKS_BACKING_DEV")
    if [[ -z "$LUKS_UUID" ]]; then
        log "ERROR: cannot read LUKS UUID from $LUKS_BACKING_DEV"
        exit 1
    fi
    ROOT_SPEC="rd.luks.name=${LUKS_UUID}=${LUKS_MAPPER_NAME} root=/dev/mapper/${LUKS_MAPPER_NAME}"
    DISK_HOST_DEV="$LUKS_BACKING_DEV"
    info "Encrypted root: $LUKS_BACKING_DEV (LUKS UUID=$LUKS_UUID) → mapper=$LUKS_MAPPER_NAME"
else
    ROOT_PARTUUID=$(lsblk -dno PARTUUID "$ROOT_PART_DEV")
    if [[ -z "$ROOT_PARTUUID" ]]; then
        log "ERROR: cannot resolve PARTUUID for $ROOT_PART_DEV"
        exit 1
    fi
    ROOT_SPEC="root=PARTUUID=${ROOT_PARTUUID}"
    DISK_HOST_DEV="$ROOT_PART_DEV"
    info "Plaintext root: $ROOT_PART_DEV (PARTUUID=$ROOT_PARTUUID)"
fi

if mountpoint -q /boot/efi; then
    BOOT_PATH="/boot/efi"
    IS_UEFI=true
    EFI_DEV=$(findmnt -n -o SOURCE /boot/efi)
    TARGET_DISK=$(lsblk -dno PKNAME "$EFI_DEV")
else
    BOOT_PATH="/boot"
    IS_UEFI=false
    # -d (nodeps): a LUKS-backing partition also reports its open mapper's
    # PKNAME, and the multi-line value would corrupt TARGET_DISK.
    TARGET_DISK=$(lsblk -dno PKNAME "$DISK_HOST_DEV")
fi

# Ensure TARGET_DISK has the /dev/ prefix
[[ "$TARGET_DISK" != /* ]] && TARGET_DISK="/dev/$TARGET_DISK"

info "Target Disk: $TARGET_DISK"
info "Root spec: $ROOT_SPEC"
info "Boot Path: $BOOT_PATH (UEFI: $IS_UEFI)"

# Canonical base cmdline from the shared GPU library (the same source the dots
# ./setup path uses), baked into the ISO at /usr/local/lib/gpu-config.sh by
# build.sh. The fallback below MUST mirror gpu_base_cmdline_tokens.
GPU_LIB="/usr/local/lib/gpu-config.sh"
if [[ -r "$GPU_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$GPU_LIB"
    KERNEL_CMDLINE="$(gpu_base_cmdline_tokens "$ROOT_SPEC" "@")"
else
    warn "Shared GPU library not found at $GPU_LIB — using the inline canonical base."
    KERNEL_CMDLINE="$ROOT_SPEC rootflags=subvol=@ rw rootfstype=btrfs zswap.enabled=0 quiet splash rd.udev.log_level=3 vt.global_cursor_default=0 consoleblank=0 nowatchdog nmi_watchdog=0 audit=0"
fi
mkdir -p /etc/kernel
printf '%s\n' "$KERNEL_CMDLINE" > /etc/kernel/cmdline
info "Kernel command line written to /etc/kernel/cmdline"

# --- 2. UEFI boots the UKI (built by post-install), not a standalone
# kernel+initramfs, so do NOT copy those to the ESP: they can be large (the
# legacy NVIDIA live initramfs is ~124 MiB) and would overflow a small shared
# dual-boot ESP before the UKI can be written. post-install prunes the
# template's bootstrap entry. BIOS has no ESP and reads /boot directly.

# --- 3. Installation ---
if [ "$IS_UEFI" = true ]; then
    info "Force-creating EFI directory structure..."
    mkdir -p "$BOOT_PATH/EFI/limine" || exit 1
    mkdir -p "$BOOT_PATH/EFI/BOOT" || exit 1

    # build.sh stages the exact upstream EFI binary which booted this ISO. Do
    # not silently prefer the distro package: a version difference here defeats
    # testing on firmware with an EFI-loader compatibility quirk.
    INSTALLER_EFI="/usr/local/share/mainstream/limine/BOOTX64.EFI"
    if [[ ! -f "$INSTALLER_EFI" ]]; then
        INSTALLER_EFI="/usr/share/limine/BOOTX64.EFI"
        warn "Staged upstream Limine EFI binary missing; using distro copy at $INSTALLER_EFI."
    fi
    info "Copying Limine binary from $INSTALLER_EFI..."
    if [ -f "$INSTALLER_EFI" ]; then
        cp -f "$INSTALLER_EFI" "$BOOT_PATH/EFI/limine/BOOTX64.EFI"
        cp -f "$INSTALLER_EFI" "$BOOT_PATH/EFI/BOOT/BOOTX64.EFI"
    else
        log "CRITICAL: no Limine BOOTX64.EFI available in chroot!"
        exit 1
    fi

    PART_NUM=$(lsblk -no PARTN "$EFI_DEV")
    if ! efibootmgr --create --disk "$TARGET_DISK" --part "$PART_NUM" \
        --label "Mainstream" \
        --loader "\\EFI\\limine\\BOOTX64.EFI" \
        --unicode; then
        log "ERROR: could not create the Mainstream UEFI NVRAM entry. Refusing to report a bootable installation."
        exit 1
    fi
else
    info "Installing BIOS MBR..."
    # Stage 3 lives on the /boot partition; `limine bios-install` only
    # writes stages 1-2. Without this copy the bootstrap panics with
    # "Stage 3 file not found".
    if [ -f "/usr/share/limine/limine-bios.sys" ]; then
        cp -f /usr/share/limine/limine-bios.sys "$BOOT_PATH/limine-bios.sys"
    else
        log "CRITICAL: /usr/share/limine/limine-bios.sys missing in chroot!"
    fi
    # Use modern limine CLI syntax. Still non-fatal — a half-installed system is
    # worse than one the user can repair from a live USB — but no longer silent:
    # warn() lands in /var/log/mainstream-install/health.log, which the health
    # report surfaces. post-install-verify only checks that the files exist, so
    # without this a failed MBR write reported a clean install.
    if limine bios-install "$TARGET_DISK"; then
        info "BIOS stages written to $TARGET_DISK"
    else
        warn "limine bios-install failed on $TARGET_DISK — this system may not boot. Repair with: limine bios-install $TARGET_DISK"
    fi

    # Keeping stages 1-2 (MBR) and stage 3 (limine-bios.sys) in step across
    # future limine upgrades is handled by 61-limine-bios.hook, shipped by the
    # mainstream-system package (packages.x86_64) rather than written here — so
    # one copy covers both fresh installs and machines already in the field.
    if [[ ! -x /usr/bin/limine-bios-sync ]]; then
        warn "limine-bios-sync missing — mainstream-system may be too old. Future limine upgrades will not re-write the MBR."
    fi
fi

# --- 4. Configuration Deployment ---
TEMPLATE="/etc/limine.conf.template"

CONF_DEST="$BOOT_PATH/limine.conf"

if [ -f "$TEMPLATE" ]; then
    info "Deploying configuration..."
    # `|` delimiter avoids clashes with the `/dev/mapper/...` path in the LUKS
    # branch. The current template carries REPLACE_ME_CMDLINE and gets the whole
    # canonical cmdline substituted in; REPLACE_ME_ROOT_SPEC / REPLACE_ME_UUID
    # are accepted for backwards compatibility with older templates.
    if grep -q 'REPLACE_ME_CMDLINE' "$TEMPLATE"; then
        sed "s|REPLACE_ME_CMDLINE|$KERNEL_CMDLINE|g" "$TEMPLATE" > "$CONF_DEST"
    elif grep -q 'REPLACE_ME_ROOT_SPEC' "$TEMPLATE"; then
        sed "s|REPLACE_ME_ROOT_SPEC|$ROOT_SPEC|g" "$TEMPLATE" > "$CONF_DEST"
    else
        sed "s|REPLACE_ME_UUID|${ROOT_PARTUUID:-}|g" "$TEMPLATE" > "$CONF_DEST"
    fi
    rm -f "$TEMPLATE"
    info "Config deployed to $CONF_DEST, template removed."
elif [ -f "$CONF_DEST" ]; then
    info "Config already deployed at $CONF_DEST — skipping."
else
    log "ERROR: Template missing at $TEMPLATE and no existing config at $CONF_DEST"
    exit 1
fi

info "Limine installation complete."
