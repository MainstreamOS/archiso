#!/usr/bin/env bash
# =============================================================================
# live-setup
# Runs once on first boot of the live ISO to set the wallpaper and
# generate Material You colors so the desktop looks correct immediately.
# This script is safe — it checks for the live ISO environment before running.
# =============================================================================

# Only run on the live ISO
if [[ ! -d "/run/archiso" ]]; then
    exit 0
fi

# Only run if this is liveuser's first session
MARKER="$HOME/.live-setup-done"
[[ -f "$MARKER" ]] && exit 0
touch "$MARKER"

# -----------------------------------------------------------------------------
# FIX: Ensure ~/.local/bin is in PATH.
# SDDM launches Hyprland without sourcing the user's shell config, so tools
# installed to ~/.local/bin (uv, matugen, etc.) are invisible to this script
# when it runs via XDG autostart or exec-once.
# -----------------------------------------------------------------------------
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# Custom wallpaper for live install
DEFAULT_WALL="$HOME/Desktop/Mainstream_Ambient_Ribbon_4K.png"
[[ -f "$DEFAULT_WALL" ]] || DEFAULT_WALL="$HOME/.config/quickshell/ii/assets/images/default_wallpaper.png"

SWITCHWALL="$HOME/.config/quickshell/ii/scripts/colors/switchwall.sh"
# init-qs.sh normally creates the venv, but on the live ISO uv is absent and
# dots-hyprland/sdata/uv/requirements.txt doesn't exist in skel, so the venv
# is never created.  mainstream-python installs materialyoucolor,
# Pillow etc. as system-wide pacman packages, so python3 works without a venv.
# We still export the path so switchwall.sh's "source .../activate" at least
# targets the right location (it will fail silently; python3 then falls back to
# system packages because switchwall.sh has no set -e).
VENV_PATH="$HOME/.local/state/quickshell/.venv"

repair_venv_paths() {
    local venv_path="$1"
    [[ -d "$venv_path" ]] || return 0

    # uv console scripts may put the venv Python path on line 2. Older
    # pre-baked venvs also carried the absolute ISO build-tree path.
    find "$venv_path/bin" -type f -exec \
        sed -i -E "s|/[^\"'[:space:]]*\\.local/state/quickshell/\\.venv|$venv_path|g" {} + 2>/dev/null || true
    find "$venv_path/bin" -maxdepth 1 -type f -exec chmod 755 {} + 2>/dev/null || true
    [[ -f "$venv_path/pyvenv.cfg" ]] && \
        sed -i -E "s|/[^\"'[:space:]]*\\.local/state/quickshell/\\.venv|$venv_path|g" "$venv_path/pyvenv.cfg" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# 1. Create a minimal illogical-impulse config so Quickshell knows which
#    wallpaper to render and enables theming.  Without this file QS has no
#    background.wallpaperPath and renders nothing.
#
#    Also seed background.widgets.clock.style = "cookie" so the live ISO
#    desktop ships with the cookie clock instead of the upstream "digital"
#    default.  QS merges this file with its built-in JsonAdapter defaults on
#    first load, so any unspecified keys still get correct fallbacks.
# ---------------------------------------------------------------------------
CONFIG_DIR="$HOME/.config/illogical-impulse"
CONFIG_FILE="$CONFIG_DIR/config.json"
if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    jq -n --arg wall "$DEFAULT_WALL" \
          --arg type "scheme-neutral" '{
        "background": {
            "wallpaperPath": $wall,
            "thumbnailPath": "",
            "widgets": {
                "clock": {
                    "style": "cookie"
                }
            }
        },
        "appearance": {
            "wallpaperTheming": {
                "enableAppsAndShell": true,
                "enableQtApps": false,
                "terminalGenerationProps": {
                    "forceDarkMode": false
                }
            },
            "palette": {
                "type": $type,
                "accentColor": ""
            }
        }
    }' > "$CONFIG_FILE"
else
    # Config already exists (e.g. user re-ran something post-marker-removal):
    # patch in the cookie clock style without touching anything else.
    tmp=$(mktemp)
    if jq '.background.widgets.clock.style = "cookie"' "$CONFIG_FILE" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$CONFIG_FILE"
    else
        rm -f "$tmp"
    fi
fi

# ---------------------------------------------------------------------------
# 2. Wait for Hyprland to be ready (socket responsive)
# ---------------------------------------------------------------------------
for i in $(seq 1 30); do
    hyprctl version &>/dev/null && break
    sleep 1
done

# ---------------------------------------------------------------------------
# 3. Start swww daemon and wait until it is connected to Wayland
# ---------------------------------------------------------------------------
if ! pgrep -x swww-daemon &>/dev/null; then
    swww-daemon &
fi

for i in $(seq 1 20); do
    swww query &>/dev/null && break
    sleep 0.5
done

# Set the wallpaper via swww (belt-and-suspenders alongside QS rendering)
if [[ -f "$DEFAULT_WALL" ]]; then
    swww img "$DEFAULT_WALL" --transition-type fade --transition-duration 1 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 4. Generate Material You colors
#    On the live ISO the venv is normally not created, but it may be pre-baked
#    into skel by build.sh. We repair paths just in case, then run a fast-path
#    matugen call to ensure the desktop is themed (neutral) before switchwall.
# ---------------------------------------------------------------------------
repair_venv_paths "$VENV_PATH"

if command -v matugen &>/dev/null && [[ -f "$DEFAULT_WALL" ]]; then
    mkdir -p "$HOME/.local/state/quickshell/user/generated/wallpaper"

    # PHASE 1 — fast path: dark mode + initial matugen colors (neutral)
    # Without --prefer, matugen detects multiple source colors in the wallpaper
    # and halts waiting for user input via an interactive TUI.
    matugen image "$DEFAULT_WALL" --mode dark --prefer less-saturation --type scheme-neutral || true

    if [[ -f "$SWITCHWALL" ]]; then
        export ILLOGICAL_IMPULSE_VIRTUAL_ENV="$VENV_PATH"
        # Redirect stdin from /dev/null to avoid stty/ioctl errors
        bash "$SWITCHWALL" --image "$DEFAULT_WALL" --mode dark </dev/null 2>/dev/null || true
    else
        # Fallback: basic Hyprland/SCSS colors only
        matugen image "$DEFAULT_WALL" --mode dark --prefer less-saturation 2>/dev/null || true
    fi
fi

# ---------------------------------------------------------------------------
# 5. Disable lockscreen and sleep on the live ISO
#    Users are just trying out the desktop — locking/sleeping is annoying and
#    can make recovery awkward since the live password may not be obvious.
# ---------------------------------------------------------------------------
killall hypridle 2>/dev/null || true
mkdir -p "$HOME/.config/hypr"
cat > "$HOME/.config/hypr/hypridle.conf" << 'IDLE_EOF'
# Live ISO: idle actions disabled so the session never locks or suspends.
general {
    lock_cmd = hyprctl dispatch global quickshell:lock & pidof qs quickshell hyprlock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch global quickshell:lockFocus
    inhibit_sleep = 3
}
IDLE_EOF

# Restart hypridle with the no-timeout config
hyprctl dispatch exec hypridle 2>/dev/null || true

# ---------------------------------------------------------------------------
# 6. Rebuild font cache and reload Hyprland config
# ---------------------------------------------------------------------------
fc-cache -fv 2>/dev/null || true
hyprctl reload 2>/dev/null || true
