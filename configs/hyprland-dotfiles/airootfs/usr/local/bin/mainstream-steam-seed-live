#!/bin/bash
# Console Mode Steam Deck client pre-provision: does nothing.
#
# Seeding the client means running Steam in the live session, and Steam cannot
# be installed there: the live root is a 1G overlay with no 32-bit packages.
# The target does not need a seed. Its first-boot preload timer
# (mainstream-steam-gamescope-preload) downloads the Deck client by itself.
# The step stays in the installer sequence so the rest of a Console Mode
# install is unchanged.
echo "[steam-seed] Nothing to do: the installed system downloads the Steam Deck client on first boot."
exit 0
