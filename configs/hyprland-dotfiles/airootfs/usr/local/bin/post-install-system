#!/usr/bin/env bash
# post-install-system — Applying system settings
source /usr/local/lib/mainstream-postinstall-common.sh

info "Installing /etc/sudoers.d/pwfeedback (visual feedback at sudo prompts)..."
{
    pwf_tmp=$(mktemp)
    printf 'Defaults pwfeedback\n' > "$pwf_tmp"
    if visudo -cf "$pwf_tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g root "$pwf_tmp" /etc/sudoers.d/pwfeedback
    else
        warn "pwfeedback drop-in failed visudo validation; not installing."
    fi
    rm -f "$pwf_tmp"
}

# ---------------------------------------------------------------------------
# 6b. PACMAN KEYRING INIT + [mainstream] REPO SWITCH (first boot)
# ---------------------------------------------------------------------------
# pacman-key --init often fails in a chroot (no gpg-agent, limited entropy).
# Try it here as a best-effort, but the real guarantee is the first-boot
# oneshot service created below — which also trusts the [mainstream] signing
# key and repoints the repo from the baked-in local file copy to the signed
# GitHub-hosted repo so the prebuilt packages update via pacman -Syu.
info "Initializing pacman keyring (best-effort in chroot)..."
pacman-key --init 2>/dev/null || true
pacman-key --populate archlinux 2>/dev/null || true

# Create a first-boot oneshot that (re-)initializes the keyring with proper
# entropy and a running gpg-agent (unlike the unreliable chroot attempt), then
# trusts the [mainstream] key and switches its repo to GitHub. Logic lives in
# /usr/local/bin/mainstream-keyring-init.
info "Scheduling pacman keyring init + [mainstream] repo switch for first boot..."
cat > /etc/systemd/system/pacman-keyring-init.service << 'KEYRINGEOF'
[Unit]
Description=Initialize the pacman keyring and keep [mainstream] on the signed GitHub repo
# gpg signature validity needs a synced clock, so this wants
# systemd-time-wait-sync, but it must NOT gate the boot. It is triggered by
# pacman-keyring-init.timer, NOT WantedBy=multi-user.target. A oneshot wanted
# by multi-user.target makes multi-user.target WAIT for it; because this unit
# blocks on the NTP round trip (about 40s on first boot) that froze
# multi-user.target to roughly 45s. That delayed power-profiles-daemon
# (After=multi-user.target, dbus-activated), which the quickshell bar
# synchronously activates at startup via UtilButtons' PowerProfiles binding,
# so the bar could not paint for about 21s. Off the critical path,
# multi-user.target reaches early and this keyring work runs in the background
# after the desktop is already up.
# No ConditionPathExists gate and no self-disable: the script is idempotent
# and exits in milliseconds once the keyring and the repo verify, so leaving
# the timer armed is what lets a machine that breaks later heal itself.
After=network-online.target systemd-time-wait-sync.service
Wants=network-online.target systemd-time-wait-sync.service

[Service]
Type=oneshot
# RemainAfterExit=yes would leave the unit active, and a timer that fires at
# an already-active unit does nothing, which turns every later tick into a
# no-op.
RemainAfterExit=no
ExecStart=/usr/local/bin/mainstream-keyring-init
KEYRINGEOF
cat > /etc/systemd/system/pacman-keyring-init.timer << 'KEYRINGTIMEREOF'
[Unit]
Description=Trigger the pacman keyring check off the boot-critical path

[Timer]
OnBootSec=20
OnUnitActiveSec=6h
AccuracySec=2s
Persistent=true

[Install]
WantedBy=timers.target
KEYRINGTIMEREOF
systemctl enable pacman-keyring-init.timer 2>/dev/null || true
info "Pacman keyring init + [mainstream] repo switch scheduled (timer, off critical path)."

# ---------------------------------------------------------------------------
# 6c. ZRAM CONFIGURATION
# ---------------------------------------------------------------------------
# zram-generator needs a config file to create compressed swap in RAM
if command -v zram-generator &>/dev/null || pacman -Q zram-generator &>/dev/null 2>&1; then
    info "Configuring zram swap..."
    cat > /etc/systemd/zram-generator.conf << 'ZRAMEOF'
[zram0]
zram-size = min(ram, 32768)
compression-algorithm = zstd
ZRAMEOF
    info "zram configured."
fi

# ---------------------------------------------------------------------------
# 6d. SYSCTL PERFORMANCE TUNING
# ---------------------------------------------------------------------------
info "Applying sysctl performance tuning..."
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-performance.conf << 'SYSCTLEOF'
# Swap lives in compressed RAM (zram) — swap eagerly, skip readahead
vm.swappiness = 180
vm.page-cluster = 0

# Start flushing dirty pages earlier to avoid big write spikes
vm.dirty_background_ratio = 5
vm.dirty_ratio = 15

# Retain more dentries/inodes in cache — faster file lookups
vm.vfs_cache_pressure = 50

# Raise inotify watch limit for Quickshell file watchers
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512

# Log a task that blocks in D-state for 60s so a wedged suspend/resume leaves a trace
kernel.hung_task_timeout_secs = 60
SYSCTLEOF
info "sysctl tuning applied."

# ---------------------------------------------------------------------------
# 7. SERVICES, SHELL & FINAL PERMISSIONS
# ---------------------------------------------------------------------------
info "Enabling core services and finalizing user shell..."
systemctl set-default graphical.target
systemctl enable sddm.service -f

# cups.socket rather than cups.service: the spooler is started by systemd on
# the first print job. Named here as well as in the Calamares services module
# because an install that takes a different route through the installer still
# has to come out able to print.
for svc in NetworkManager bluetooth fstrim.timer cups.socket; do
    systemctl enable "$svc" 2>/dev/null || true
done

# Most home printers are found over mDNS and answer to a .local name, which
# nothing resolves until nss-mdns is named in nsswitch. The package installs the
# resolver and stops there, so a printer the machine can see advertised is still
# one it cannot reach. Inserted before `dns` so ordinary lookups are unchanged,
# and only when the entry is absent.
if [[ -f /etc/nsswitch.conf ]] && ! grep -q 'mdns_minimal' /etc/nsswitch.conf; then
    sed -i -E 's/^(hosts:.*[[:space:]])(dns)([[:space:]]|$)/\1mdns_minimal [NOTFOUND=return] \2\3/' /etc/nsswitch.conf
fi

# CUPS answers the first backend error by stopping the queue, and then goes on
# accepting jobs into it without running them, so a single transient failure is
# indistinguishable from a machine that cannot print and leaves nothing on
# screen to say otherwise. retry-job keeps the queue enabled and the job visible
# while it retries. This sets the default for queues created later; queues that
# already exist keep whatever policy they were made with.
if [[ -f /etc/cups/cupsd.conf ]] && ! grep -q '^ErrorPolicy' /etc/cups/cupsd.conf; then
    printf '\nErrorPolicy retry-job\nJobRetryInterval 60\nJobRetryLimit 5\n' >> /etc/cups/cupsd.conf
    info "CUPS queues set to retry on backend errors instead of stopping."
fi

# ipp-usb is installed but intentionally left disabled. Its udev rule starts it
# only for a device advertising the IPP-over-USB interface (7/1/4), and udev
# replays those add events at boot, so it covers both hotplug and an already
# attached printer. Enabling the unit would take devices that belong on the
# classic driver path along with it.

# Auto-power-on Bluetooth so paired devices reconnect on boot.
if [[ -f /etc/bluetooth/main.conf ]]; then
    sed -i 's/^#\?AutoEnable\s*=.*/AutoEnable=true/' /etc/bluetooth/main.conf
    grep -q '^AutoEnable' /etc/bluetooth/main.conf || sed -i '/^\[Policy\]/a AutoEnable=true' /etc/bluetooth/main.conf
fi

# ---------------------------------------------------------------------------
# 7a. CJK FONTS + INPUT METHOD: KEEP ONLY WHERE THEY ARE USED
# ---------------------------------------------------------------------------
# The ISO carries noto-fonts-cjk and the fcitx5 input-method stack so the
# installer renders Japanese, Korean, and Chinese instead of mojibake, and
# so those users can actually type their language at first boot instead of
# hand-assembling an IME from a forum thread. An install whose language and
# keyboard both say otherwise gets all of the space back, and a CJK install
# keeps only its own engine.
_cjk_ime=""
_lang=$(grep -oP '^LANG=\K.*' /etc/locale.conf 2>/dev/null | tr -d '"')
case "$_lang" in
    ja_*) _cjk_ime=mozc ;;
    ko_*) _cjk_ime=hangul ;;
    zh_*) _cjk_ime=pinyin ;;
esac
_kb=$(grep -oP 'XkbLayout"?\s+"\K[^"]+' /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null | head -1 || true)
[[ -z "$_kb" ]] && { _kb=$(grep -oP '^KEYMAP=\K.*' /etc/vconsole.conf 2>/dev/null | tr -d '"' | head -1 || true); }
if [[ -z "$_cjk_ime" ]]; then
    case "$_kb" in
        jp*) _cjk_ime=mozc ;;
        kr*) _cjk_ime=hangul ;;
        cn*) _cjk_ime=pinyin ;;
    esac
fi
if [[ -z "$_cjk_ime" ]]; then
    _cjk_remove=()
    for _p in noto-fonts-cjk fcitx5-mozc fcitx5-chinese-addons fcitx5-hangul fcitx5-configtool fcitx5-gtk fcitx5-qt fcitx5; do
        pacman -Q "$_p" &>/dev/null && _cjk_remove+=("$_p")
    done
    if [[ ${#_cjk_remove[@]} -gt 0 ]]; then
        info "Neither the language nor the keyboard uses CJK; removing fonts and input method..."
        pacman -Rns --noconfirm "${_cjk_remove[@]}" 2>/dev/null || warn "Could not remove the CJK stack; leaving it installed."
    fi
else
    _cjk_engines_drop=()
    [[ "$_cjk_ime" != mozc   ]] && pacman -Q fcitx5-mozc &>/dev/null && _cjk_engines_drop+=(fcitx5-mozc)
    [[ "$_cjk_ime" != pinyin ]] && pacman -Q fcitx5-chinese-addons &>/dev/null && _cjk_engines_drop+=(fcitx5-chinese-addons)
    [[ "$_cjk_ime" != hangul ]] && pacman -Q fcitx5-hangul &>/dev/null && _cjk_engines_drop+=(fcitx5-hangul)
    if [[ ${#_cjk_engines_drop[@]} -gt 0 ]]; then
        info "Keeping the $_cjk_ime input method; removing the other engines..."
        pacman -Rns --noconfirm "${_cjk_engines_drop[@]}" 2>/dev/null || true
    fi
fi

# ---------------------------------------------------------------------------
# 7b. FIREWALL DEFAULT ZONE
# ---------------------------------------------------------------------------
if command -v firewall-offline-cmd &>/dev/null && [[ -f /etc/firewalld/zones/MainstreamWorkstation.xml ]]; then
    info "Setting firewalld default zone to MainstreamWorkstation..."
    firewall-offline-cmd --set-default-zone=MainstreamWorkstation 2>/dev/null \
        || warn "Could not set firewalld default zone; staying on package default."
    systemctl enable firewalld.service 2>/dev/null \
        || warn "Could not enable firewalld; firewall will not start at boot."
fi

# ---------------------------------------------------------------------------
# 8. THE USER'S HOME
# ---------------------------------------------------------------------------
# The same code that builds an account made later from Settings, so the two
# cannot drift.
#
# Only the steps this script owns are called. postdesktop runs before
# postfinalize, so post-install-theme has already built the virtualenv and
# generated the colors, and post-install-hyprbars has already compiled and
# stamped the plugins. Laying the dotfiles over the home is skipped too: skel
# was seeded from this release when the image was built, and a machine this
# new has no clone to read anyway.
if [[ -n "$MAIN_USER" ]]; then
    if [[ -r /usr/local/lib/mainstream-provision-user.sh ]]; then
        # shellcheck source=/dev/null
        source /usr/local/lib/mainstream-provision-user.sh

        # The account Calamares made is this machine's owner, and the input
        # method was chosen from the locale further up.
        PROVISION_ADMIN=1
        PROVISION_CJK_IME="$_cjk_ime"
        PROVISION_FAILED=""

        _pu_step groups   provision_groups    "$MAIN_USER"
        # The desktop step writes into the home as its owner, so the owner has
        # to hold it first; the steps before this one wrote parts of it as root.
        _pu_step own      chown -R "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME"
        _pu_step desktop  provision_desktop   "$MAIN_USER"
        _pu_step own      chown -R "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME"
        _pu_step firstrun provision_first_run "$MAIN_USER"

        if [[ -n "$PROVISION_FAILED" ]]; then
            warn "Setting up $MAIN_USER's home did not finish:$PROVISION_FAILED (see $PROVISION_LOG)"
        else
            info "Home set up for $MAIN_USER."
        fi
    else
        warn "The provisioning library is missing; $MAIN_USER's home has not been set up."
    fi
fi  # per-user color and theme setup continues in post-install-theme
