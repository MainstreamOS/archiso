#!/usr/bin/env bash
# =============================================================================
# install-gpu-drivers
# Calamares shellprocess — runs inside the installed system chroot
#
# Installs GPU driver PACKAGES ONLY.
# All mkinitcpio, modprobe, env var, and cmdline configuration is handled
# by post-install section 4c which runs after archiso.conf is removed,
# guaranteeing a clean mkinitcpio.conf baseline.
#
# NVIDIA: proprietary by generation, nouveau for pre-Fermi
# AMD:    amdgpu (open source), radeon for pre-GCN
# Intel:  i915/vulkan-intel, iHD VA-API on Gen8+, i965 on Gen7.5 and older
# =============================================================================

set -uo pipefail

log()  { echo "[install-gpu-drivers] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; _ms_health "WARN: $*"; }
err()  { log "ERROR: $*" >&2; _ms_health "FAIL: $*"; }
_ms_health() {
    mkdir -p /var/log/mainstream-install 2>/dev/null || return 0
    printf '%s [%s] %s\n' "$(date '+%F %T')" "${0##*/}" "$*" \
        >> /var/log/mainstream-install/health.log 2>/dev/null || true
}

# Source the shared GPU library — the single source of truth shared with the
# dots ./setup path (sdata/lib/gpu-config.sh), baked into the ISO at
# /usr/local/lib/gpu-config.sh by build.sh so it is sourced from the trusted
# image rather than a network-cloned tree. Detection (gpu_detect) and NVIDIA
# generation classification (gpu_classify_nvidia_driver) come from there; this
# script keeps the archiso-specific package-install machinery (staged prebuilts
# via pacman -U, DKMS against the target kernel). Sourced BEFORE note_failure
# below so this script's version stays in effect. Vars are pre-seeded so the
# vendor branches stay set -u safe if the lib is ever absent.
GPU_LIB="${GPU_LIB:-/usr/local/lib/gpu-config.sh}"
HAS_NVIDIA=false HAS_AMD=false HAS_INTEL=false IS_HYBRID=false
IS_OLD_AMD=false IS_RDNA4=false NVIDIA_GEN=none INTEL_GEN=none
if [[ -r "$GPU_LIB" ]]; then
    source "$GPU_LIB"
else
    err "Shared GPU library not found at $GPU_LIB — vendor branches will be skipped."
fi

# Track GPU-driver install failures so a broken driver surfaces as a loud,
# unmissable error at the end (and a breadcrumb the desktop can read on
# first boot) instead of the old silent warn+exit-0 soft-pass.
GPU_FAILURES=()
note_failure() { GPU_FAILURES+=("$1"); err "$1"; }

GPU_INFO=$(lspci 2>/dev/null | grep -iE "VGA|3D|Display" || true)
if [[ -z "$GPU_INFO" ]]; then
    # Don't exit: the vulkan-provider catch-all at the bottom must still run,
    # or a later --noconfirm install needing (lib32-)vulkan-driver (Steam)
    # auto-resolves to lib32-nvidia-utils even on GPU-less VMs/headless.
    warn "No GPU detected — vendor branches will be skipped."
else
    info "Detected GPU(s):"
    echo "$GPU_INFO" | while read -r line; do info "  $line"; done
fi

# Detect hardware + NVIDIA generation via the shared library (sets HAS_*/IS_*/
# NVIDIA_GEN; the vars were pre-seeded above so the branches stay set -u safe).
command -v gpu_detect >/dev/null 2>&1 && { gpu_detect || true; }

# Install repo packages for a GPU stack. Filter the target list FIRST:
# pacman -S aborts the entire transaction on one unknown target, which is how
# the stale mesa-vdpau/libva-mesa-driver names (merged into mesa upstream)
# silently skipped lib32-vulkan-radeon — and Steam's --noconfirm provider
# resolution then pulled lib32-nvidia-utils onto AMD-only installs.
#  - in the sync repos        -> install
#  - installed but not in any repo -> already satisfied, skip (feeding it to
#    pacman -S would error "target not found" and abort the whole set)
#  - nowhere                  -> dead/renamed name, reported via $1
# install_pkgs reports problems loudly via note_failure (required driver
# stacks); install_pkgs_opt warns only (best-effort firmware/VA-API extras).
GPU_REPO_RECOVERY_ATTEMPTED=0
_install_pkgs_impl() {
    local report="$1"; shift
    local p transaction_log attempt why avail=() missing=() relaxed=()
    for p in "$@"; do
        if pacman -Si "$p" >/dev/null 2>&1; then
            avail+=("$p")
        elif pacman -Qq "$p" >/dev/null 2>&1; then
            info "$p already installed (not in sync repos) — skipping."
        else
            "$report" "package '$p' not found in repos (renamed/merged upstream?) — skipped."
        fi
    done
    [[ ${#avail[@]} -eq 0 ]] && return 0
    info "Installing: ${avail[*]}"
    transaction_log=$(mktemp) || { "$report" "Could not create the GPU package transaction log."; return 1; }
    # The 32-bit half of a driver stack is dozens of downloads, and one stalled
    # file on a weak Wi-Fi link fails them all. Later tries wait longer.
    for attempt in 1 2 3; do
        if LC_ALL=C pacman -S --noconfirm --needed "${relaxed[@]}" "${avail[@]}" 2>&1 | tee "$transaction_log"; then
            rm -f "$transaction_log"
            return 0
        fi
        grep -qE 'failed retrieving file|failed to retrieve some files|download library error|Operation too slow|timed out|Could not resolve host' "$transaction_log" || break
        (( attempt < 3 )) || break
        info "Download failed; trying again (attempt $((attempt + 1)) of 3)."
        relaxed=(--disable-download-timeout)
        sleep 5
    done
    # An ISO can carry older core metadata than the refreshed multilib repo.
    # Refresh every database and upgrade together; refreshing alone can leave
    # the installed libraries out of step with the requested driver packages.
    if [[ "$GPU_REPO_RECOVERY_ATTEMPTED" -eq 0 ]] \
       && grep -qF 'failed to prepare transaction (could not satisfy dependencies)' "$transaction_log"; then
        GPU_REPO_RECOVERY_ATTEMPTED=1
        info "Dependency resolution failed; refreshing repositories and retrying with a full system upgrade."
        if LC_ALL=C pacman -Syyu --noconfirm --needed "${avail[@]}" 2>&1 | tee "$transaction_log"; then
            rm -f "$transaction_log"
            return 0
        fi
    fi
    # Name what is really missing and why, so the report does not blame a
    # driver that is installed, and pacman's own words outlive the install.
    for p in "${avail[@]}"; do
        pacman -Qq "$p" >/dev/null 2>&1 || missing+=("$p")
    done
    why=$(grep -E '^error: ' "$transaction_log" | tail -n 2 | tr '\n' ' ' | tr -s ' ' | cut -c1-160)
    mkdir -p /var/log/mainstream-install 2>/dev/null \
        && cat "$transaction_log" 2>/dev/null >> /var/log/mainstream-install/gpu-pacman.log
    rm -f "$transaction_log"
    if [[ ${#missing[@]} -eq 0 ]]; then
        warn "pacman could not update: ${avail[*]}. The installed versions stay.${why:+ $why}"
        return 0
    fi
    "$report" "pacman failed for: ${missing[*]}.${why:+ $why}"
}
install_pkgs()     { _install_pkgs_impl note_failure "$@"; }
install_pkgs_opt() { _install_pkgs_impl warn "$@"; }

# Local pre-built AUR packages staged into the airootfs at build time
# (build.sh's AUR_DEPS section). install-gpu-drivers consumes them via
# pacman -U so we never have to run yay-fetch-and-compile from inside the
# Calamares chroot, which was failure-prone (network in chroot, kernel
# version mismatch for DKMS, build-environment fragility).
LOCAL_PKGS_DIR="${LOCAL_PKGS_DIR:-/usr/local/share/pkgs}"

# Find the matching local pkg file(s) by glob. The version in the filename
# varies per build, so we glob for the family name and let pacman -U pick
# up whatever's there.
find_local_pkgs() {
    local pat
    local matches=()
    for pat in "$@"; do
        # Skip -debug- variants — they're makepkg artifacts we don't want.
        local f
        for f in "$LOCAL_PKGS_DIR"/${pat}-[0-9]*.pkg.tar.zst; do
            [[ -f "$f" ]] || continue
            [[ "$f" == *-debug-* ]] && continue
            matches+=("$f")
        done
    done
    # Print nothing on zero matches — an unconditional printf emits one empty
    # line, which mapfile turns into found=("") and pacman -U "" runs instead
    # of the intended "No local pkgs found" warning.
    [[ ${#matches[@]} -gt 0 ]] && printf '%s\n' "${matches[@]}"
    return 0
}

# Install local pre-built packages by family name (e.g. nvidia-580xx-dkms).
# Falls back to a warning if the .pkg.tar.zst is missing from the airootfs.
install_local_pkgs() {
    local found
    mapfile -t found < <(find_local_pkgs "$@")
    if [[ ${#found[@]} -eq 0 ]]; then
        warn "No local pkgs found for: $*"
        return 1
    fi
    info "Installing local pkgs: ${found[*]##*/}"
    pacman -U --noconfirm --needed "${found[@]}" 2>&1 \
        || { warn "pacman -U failed for: $*"; return 1; }
    return 0
}

# Force a DKMS module to (re)build against the TARGET system's kernel
# rather than the build host's kernel that's running inside the chroot.
# Without -k, dkms install picks $(uname -r) which is the chroot host's
# kernel; that's what made the old `get_aur_pkg ... || warn` flow leave
# unbuilt modules and forced the post-install first-boot mkinitcpio
# deferral. With -k pointing at the freshly-unpacked target kernel,
# modules land in /lib/modules/<target>/extra/ at chroot time and
# mkinitcpio -P succeeds immediately.
target_dkms_install() {
    local module="$1"
    local version="$2"

    # Which kernel the target will boot is one question with one answer, and the
    # library holds it. Asking here in a second way is how a machine booting
    # linux-lts got a module built against the stock tree instead.
    local target_kernel
    target_kernel="$(gpu_target_kernel)"
    if [[ -z "$target_kernel" ]]; then
        warn "Could not detect target kernel in /lib/modules — DKMS will use \$(uname -r)."
        target_kernel=""
    else
        info "DKMS building $module/$version against target kernel: $target_kernel"
    fi

    if [[ -n "$target_kernel" ]]; then
        dkms install -m "$module" -v "$version" -k "$target_kernel" 2>&1 \
            || note_failure "DKMS build failed: $module/$version for kernel $target_kernel — GPU kernel module is MISSING."
    else
        dkms install -m "$module" -v "$version" 2>&1 \
            || note_failure "DKMS build failed: $module/$version — GPU kernel module is MISSING."
    fi
}

# Discover the version string from a pre-built DKMS .pkg.tar.zst filename.
# Example: nvidia-580xx-dkms-580.95.05-1-x86_64.pkg.tar.zst → 580.95.05
# That's the value /usr/src/<module>-<version>/ expects.
detect_dkms_version() {
    local family="$1"
    local f v
    f=$(find_local_pkgs "$family" | head -1)
    [[ -z "$f" ]] && return 1
    # pkgrel may be multi-token (e.g. nvidia-470xx-dkms pkgrel "8.02"), so the
    # release segment is [0-9][^-]* (starts with a digit, no further hyphen),
    # not [0-9]+ — the latter silently failed to match 470xx and skipped its
    # DKMS build, shipping Kepler userspace-only with no kernel module.
    v=$(basename "$f" | sed -E "s/^${family}-([^-]+)-[0-9][^-]*-[^-]+\.pkg\.tar\.zst\$/\1/")
    [[ -z "$v" || "$v" == "$(basename "$f")" ]] && return 1
    printf '%s\n' "$v"
}

# The standard image carries the mainline driver, whose userspace blacklists
# nouveau. A card left on nouveau cannot use it, so it comes off the target.
remove_mainline_nvidia() {
    local p present=()
    for p in nvidia-open nvidia-open-dkms nvidia-dkms nvidia-utils; do
        # pacman -Q also answers for a package that only provides the name.
        [[ "$(pacman -Qq "$p" 2>/dev/null)" == "$p" ]] && present+=("$p")
    done
    [[ ${#present[@]} -eq 0 ]] && return 0
    info "Removing the mainline NVIDIA driver so nouveau can load: ${present[*]}"
    pacman -Rns --noconfirm "${present[@]}" 2>&1 \
        || warn "Could not remove ${present[*]}; nouveau stays blacklisted until they are gone."
}

# Standard edition has no legacy NVIDIA prebuilts: fall back to nouveau so the
# target still boots, and breadcrumb the user to the NVIDIA (legacy) edition.
# Never runs on the NVIDIA edition (prebuilts present there).
legacy_nvidia_fallback() {
    local gen="$1"
    warn "Legacy NVIDIA ($gen): proprietary prebuilts not on this edition — falling back to nouveau."
    install_pkgs mesa lib32-mesa
    remove_mainline_nvidia
    note_failure "Legacy NVIDIA ($gen): proprietary drivers are not on this (standard) edition — installed nouveau as a fallback. For full acceleration, reinstall using the MainstreamOS NVIDIA (legacy) edition ISO."
}

# Install one of the frozen legacy NVIDIA DKMS branches (580xx/470xx/390xx) from
# the staged prebuilts named by the classifier's NVIDIA_LOCAL_PKGS array, then
# build the module against the target kernel. Falls back to nouveau when the
# prebuilts are not staged (standard edition). $1 is the human-readable label.
install_legacy_nvidia() {
    local label="$1" dkms_pkg="${NVIDIA_LOCAL_PKGS[0]}"
    if [[ -z "$(find_local_pkgs "$dkms_pkg")" ]]; then
        legacy_nvidia_fallback "$label"
        return
    fi
    # linux rides with the headers for the same reason it rides with
    # nvidia-open below: an unversioned headers upgrade fires the dkms
    # remove hook for the installed kernel, and if the kernel itself is not
    # carried to the same version in the same transaction, the working
    # module is deleted and everything after builds for a kernel that is
    # not there.
    install_pkgs linux linux-headers dkms libva-utils
    install_pkgs_opt libva-nvidia-driver
    # The whole NVIDIA_LOCAL_PKGS set rides one pacman -U: the *-settings package
    # depends on libxnvctrl-*xx, which exists only as a staged file (the repo DB
    # excludes GPU packages), and one unresolvable dep aborts the transaction.
    if install_local_pkgs "${NVIDIA_LOCAL_PKGS[@]}"; then
        local ver; ver=$(detect_dkms_version "$dkms_pkg" || echo "")
        if [[ -n "$ver" ]]; then
            target_dkms_install nvidia "$ver"
        else
            note_failure "$dkms_pkg: could not parse version from staged package — DKMS module NOT built."
        fi
    else
        note_failure "$dkms_pkg: staged packages present but pacman -U failed — $label GPU has no kernel driver."
    fi
    install_pkgs_opt linux-firmware-nvidia
    info "NVIDIA $label — installed $dkms_pkg."
}

pacman -Sy 2>/dev/null || warn "pacman -Sy failed — using cached db."

if $HAS_INTEL; then
    # INTEL_GEN (set by gpu_detect) picks the VA-API driver and decides whether
    # the OpenCL/VPL runtimes are worth installing — see the shared library for
    # the tier boundaries.
    case "$INTEL_GEN" in
        legacy)
            install_pkgs mesa lib32-mesa vulkan-intel lib32-vulkan-intel libva-intel-driver
            ;;
        xe)
            install_pkgs mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver intel-compute-runtime ocl-icd
            install_pkgs_opt linux-firmware-intel vpl-gpu-rt
            ;;
        *)
            install_pkgs mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver
            install_pkgs_opt linux-firmware-intel
            ;;
    esac
    info "Intel generation $INTEL_GEN — packages installed."
fi

if $HAS_AMD; then
    # IS_OLD_AMD (pre-GCN, with the APU exemption + RDNA4 override) comes from
    # gpu_detect — see the shared library for the classification rationale.
    # VA-API/VDPAU are part of mesa itself now — the old libva-mesa-driver /
    # mesa-vdpau split packages no longer exist.
    if $IS_OLD_AMD; then
        # Pre-GCN runs the radeon kernel module and mesa's r300/r600 gallium
        # drivers; RADV is GCN1+ only, so there is no Vulkan driver for this
        # tier. Leaving vulkan-radeon out is deliberate: it provides
        # 'vulkan-driver', which would satisfy the catch-all below and suppress
        # the lavapipe fallback, leaving an ICD that enumerates zero devices.
        install_pkgs mesa lib32-mesa
    else
        install_pkgs mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon
    fi
    install_pkgs_opt linux-firmware-amdgpu
    info "AMD packages installed."
fi

# ── nvidia_ensure_module_for_target ──────────────────────────────────────────
# nvidia-open ships PREBUILT modules under one exact kernel's directory while
# depending on `linux` unversioned. Installing the pair in one transaction keeps
# them together, but it cannot help when the kernel already moved on its own
# earlier in the install and the repo's driver has not been rebuilt for the new
# one yet: the package is current, its module sits where nothing will look, and
# the card comes up with no driver at all, no DRM node and no outputs.
#
# The driver's release number moves every time the kernel does, because the
# module inside it is built against exactly one kernel. A strand is therefore
# never repaired by reinstalling what is already here, which would lay the same
# files back down under the same stale kernel. It is repaired by taking the
# build that matches the kernel now installed, and that build only becomes
# visible once the package database has actually been refreshed. An earlier
# refresh is allowed to fail with a warning, which is how a machine reaches
# this point at all.
nvidia_ensure_module_for_target() {
    local k
    k="$(gpu_target_kernel)"
    if [[ -z "$k" ]]; then
        note_failure "nvidia: could not tell which kernel the target will boot, so the module is unverified."
        return 1
    fi
    if nvidia_module_present "$k"; then
        info "nvidia module present for kernel $k."
        return 0
    fi

    warn "nvidia module missing for kernel $k. Refreshing the database and taking the matching build."
    pacman -Sy 2>&1 || warn "database refresh failed."
    pacman -S --noconfirm --needed nvidia-open 2>&1 || warn "nvidia-open update failed."
    if nvidia_module_present "$k"; then
        info "nvidia module now present for kernel $k."
        return 0
    fi

    # No build matching this kernel has been published yet, so no amount of
    # reinstalling will produce one. DKMS compiles against the headers for the
    # kernel actually installed, so it cannot be stranded the same way.
    #
    # The swap has to be spelled out. The DKMS driver conflicts with the one
    # already here, and pacman's conflict question answers itself with "no"
    # when nothing is allowed to ask, so a single transaction would simply be
    # refused. The toolchain goes in first and on its own: a refused swap must
    # not also cost the headers a build would need.
    warn "No matching build available. Falling back to the DKMS driver, which builds against this kernel."
    # The headers have to belong to the kernel being targeted. A machine booting
    # linux-lts needs linux-lts-headers, and handing that machine linux-headers
    # builds the module against a tree it will never boot, which is the same
    # stranding this function exists to undo.
    local hdr="linux-headers"
    [[ -r "/usr/lib/modules/$k/pkgbase" ]] && hdr="$(<"/usr/lib/modules/$k/pkgbase")-headers"
    pacman -S --noconfirm --needed "$hdr" dkms 2>&1 \
        || warn "could not install the DKMS toolchain ($hdr)."
    # Fetch the replacement first: removing the prebuilt driver and then
    # failing to install its DKMS twin leaves the target with no driver at all.
    if ! pacman -Sw --noconfirm nvidia-open-dkms 2>&1; then
        warn "nvidia-open-dkms is not obtainable; keeping the prebuilt driver in place."
        note_failure "nvidia-open: DKMS package is not obtainable for kernel $k, so the card will have no driver."
        return 1
    fi
    pacman -Rdd --noconfirm nvidia-open 2>&1 \
        || warn "could not remove the prebuilt driver before the swap."
    pacman -S --noconfirm nvidia-open-dkms 2>&1 \
        || warn "nvidia-open-dkms install failed."
    if nvidia_module_present "$k"; then
        info "nvidia module built by DKMS for kernel $k."
        return 0
    fi

    # Installing the package only queues the build. pacman's DKMS hook builds
    # for whichever kernels have headers, and inside an installer that set does
    # not reliably include the one this machine is about to boot. Ask for that
    # kernel by name before concluding there is no driver.
    local dkms_ver
    dkms_ver="$(dkms status -m nvidia 2>/dev/null | head -1 | sed -n 's|^nvidia[/,][[:space:]]*\([^,:]*\).*|\1|p')"
    if [[ -n "$dkms_ver" ]]; then
        info "Asking DKMS for nvidia/$dkms_ver against kernel $k."
        dkms install -m nvidia -v "$dkms_ver" -k "$k" 2>&1 \
            || warn "DKMS build of nvidia/$dkms_ver for kernel $k failed."
        if nvidia_module_present "$k"; then
            info "nvidia module built by DKMS for kernel $k."
            return 0
        fi
    else
        warn "could not read a DKMS version for nvidia."
    fi

    note_failure "nvidia-open: no loadable module for kernel $k, so the card will have no driver."
    return 1
}

# The chosen Mainstream kernels (install-limine) have no prebuilt NVIDIA module,
# so the shared ladder gives each the DKMS driver. One that ends up without a
# module while Arch's kernel has one comes back out, leaving the install as it
# would be without it.
CHOICES_LIB="${CHOICES_LIB:-/usr/local/lib/mainstream-install-choices.sh}"
# shellcheck source=/dev/null
[[ -r "$CHOICES_LIB" ]] && source "$CHOICES_LIB"
MAINSTREAM_KERNELS=(linux-mainstream)
if declare -F chosen_kernels >/dev/null; then
    read -ra MAINSTREAM_KERNELS <<< "$(chosen_kernels | tr ' ' '\n' | grep '^linux-mainstream' | tr '\n' ' ')"
fi
GPU_INSTALL_LIB="${GPU_INSTALL_LIB:-/usr/local/lib/gpu-driver-install.sh}"
# Offline the target has no Arch package database, so the DKMS driver the image
# carries for this (build.sh, mainstream-kernel-nvidia.list) is served as a
# repository of its own while the ladder runs, then taken away again. It is used
# only beside the very userspace and prebuilt driver the image installed, so a
# swap the ladder has to undo can put the same prebuilt driver back.
OFFLINE_NVIDIA_LIST="${OFFLINE_NVIDIA_LIST:-$LOCAL_PKGS_DIR/mainstream-kernel-nvidia.list}"
OFFLINE_NVIDIA_REPO="${OFFLINE_NVIDIA_REPO:-/var/cache/mainstream-offline-nvidia}"
PACMAN_CONF="${PACMAN_CONF:-/etc/pacman.conf}"
offline_nvidia_repo_on() {
    local names=() files=() f name ver conf
    pacman -Si nvidia-open-dkms &>/dev/null && return 1
    [[ -r "$OFFLINE_NVIDIA_LIST" ]] || return 1
    mapfile -t names < <(grep -v '^[[:space:]]*$' "$OFFLINE_NVIDIA_LIST")
    mapfile -t files < <(find_local_pkgs "${names[@]}")
    (( ${#files[@]} > 0 )) || return 1
    for f in "${files[@]}"; do
        read -r name ver < <(pacman -Qp "$f" 2>/dev/null) || return 1
        case "$name" in
            nvidia-open-dkms) [[ "$(pacman -Q nvidia-utils 2>/dev/null | awk '{print $2}')" == "$ver" ]] ;;
            nvidia-open) [[ "$(pacman -Q nvidia-open 2>/dev/null | awk '{print $2}')" == "$ver" ]] ;;
        esac || { info "The offline NVIDIA driver ($name $ver) does not match the installed one."; return 1; }
    done
    mkdir -p "$OFFLINE_NVIDIA_REPO" && cp -f "${files[@]}" "$OFFLINE_NVIDIA_REPO/" \
        && repo-add -q "$OFFLINE_NVIDIA_REPO/mainstream-offline.db.tar.gz" "$OFFLINE_NVIDIA_REPO"/*.pkg.tar.zst \
        && cp -f "$PACMAN_CONF" "$OFFLINE_NVIDIA_REPO/pacman.conf.orig" || { offline_nvidia_repo_off; return 1; }
    printf '\n[mainstream-offline]\nSigLevel = Never\nServer = file://%s\n' "$OFFLINE_NVIDIA_REPO" >> "$PACMAN_CONF"
    # Synced on its own: a refresh of the others would only wait on servers it cannot reach.
    conf="$OFFLINE_NVIDIA_REPO/sync.conf"
    printf '[options]\nArchitecture = auto\n[mainstream-offline]\nSigLevel = Never\nServer = file://%s\n' "$OFFLINE_NVIDIA_REPO" > "$conf"
    pacman -Sy --config "$conf" &>/dev/null || { offline_nvidia_repo_off; return 1; }
    info "No network: serving the image's DKMS NVIDIA driver for $1."
}
offline_nvidia_repo_off() {
    [[ -f "$OFFLINE_NVIDIA_REPO/pacman.conf.orig" ]] && cp -f "$OFFLINE_NVIDIA_REPO/pacman.conf.orig" "$PACMAN_CONF"
    rm -f "${PACMAN_DBPATH:-/var/lib/pacman}/sync/mainstream-offline.db"
    rm -rf "${OFFLINE_NVIDIA_REPO:?}"
}
nvidia_mainstream_kernel() {  # $1 = kernel
    local offline=false MAINSTREAM_KERNEL="$1"
    [[ "$(pacman -Qq "$MAINSTREAM_KERNEL" 2>/dev/null)" == "$MAINSTREAM_KERNEL" ]] || return 0
    if [[ -r "$GPU_INSTALL_LIB" ]] && source "$GPU_INSTALL_LIB"; then
        info "Building the NVIDIA module for $MAINSTREAM_KERNEL as well."
        [[ "${NVIDIA_DRIVER_FAMILY:-}" == nvidia-open ]] && offline_nvidia_repo_on "$MAINSTREAM_KERNEL" && offline=true
        GPU_SUDO="" GPU_DB_REFRESH=true gpu_nvidia_modules_for_added_kernel "$MAINSTREAM_KERNEL" || true
        [[ $offline == true ]] && offline_nvidia_repo_off
    else
        info "The driver library is missing from $GPU_INSTALL_LIB, so no NVIDIA module can be built for $MAINSTREAM_KERNEL."
    fi
    gpu_kernel_nvidia_ready "$MAINSTREAM_KERNEL" && return 0
    warn "No NVIDIA driver could be built for $MAINSTREAM_KERNEL, so it was removed."
    pacman -Rns --noconfirm "$MAINSTREAM_KERNEL" "$MAINSTREAM_KERNEL-headers" 2>&1 \
        || note_failure "$MAINSTREAM_KERNEL has no NVIDIA driver and could not be removed; choose Arch's kernel in the boot menu."
}

if $HAS_NVIDIA; then
    # NVIDIA_GEN (set by gpu_detect) -> driver family + package sets. The caller
    # owns the install: nvidia-open from the repo, a frozen legacy branch from
    # staged prebuilts, or nouveau for pre-Fermi.
    gpu_classify_nvidia_driver
    info "NVIDIA generation $NVIDIA_GEN -> driver family $NVIDIA_DRIVER_FAMILY"
    case "$NVIDIA_DRIVER_FAMILY" in
        nvidia-open)
            # Turing and newer (RTX 2060+, 30xx/40xx/50xx) — the official open
            # source kernel module, same userspace as proprietary.
            #
            # linux rides the same transaction: nvidia-open's modules are built
            # for exactly one kernel version but its linux dependency is
            # unversioned, so a driver upgrade against a db that has moved past
            # the installed kernel would strip the only matching modules and
            # leave none the target can boot with. One transaction means the
            # pair moves together or not at all; --needed makes the kernel a
            # no-op when it is already current.
            install_pkgs linux "${NVIDIA_REPO_PKGS[@]}"
            install_pkgs_opt linux-firmware-nvidia
            nvidia_ensure_module_for_target
            info "NVIDIA Turing+ — installed nvidia-open (official open source kernel module)."
            ;;
        nvidia-580xx) install_legacy_nvidia "Maxwell/Pascal/Volta — GTX 900/1000/Titan V" ;;
        nvidia-470xx) install_legacy_nvidia "Kepler — GTX 600/700" ;;
        nvidia-390xx) install_legacy_nvidia "Fermi — GTX 400/500" ;;
        nouveau|*)
            # Pre-Fermi (Tesla / older) — nouveau is the only realistic option.
            install_pkgs mesa lib32-mesa
            remove_mainline_nvidia
            ;;
    esac
    for _mk in "${MAINSTREAM_KERNELS[@]}"; do
        nvidia_mainstream_kernel "$_mk"
    done

    mapfile -t _nv_extra < <(nvidia_extra_pkgs)
    install_pkgs_opt "${_nv_extra[@]}"

    # PRIME render-offload tool for hybrid (NVIDIA + Intel/AMD).
    [[ $IS_HYBRID == true ]] && install_pkgs nvidia-prime || true

    info "NVIDIA packages installed."
elif [[ -n "$GPU_INFO" && "$(pacman -Qq nvidia-open 2>/dev/null)" == nvidia-open ]]; then
    # The image's module for Arch's kernel would keep the boot setup from making a
    # kernel without it the default; finalize-install removes the rest of the stack.
    info "No NVIDIA GPU: removing the image's NVIDIA kernel module."
    pacman -R --noconfirm nvidia-open 2>&1 \
        || warn "Could not remove nvidia-open; finalize-install tries again."
fi

# ── Vulkan-provider catch-all ────────────────────────────────────────────────
# Guarantee SOME vulkan-driver / lib32-vulkan-driver provider is installed.
# The vendor branches cover common hardware, but on anything they skip
# (pre-Fermi nouveau, VM GPUs like virtio/VMware/VBox, headless, future IDs)
# a later --noconfirm transaction that needs the provide — Steam depends on
# lib32-vulkan-driver — lets pacman auto-pick the alphabetically-first
# provider: lib32-nvidia-utils. Installing mesa's software fallback
# (lavapipe) closes that hole; on covered hardware these are no-ops.
if ! pacman -T vulkan-driver >/dev/null 2>&1; then
    install_pkgs vulkan-swrast
fi
if ! pacman -T lib32-vulkan-driver >/dev/null 2>&1; then
    install_pkgs lib32-vulkan-swrast
fi

info "GPU driver package installation complete."
info "Configuration (mkinitcpio, modprobe, env, cmdline) handled by post-install section 4c."

# Surface any driver-install failure loudly. The install still completes (a
# missing GPU driver is recoverable post-boot, unlike a half-installed system),
# but the failure is impossible to miss in the Calamares log and is left as a
# breadcrumb at /var/lib/mainstream/gpu-install-failed.log for first-boot UX.
if [[ ${#GPU_FAILURES[@]} -gt 0 ]]; then
    err "==================================================================="
    err "  GPU DRIVER INSTALL: ${#GPU_FAILURES[@]} FAILURE(S) — acceleration may not work:"
    for _f in "${GPU_FAILURES[@]}"; do err "    - $_f"; done
    err "==================================================================="
    mkdir -p /var/lib/mainstream 2>/dev/null || true
    { printf 'install-gpu-drivers failures (%s):\n' "$(date -Is 2>/dev/null || echo unknown)"
      printf '  - %s\n' "${GPU_FAILURES[@]}"
    } > /var/lib/mainstream/gpu-install-failed.log 2>/dev/null || true
fi
exit 0
