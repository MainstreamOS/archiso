#!/usr/bin/env bash
# =============================================================================
# install-gpu-drivers
# Calamares shellprocess — runs inside the installed system chroot
#
# Installs GPU driver PACKAGES ONLY.
# All mkinitcpio, modprobe, env var, and cmdline configuration is handled
# by post-install section 4c which runs after archiso.conf is removed,
# guaranteeing a clean mkinitcpio.conf baseline.
#
# NVIDIA: proprietary by generation, nouveau for pre-Fermi
# AMD:    amdgpu (open source), radeon for pre-GCN
# Intel:  i915/vulkan-intel, iHD VA-API on Gen8+, i965 on Gen7.5 and older
# =============================================================================

set -uo pipefail

log()  { echo "[install-gpu-drivers] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; _ms_health "WARN: $*"; }
err()  { log "ERROR: $*" >&2; _ms_health "FAIL: $*"; }
_ms_health() {
    mkdir -p /var/log/mainstream-install 2>/dev/null || return 0
    printf '%s [%s] %s\n' "$(date '+%F %T')" "${0##*/}" "$*" \
        >> /var/log/mainstream-install/health.log 2>/dev/null || true
}

# Source the shared GPU library — the single source of truth shared with the
# dots ./setup path (sdata/lib/gpu-config.sh), baked into the ISO at
# /usr/local/lib/gpu-config.sh by build.sh so it is sourced from the trusted
# image rather than a network-cloned tree. Detection (gpu_detect) and NVIDIA
# generation classification (gpu_classify_nvidia_driver) come from there; this
# script keeps the archiso-specific package-install machinery (staged prebuilts
# via pacman -U, DKMS against the target kernel). Sourced BEFORE note_failure
# below so this script's version stays in effect. Vars are pre-seeded so the
# vendor branches stay set -u safe if the lib is ever absent.
GPU_LIB="${GPU_LIB:-/usr/local/lib/gpu-config.sh}"
HAS_NVIDIA=false HAS_AMD=false HAS_INTEL=false IS_HYBRID=false
IS_OLD_AMD=false IS_RDNA4=false NVIDIA_GEN=none INTEL_GEN=none
if [[ -r "$GPU_LIB" ]]; then
    source "$GPU_LIB"
else
    err "Shared GPU library not found at $GPU_LIB — vendor branches will be skipped."
fi

# Track GPU-driver install failures so a broken driver surfaces as a loud,
# unmissable error at the end (and a breadcrumb the desktop can read on
# first boot) instead of the old silent warn+exit-0 soft-pass.
GPU_FAILURES=()
note_failure() { GPU_FAILURES+=("$1"); err "$1"; }

GPU_INFO=$(lspci 2>/dev/null | grep -iE "VGA|3D|Display" || true)
if [[ -z "$GPU_INFO" ]]; then
    # Don't exit: the vulkan-provider catch-all at the bottom must still run,
    # or a later --noconfirm install needing (lib32-)vulkan-driver (Steam)
    # auto-resolves to lib32-nvidia-utils even on GPU-less VMs/headless.
    warn "No GPU detected — vendor branches will be skipped."
else
    info "Detected GPU(s):"
    echo "$GPU_INFO" | while read -r line; do info "  $line"; done
fi

# Detect hardware + NVIDIA generation via the shared library (sets HAS_*/IS_*/
# NVIDIA_GEN; the vars were pre-seeded above so the branches stay set -u safe).
command -v gpu_detect >/dev/null 2>&1 && { gpu_detect || true; }

# Install repo packages for a GPU stack. Filter the target list FIRST:
# pacman -S aborts the entire transaction on one unknown target, which is how
# the stale mesa-vdpau/libva-mesa-driver names (merged into mesa upstream)
# silently skipped lib32-vulkan-radeon — and Steam's --noconfirm provider
# resolution then pulled lib32-nvidia-utils onto AMD-only installs.
#  - in the sync repos        -> install
#  - installed but not in any repo -> already satisfied, skip (feeding it to
#    pacman -S would error "target not found" and abort the whole set)
#  - nowhere                  -> dead/renamed name, reported via $1
# install_pkgs reports problems loudly via note_failure (required driver
# stacks); install_pkgs_opt warns only (best-effort firmware/VA-API extras).
_install_pkgs_impl() {
    local report="$1"; shift
    local p avail=()
    for p in "$@"; do
        if pacman -Si "$p" >/dev/null 2>&1; then
            avail+=("$p")
        elif pacman -Qq "$p" >/dev/null 2>&1; then
            info "$p already installed (not in sync repos) — skipping."
        else
            "$report" "package '$p' not found in repos (renamed/merged upstream?) — skipped."
        fi
    done
    [[ ${#avail[@]} -eq 0 ]] && return 0
    info "Installing: ${avail[*]}"
    pacman -S --noconfirm --needed "${avail[@]}" 2>&1 \
        || "$report" "pacman -S failed for: ${avail[*]}"
}
install_pkgs()     { _install_pkgs_impl note_failure "$@"; }
install_pkgs_opt() { _install_pkgs_impl warn "$@"; }

# Local pre-built AUR packages staged into the airootfs at build time
# (build.sh's AUR_DEPS section). install-gpu-drivers consumes them via
# pacman -U so we never have to run yay-fetch-and-compile from inside the
# Calamares chroot, which was failure-prone (network in chroot, kernel
# version mismatch for DKMS, build-environment fragility).
LOCAL_PKGS_DIR="${LOCAL_PKGS_DIR:-/usr/local/share/pkgs}"

# Find the matching local pkg file(s) by glob. The version in the filename
# varies per build, so we glob for the family name and let pacman -U pick
# up whatever's there.
find_local_pkgs() {
    local pat
    local matches=()
    for pat in "$@"; do
        # Skip -debug- variants — they're makepkg artifacts we don't want.
        local f
        for f in "$LOCAL_PKGS_DIR"/${pat}-[0-9]*.pkg.tar.zst; do
            [[ -f "$f" ]] || continue
            [[ "$f" == *-debug-* ]] && continue
            matches+=("$f")
        done
    done
    # Print nothing on zero matches — an unconditional printf emits one empty
    # line, which mapfile turns into found=("") and pacman -U "" runs instead
    # of the intended "No local pkgs found" warning.
    [[ ${#matches[@]} -gt 0 ]] && printf '%s\n' "${matches[@]}"
    return 0
}

# Install local pre-built packages by family name (e.g. nvidia-580xx-dkms).
# Falls back to a warning if the .pkg.tar.zst is missing from the airootfs.
install_local_pkgs() {
    local found
    mapfile -t found < <(find_local_pkgs "$@")
    if [[ ${#found[@]} -eq 0 ]]; then
        warn "No local pkgs found for: $*"
        return 1
    fi
    info "Installing local pkgs: ${found[*]##*/}"
    pacman -U --noconfirm --needed "${found[@]}" 2>&1 \
        || { warn "pacman -U failed for: $*"; return 1; }
    return 0
}

# Force a DKMS module to (re)build against the TARGET system's kernel
# rather than the build host's kernel that's running inside the chroot.
# Without -k, dkms install picks $(uname -r) which is the chroot host's
# kernel; that's what made the old `get_aur_pkg ... || warn` flow leave
# unbuilt modules and forced the post-install first-boot mkinitcpio
# deferral. With -k pointing at the freshly-unpacked target kernel,
# modules land in /lib/modules/<target>/extra/ at chroot time and
# mkinitcpio -P succeeds immediately.
target_dkms_install() {
    local module="$1"
    local version="$2"

    # /lib/modules/<ver>/ exists for each kernel installed on the target.
    # On a normal install there's exactly one (linux). If multiple, pick
    # the newest by sort -V.
    local target_kernel
    target_kernel=$(ls -1 /lib/modules 2>/dev/null | sort -V | tail -1)
    if [[ -z "$target_kernel" ]]; then
        warn "Could not detect target kernel in /lib/modules — DKMS will use \$(uname -r)."
        target_kernel=""
    else
        info "DKMS building $module/$version against target kernel: $target_kernel"
    fi

    if [[ -n "$target_kernel" ]]; then
        dkms install -m "$module" -v "$version" -k "$target_kernel" 2>&1 \
            || note_failure "DKMS build failed: $module/$version for kernel $target_kernel — GPU kernel module is MISSING."
    else
        dkms install -m "$module" -v "$version" 2>&1 \
            || note_failure "DKMS build failed: $module/$version — GPU kernel module is MISSING."
    fi
}

# Discover the version string from a pre-built DKMS .pkg.tar.zst filename.
# Example: nvidia-580xx-dkms-580.95.05-1-x86_64.pkg.tar.zst → 580.95.05
# That's the value /usr/src/<module>-<version>/ expects.
detect_dkms_version() {
    local family="$1"
    local f v
    f=$(find_local_pkgs "$family" | head -1)
    [[ -z "$f" ]] && return 1
    # pkgrel may be multi-token (e.g. nvidia-470xx-dkms pkgrel "8.02"), so the
    # release segment is [0-9][^-]* (starts with a digit, no further hyphen),
    # not [0-9]+ — the latter silently failed to match 470xx and skipped its
    # DKMS build, shipping Kepler userspace-only with no kernel module.
    v=$(basename "$f" | sed -E "s/^${family}-([^-]+)-[0-9][^-]*-[^-]+\.pkg\.tar\.zst\$/\1/")
    [[ -z "$v" || "$v" == "$(basename "$f")" ]] && return 1
    printf '%s\n' "$v"
}

# Standard edition has no legacy NVIDIA prebuilts: fall back to nouveau so the
# target still boots, and breadcrumb the user to the NVIDIA (legacy) edition.
# Never runs on the NVIDIA edition (prebuilts present there).
legacy_nvidia_fallback() {
    local gen="$1"
    warn "Legacy NVIDIA ($gen): proprietary prebuilts not on this edition — falling back to nouveau."
    install_pkgs mesa lib32-mesa
    note_failure "Legacy NVIDIA ($gen): proprietary drivers are not on this (standard) edition — installed nouveau as a fallback. For full acceleration, reinstall using the MainstreamOS NVIDIA (legacy) edition ISO."
}

# Install one of the frozen legacy NVIDIA DKMS branches (580xx/470xx/390xx) from
# the staged prebuilts named by the classifier's NVIDIA_LOCAL_PKGS array, then
# build the module against the target kernel. Falls back to nouveau when the
# prebuilts are not staged (standard edition). $1 is the human-readable label.
install_legacy_nvidia() {
    local label="$1" dkms_pkg="${NVIDIA_LOCAL_PKGS[0]}"
    if [[ -z "$(find_local_pkgs "$dkms_pkg")" ]]; then
        legacy_nvidia_fallback "$label"
        return
    fi
    install_pkgs linux-headers dkms libva-utils
    install_pkgs_opt libva-nvidia-driver
    # The whole NVIDIA_LOCAL_PKGS set rides one pacman -U: the *-settings package
    # depends on libxnvctrl-*xx, which exists only as a staged file (the repo DB
    # excludes GPU packages), and one unresolvable dep aborts the transaction.
    if install_local_pkgs "${NVIDIA_LOCAL_PKGS[@]}"; then
        local ver; ver=$(detect_dkms_version "$dkms_pkg" || echo "")
        if [[ -n "$ver" ]]; then
            target_dkms_install nvidia "$ver"
        else
            note_failure "$dkms_pkg: could not parse version from staged package — DKMS module NOT built."
        fi
    else
        note_failure "$dkms_pkg: staged packages present but pacman -U failed — $label GPU has no kernel driver."
    fi
    install_pkgs_opt linux-firmware-nvidia
    info "NVIDIA $label — installed $dkms_pkg."
}

pacman -Sy 2>/dev/null || warn "pacman -Sy failed — using cached db."

if $HAS_INTEL; then
    # INTEL_GEN (set by gpu_detect) picks the VA-API driver and decides whether
    # the OpenCL/VPL runtimes are worth installing — see the shared library for
    # the tier boundaries.
    case "$INTEL_GEN" in
        legacy)
            install_pkgs mesa lib32-mesa vulkan-intel lib32-vulkan-intel libva-intel-driver
            ;;
        xe)
            install_pkgs mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver intel-compute-runtime ocl-icd
            install_pkgs_opt linux-firmware-intel vpl-gpu-rt
            ;;
        *)
            install_pkgs mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver
            install_pkgs_opt linux-firmware-intel
            ;;
    esac
    info "Intel generation $INTEL_GEN — packages installed."
fi

if $HAS_AMD; then
    # IS_OLD_AMD (pre-GCN, with the APU exemption + RDNA4 override) comes from
    # gpu_detect — see the shared library for the classification rationale.
    # VA-API/VDPAU are part of mesa itself now — the old libva-mesa-driver /
    # mesa-vdpau split packages no longer exist.
    if $IS_OLD_AMD; then
        # Pre-GCN runs the radeon kernel module and mesa's r300/r600 gallium
        # drivers; RADV is GCN1+ only, so there is no Vulkan driver for this
        # tier. Leaving vulkan-radeon out is deliberate: it provides
        # 'vulkan-driver', which would satisfy the catch-all below and suppress
        # the lavapipe fallback, leaving an ICD that enumerates zero devices.
        install_pkgs mesa lib32-mesa
    else
        install_pkgs mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon
    fi
    install_pkgs_opt linux-firmware-amdgpu
    info "AMD packages installed."
fi

if $HAS_NVIDIA; then
    # NVIDIA_GEN (set by gpu_detect) -> driver family + package sets. The caller
    # owns the install: nvidia-open from the repo, a frozen legacy branch from
    # staged prebuilts, or nouveau for pre-Fermi.
    gpu_classify_nvidia_driver
    info "NVIDIA generation $NVIDIA_GEN -> driver family $NVIDIA_DRIVER_FAMILY"
    case "$NVIDIA_DRIVER_FAMILY" in
        nvidia-open)
            # Turing and newer (RTX 2060+, 30xx/40xx/50xx) — the official open
            # source kernel module, same userspace as proprietary.
            install_pkgs "${NVIDIA_REPO_PKGS[@]}"
            install_pkgs_opt linux-firmware-nvidia
            info "NVIDIA Turing+ — installed nvidia-open (official open source kernel module)."
            ;;
        nvidia-580xx) install_legacy_nvidia "Maxwell/Pascal/Volta — GTX 900/1000/Titan V" ;;
        nvidia-470xx) install_legacy_nvidia "Kepler — GTX 600/700" ;;
        nvidia-390xx) install_legacy_nvidia "Fermi — GTX 400/500" ;;
        nouveau|*)
            # Pre-Fermi (Tesla / older) — nouveau is the only realistic option.
            install_pkgs mesa lib32-mesa
            ;;
    esac

    # PRIME render-offload tool for hybrid (NVIDIA + Intel/AMD).
    [[ $IS_HYBRID == true ]] && install_pkgs nvidia-prime || true

    info "NVIDIA packages installed."
fi

# ── Vulkan-provider catch-all ────────────────────────────────────────────────
# Guarantee SOME vulkan-driver / lib32-vulkan-driver provider is installed.
# The vendor branches cover common hardware, but on anything they skip
# (pre-Fermi nouveau, VM GPUs like virtio/VMware/VBox, headless, future IDs)
# a later --noconfirm transaction that needs the provide — Steam depends on
# lib32-vulkan-driver — lets pacman auto-pick the alphabetically-first
# provider: lib32-nvidia-utils. Installing mesa's software fallback
# (lavapipe) closes that hole; on covered hardware these are no-ops.
if ! pacman -T vulkan-driver >/dev/null 2>&1; then
    install_pkgs vulkan-swrast
fi
if ! pacman -T lib32-vulkan-driver >/dev/null 2>&1; then
    install_pkgs lib32-vulkan-swrast
fi

info "GPU driver package installation complete."
info "Configuration (mkinitcpio, modprobe, env, cmdline) handled by post-install section 4c."

# Surface any driver-install failure loudly. The install still completes (a
# missing GPU driver is recoverable post-boot, unlike a half-installed system),
# but the failure is impossible to miss in the Calamares log and is left as a
# breadcrumb at /var/lib/mainstream/gpu-install-failed.log for first-boot UX.
if [[ ${#GPU_FAILURES[@]} -gt 0 ]]; then
    err "==================================================================="
    err "  GPU DRIVER INSTALL: ${#GPU_FAILURES[@]} FAILURE(S) — acceleration may not work:"
    for _f in "${GPU_FAILURES[@]}"; do err "    - $_f"; done
    err "==================================================================="
    mkdir -p /var/lib/mainstream 2>/dev/null || true
    { printf 'install-gpu-drivers failures (%s):\n' "$(date -Is 2>/dev/null || echo unknown)"
      printf '  - %s\n' "${GPU_FAILURES[@]}"
    } > /var/lib/mainstream/gpu-install-failed.log 2>/dev/null || true
fi
exit 0
