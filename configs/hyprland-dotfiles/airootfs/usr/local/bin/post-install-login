#!/usr/bin/env bash
# post-install-login — Setting up the login screen
source /usr/local/lib/mainstream-postinstall-common.sh

info "Installing pixie SDDM theme..."

SDDM_THEME_DIR="/usr/share/sddm/themes/pixie"
if ping -c1 -W3 github.com &>/dev/null; then
    if git clone --depth=1 https://github.com/MainstreamOS/pixie-sddm.git "$SDDM_THEME_DIR"; then
        info "pixie SDDM theme installed successfully."
    else
        warn "Failed to clone pixie-sddm — SDDM will use default theme."
    fi
else
    warn "No network — skipping pixie SDDM theme install."
fi

info "Configuring SDDM-Hyprland and correcting fstab..."

# SDDM Wayland Handshake + pixie theme
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-wayland.conf <<SDDMEOF
[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Wayland]
CompositorCommand=start-hyprland

[Theme]
Current=pixie
SDDMEOF

# Remove any live ISO autologin configs. If the user enabled autologin on the
# Calamares users page, the displaymanager module writes that choice to
# /etc/sddm.conf before this script runs.
#
# We only remove drop-ins that explicitly target 'liveuser' to avoid
# clobbering a valid user-requested autologin if it was written to a drop-in.
find /etc -name "autologin.conf" -type f | while read -r f; do
    if grep -q "liveuser" "$f"; then
        rm -f "$f"
        info "Removed live ISO autologin config: $f"
    fi
done

# SDDM user home directory, Hyprland greeter config, and permissions.
# Lua, not .conf: 0.56.1 shows a deprecation notice on any .conf config, and the
# greeter is the first thing anyone sees. The format goes away in 0.57. An empty
# output is the catch-all rule, the same as the old `monitor=,...` line.
mkdir -p /var/lib/sddm/.config/hypr
rm -f /var/lib/sddm/.config/hypr/hyprland.conf
cat > /var/lib/sddm/.config/hypr/hyprland.lua <<'HYPREOF'
-- Hyprland config for the SDDM greeter's own compositor instance.
-- Separate from the user session's config, which lives in ~/.config/hypr.
--
-- Installed to /var/lib/sddm/.config/hypr/hyprland.lua by
-- scripts/setup-sddm-pixie.sh on a fresh setup, and refreshed there by
-- sdata/update/updatems-system on every update. archiso ships its own copy of
-- the same content for the ISO install path.
--
-- Lua rather than .conf: Hyprland 0.56.1 shows a deprecation notice on any
-- .conf config, and the greeter is the first thing anyone sees. Support for
-- the format goes away entirely in 0.57.

-- SDDM and the user session run separate Hyprland instances. Recover the last
-- logged-in user's saved Num Lock state before the greeter configures input.
local function persistedNumlockState()
    local state = io.open("/var/lib/sddm/state.conf", "r")
    if not state then
        return nil
    end

    local username
    for line in state:lines() do
        username = line:match("^User%s*=%s*(.-)%s*$")
        if username and username ~= "" then
            break
        end
    end
    state:close()
    if not username then
        return nil
    end

    local passwd = io.open("/etc/passwd", "r")
    if not passwd then
        return nil
    end

    local home
    for line in passwd:lines() do
        local user, userHome = line:match("^([^:]+):[^:]*:[^:]*:[^:]*:[^:]*:([^:]+):")
        if user == username then
            home = userHome
            break
        end
    end
    passwd:close()
    if not home then
        return nil
    end

    local saved = io.open(home .. "/.local/state/mainstream/numlock", "r")
    if not saved then
        return nil
    end
    local value = saved:read("*l")
    saved:close()

    if value == "1" then
        return true
    elseif value == "0" then
        return false
    end
    return nil
end

local function inheritedNumlockState()
    local persisted = persistedNumlockState()
    if persisted ~= nil then
        return persisted
    end

    local reader = io.popen([[
for path in /sys/class/leds/*::numlock/brightness; do
    [ -r "$path" ] && cat "$path"
done
]])
    if not reader then
        return true
    end

    local found = false
    local enabled = false
    for value in reader:lines() do
        found = true
        if value:match("^%s*1%s*$") then
            enabled = true
        end
    end
    reader:close()

    if not found then
        return true
    end
    return enabled
end

hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = "1",
})

hl.config({
    input = {
        numlock_by_default = inheritedNumlockState(),
    },
    misc = {
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        force_default_wallpaper  = 0,
        disable_watchdog_warning = true,
    },
    animations = {
        enabled = false,
    },
})

hl.window_rule({ match = { class = "^(sddm-greeter-qt6)$" }, fullscreen = true })
HYPREOF
chown -R sddm:sddm /var/lib/sddm
chmod 700 /var/lib/sddm/.config
chmod 700 /var/lib/sddm/.config/hypr
chmod 600 /var/lib/sddm/.config/hypr/hyprland.lua

# Fix Btrfs subvolume naming mismatch (@ vs /@)
sed -i 's|subvol=/@|subvol=@|g' /etc/fstab || true

# ---------------------------------------------------------------------------
# 5b. SDDM BACKGROUND POLKIT SETUP
# ---------------------------------------------------------------------------
# Install the polkit helper + rules so wallpaper switches can update the
# SDDM login screen background without a password prompt
DOTFILES_REPO="/tmp/dotfiles-setup"
if [[ -d "$DOTFILES_REPO" ]]; then
    info "Installing SDDM background polkit helper..."

    HELPER_SRC="$DOTFILES_REPO/dots/.config/quickshell/ii/scripts/colors/sddm-bg-helper.sh"
    POLICY_SRC="$DOTFILES_REPO/sdata/polkit/org.illogicalimpulse.sddm-bg.policy"
    RULES_SRC="$DOTFILES_REPO/sdata/polkit/50-sddm-bg.rules"

    if [[ -f "$HELPER_SRC" ]]; then
        cp "$HELPER_SRC" /usr/local/bin/sddm-bg-helper
        chmod 755 /usr/local/bin/sddm-bg-helper
        info "sddm-bg-helper installed."
    else
        warn "sddm-bg-helper.sh not found in dotfiles repo — SDDM background updates may prompt for password."
    fi

    if [[ -f "$POLICY_SRC" ]]; then
        mkdir -p /usr/share/polkit-1/actions
        cp "$POLICY_SRC" /usr/share/polkit-1/actions/
        info "Polkit policy installed."
    fi

    if [[ -f "$RULES_SRC" ]]; then
        mkdir -p /usr/share/polkit-1/rules.d
        cp "$RULES_SRC" /usr/share/polkit-1/rules.d/
        info "Polkit rules installed."
    fi
else
    warn "/tmp/dotfiles-setup not found — skipping SDDM polkit setup."
fi

# ---------------------------------------------------------------------------
# 6. CLEANUP BUILDUSER
# ---------------------------------------------------------------------------
# Precision purge: Only remove builduser if it isn't our primary account
if id "builduser" &>/dev/null && [[ "$MAIN_USER" != "builduser" ]]; then
    info "Purging temporary build user..."
    userdel -rf builduser || true
fi

# Remove builduser sudoers immediately — builduser has been deleted above.
rm -f /etc/sudoers.d/builduser /etc/sudoers.d/builduser-install 2>/dev/null || true

# g_wheel grants %wheel passwordless sudo for the duration of the
# Calamares install. The netinstall packages module no longer needs it
# (it runs pacman directly as root in the chroot — the yay-as-user path
# that called sudo pacman internally is gone), but the cleanup still
# happens synchronously at the end of finalize-install, which Calamares
# runs after the packages module. See finalize-install for the cleanup
# block. Stale pacman lock can still appear if a previous step
# crashed; clear it defensively here.
rm -f /var/lib/pacman/db.lck 2>/dev/null || true

# Visual feedback ('*' per keystroke) at sudo prompts. Default sudo gives no
# echo at all, which catches new users out — they can't tell whether the
# keyboard is being read. Drop-in lives under sudoers.d so package upgrades
# to /etc/sudoers can never clobber it; validated with visudo -cf so a syntax
# error never lands on the installed system.

# The keyboard answered for on the installer's own page reached the text
# consoles and X11 and stopped there. Both things anyone actually types into on
# this desktop are Wayland: the greeter runs its own Hyprland, and so does the
# session, and each takes its layout from `kb_layout` and from nothing else. The
# skel ships that hardcoded to us, so a French keyboard was asked for, recorded,
# and then ignored at the login prompt and again on the desktop behind it.
#
# One lookup, both files. The X11 config is read first because it holds proper
# XKB names, which is what Hyprland wants; the console keymap is the fallback
# and is close enough for the layouts where the two disagree.
seed_keyboard_layout() {
    local x11="/etc/X11/xorg.conf.d/00-keyboard.conf"
    local layout="" variant=""
    if [[ -f "$x11" ]]; then
        layout=$(grep -oP 'Option\s+"XkbLayout"\s+"\K[^"]+' "$x11" 2>/dev/null | head -1)
        variant=$(grep -oP 'Option\s+"XkbVariant"\s+"\K[^"]*' "$x11" 2>/dev/null | head -1)
    fi
    if [[ -z "$layout" && -f /etc/vconsole.conf ]]; then
        layout=$(grep -oP '^KEYMAP=\K.*' /etc/vconsole.conf 2>/dev/null | tr -d '"' | head -1)
        # Console keymaps carry qualifiers XKB has no notion of.
        layout="${layout%%-*}"
    fi
    [[ -n "$layout" ]] || { info "No keyboard layout recorded; leaving the stock one."; return 0; }
    # A layout name reaches a config file and a Lua table, so accept only what
    # one can actually be. Anything else is treated as nothing recorded.
    if [[ ! "$layout" =~ ^[a-z]{2,8}(,[a-z]{2,8})*$ ]]; then
        warn "Unrecognized keyboard layout '${layout}'; leaving the stock one."
        return 0
    fi
    [[ "$variant" =~ ^[a-z0-9_]*(,[a-z0-9_]*)*$ ]] || variant=""

    # The greeter's compositor. hyprland.lua already exists (written above,
    # ~line 53) with the monitor/misc/window_rule config, so add to it rather
    # than replace it — and use hl.config({ input = ... }), matching the lua
    # config format that block already switched to.
    install -d -o sddm -g sddm -m 700 /var/lib/sddm/.config/hypr 2>/dev/null || {
        warn "No sddm account to give a greeter keymap to."; return 0; }
    {
        printf '\nhl.config({\n    input = {\n        kb_layout = "%s",\n' "$layout"
        [[ -n "$variant" ]] && printf '        kb_variant = "%s",\n' "$variant"
        printf '    },\n})\n'
    } >> /var/lib/sddm/.config/hypr/hyprland.lua
    chown sddm:sddm /var/lib/sddm/.config/hypr/hyprland.lua
    info "Login screen keyboard set to ${layout}${variant:+ (${variant})}."

    # The session behind it, for the account just created and for anyone made
    # later. Written in place of the stock line rather than appended, since the
    # config is read top to bottom and the later value would win.
    local target
    for target in /etc/skel /home/*; do
        local lua="${target}/.config/hypr/hyprland/general.lua"
        [[ -f "$lua" ]] || continue
        sed -i "s/^\(\s*\)kb_layout = \"[^\"]*\",/\1kb_layout = \"${layout}\",/" "$lua"
        if [[ -n "$variant" ]] && ! grep -q 'kb_variant' "$lua"; then
            sed -i "s/^\(\s*\)\(kb_layout = \"[^\"]*\",\)/\1\2\n\1kb_variant = \"${variant}\",/" "$lua"
        fi
        [[ "$target" == /home/* ]] && chown "$(stat -c %u:%g "$target")" "$lua" 2>/dev/null
        info "Session keyboard set to ${layout} for ${target}."
    done
}
seed_keyboard_layout
