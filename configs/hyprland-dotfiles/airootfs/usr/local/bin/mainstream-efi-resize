#!/usr/bin/env bash
# mainstream-efi-resize — Privileged Polkit helper to safely expand the EFI System Partition
#
# Supports three online, crash-safe expansion strategies on GPT disks:
#   1. inplace_grow:       Contiguous unallocated sectors already follow the ESP;
#                          backs up ESP, extends partition end LBA via sfdisk, formats
#                          preserving the exact FAT32 volume ID (UUID), restores files,
#                          and repairs Limine boot pins.
#   2. new_esp_unallocated: Contiguous unallocated space exists elsewhere on the GPT disk;
#                          creates a new GPT ESP there, populates and verifies it while the
#                          original ESP stays mounted, then atomically updates /etc/fstab
#                          and UEFI NVRAM.
#   3. tail_btrfs_relocate: ESP is boxed in by an adjacent partition (e.g. standard GPT p1+p2
#                          or Windows dual-boot), and the disk's last partition is a mounted
#                          single-device Btrfs volume with >= (target + 4 GiB) free space;
#                          shrinks Btrfs tail with safety margin, shrinks tail partition end
#                          sector, creates a dedicated GPT ESP in the freed tail space,
#                          re-expands Btrfs to fill its partition, verifies UKIs/pins, and
#                          atomically switches /etc/fstab and UEFI NVRAM (with full sfdisk +
#                          Btrfs rollback trap if anything fails prior to cutover).
#
# Subcommands:
#   probe              — Output JSON describing current ESP geometry & supported resize plan
#   resize <target_mb> — Expand EFI partition to <target_mb> (1024..16384 MB), streaming JSON

set -euo pipefail
export LC_ALL=C

MIN_TARGET_MB=1024
MAX_TARGET_MB=16384
BTRFS_SAFETY_MARGIN_BYTES=$((4 * 1024 * 1024 * 1024)) # Keep >= 4 GiB free on root Btrfs
SHRINK_CUSHION_BYTES=$((128 * 1024 * 1024))          # 128 MiB temporary cushion during GPT shrink
ESP_GPT_TYPE="C12A7328-F81F-11D2-BA4B-00A0C93EC93B"

FSTAB_PATH="${EFI_RESIZE_FSTAB:-/etc/fstab}"
BOOT_LOCK="${EFI_RESIZE_LOCK:-/run/lock/boot-partition.lock}"
BACKUP_BASE="${EFI_RESIZE_BACKUP_BASE:-/var/cache/mainstream}"
MOUNT_OVERRIDE="${EFI_RESIZE_MOUNT:-}"
SKIP_NVRAM="${EFI_RESIZE_SKIP_NVRAM:-0}"
FORCE_UEFI="${EFI_RESIZE_FORCE_UEFI:-0}"
MIN_FREE_OVERRIDE="${EFI_RESIZE_BTRFS_MARGIN_BYTES:-}"
if [[ -n "$MIN_FREE_OVERRIDE" && "$MIN_FREE_OVERRIDE" =~ ^[0-9]+$ ]]; then
    BTRFS_SAFETY_MARGIN_BYTES="$MIN_FREE_OVERRIDE"
fi

emit_progress() {
    local step="$1" pct="$2" msg="$3"
    jq -nc --arg step "$step" --argjson pct "$pct" --arg msg "$msg" \
        '{step: $step, percent: $pct, message: $msg}'
}

die_json() {
    local msg="$1"
    jq -nc --arg msg "$msg" '{step: "error", percent: 0, error: true, message: $msg}'
    exit 1
}

find_esp_mount() {
    if [[ -n "$MOUNT_OVERRIDE" ]]; then
        if mountpoint -q "$MOUNT_OVERRIDE" 2>/dev/null; then
            local fstype
            fstype="$(findmnt -n -o FSTYPE -M "$MOUNT_OVERRIDE" 2>/dev/null || true)"
            if [[ "$fstype" == "vfat" ]]; then
                printf '%s\n' "$MOUNT_OVERRIDE"
                return 0
            fi
        fi
        return 1
    fi

    local mp fstype src ptype
    for mp in /boot/efi /efi /boot; do
        mountpoint -q "$mp" 2>/dev/null || continue
        fstype="$(findmnt -n -o FSTYPE -M "$mp" 2>/dev/null || true)"
        [[ "$fstype" == "vfat" ]] || continue
        src="$(findmnt -nv -o SOURCE -M "$mp" 2>/dev/null || true)"
        [[ -n "$src" && -b "$src" ]] || continue
        ptype="$(lsblk -dno PARTTYPE "$src" 2>/dev/null || true)"
        if [[ "${ptype,,}" == "${ESP_GPT_TYPE,,}" || "$mp" != "/boot" ]]; then
            printf '%s\n' "$mp"
            return 0
        fi
    done
    return 1
}

resolve_parent_disk() {
    local part_dev="$1" pk
    pk="$(lsblk -dno PKNAME "$part_dev" 2>/dev/null | head -n1 || true)"
    if [[ -n "$pk" ]]; then
        printf '/dev/%s\n' "$pk"
        return 0
    fi
    return 1
}

resolve_part_num() {
    local part_dev="$1" base
    base="$(basename "$part_dev")"
    if [[ -r "/sys/class/block/$base/partition" ]]; then
        cat "/sys/class/block/$base/partition"
        return 0
    fi
    lsblk -dno PARTN "$part_dev" 2>/dev/null | tr -d ' '
}

part_path_for_num() {
    local disk="$1" num="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$disk" "$num"
    else
        printf '%s%s\n' "$disk" "$num"
    fi
}

# Resolves the live mountpoint for a block device (handling Btrfs [/subvol] sources)
find_mount_for_dev() {
    local target_dev="$1"
    findmnt -rn -o SOURCE,TARGET 2>/dev/null | awk -v dev="$target_dev" '
        {
            src = $1
            sub(/\[.*\]$/, "", src)
            if (src == dev) {
                if ($2 == "/") { root_hit = 1 }
                else if (!first_hit) { first_hit = $2 }
            }
        }
        END {
            if (root_hit) print "/"
            else if (first_hit) print first_hit
        }
    '
}

# Populates global variables describing the ESP and resize strategy for $1 (optional target_mb, default 2048):
#   ESP_MNT, ESP_DEV, ESP_UUID, ESP_DISK, ESP_PARTN, ESP_TOTAL_BYTES, ESP_USED_BYTES, ESP_FREE_BYTES
#   DISK_LABEL, SECTOR_SIZE, FIRST_LBA, LAST_LBA
#   STRATEGY ("inplace_grow" | "new_esp_unallocated" | "tail_btrfs_relocate" | "unsupported")
#   CAN_RESIZE ("true" | "false"), REASON, MAX_TARGET_BYTES
#   GAP_START_SEC, GAP_SIZE_SEC
#   TAIL_DEV, TAIL_PARTN, TAIL_START_SEC, TAIL_SIZE_SEC, TAIL_FSTYPE, TAIL_MNT, TAIL_FREE_BYTES
analyze_layout() {
    local req_mb="${1:-2048}"
    local req_bytes=$(( req_mb * 1024 * 1024 ))

    STRATEGY="unsupported"
    CAN_RESIZE="false"
    REASON=""
    MAX_TARGET_BYTES=0
    GAP_START_SEC=0
    GAP_SIZE_SEC=0
    TAIL_DEV=""
    TAIL_PARTN=0
    TAIL_START_SEC=0
    TAIL_SIZE_SEC=0
    TAIL_FSTYPE=""
    TAIL_MNT=""
    TAIL_FREE_BYTES=0

    if [[ "$FORCE_UEFI" != "1" && ! -d /sys/firmware/efi ]]; then
        REASON="System booted in legacy BIOS mode rather than UEFI."
        return 1
    fi

    ESP_MNT="$(find_esp_mount || true)"
    if [[ -z "$ESP_MNT" ]]; then
        REASON="No mounted FAT32 EFI System Partition found at /boot/efi, /efi, or /boot."
        return 1
    fi

    ESP_DEV="$(findmnt -nv -o SOURCE -M "$ESP_MNT" 2>/dev/null || true)"
    if [[ -z "$ESP_DEV" || ! -b "$ESP_DEV" ]]; then
        REASON="Could not resolve backing block device for $ESP_MNT."
        return 1
    fi
    if [[ "$ESP_DEV" == /dev/mapper/* || "$ESP_DEV" == /dev/dm-* || "$ESP_DEV" == /dev/md* ]]; then
        REASON="EFI partition ($ESP_DEV) is on a mapped or RAID device."
        return 1
    fi

    ESP_UUID="$(findmnt -n -o UUID -M "$ESP_MNT" 2>/dev/null || blkid -s UUID -o value "$ESP_DEV" 2>/dev/null || true)"
    ESP_DISK="$(resolve_parent_disk "$ESP_DEV" || true)"
    ESP_PARTN="$(resolve_part_num "$ESP_DEV" || true)"
    if [[ -z "$ESP_DISK" || ! -b "$ESP_DISK" || -z "$ESP_PARTN" ]]; then
        REASON="Could not resolve parent disk or partition number for $ESP_DEV."
        return 1
    fi

    ESP_TOTAL_BYTES="$(lsblk -bdno SIZE "$ESP_DEV" 2>/dev/null | tr -d ' ' || echo 0)"
    read -r ESP_USED_BYTES ESP_FREE_BYTES < <(df -B1 --output=used,avail "$ESP_MNT" 2>/dev/null | tail -n1 || echo "0 0")

    local sfdisk_json=""
    sfdisk_json="$(sfdisk -J "$ESP_DISK" 2>/dev/null || true)"
    local disk_base
    disk_base="$(basename "$ESP_DISK")"

    if [[ -n "$sfdisk_json" ]]; then
        DISK_LABEL="$(jq -r '.partitiontable.label // ""' <<<"$sfdisk_json")"
        SECTOR_SIZE="$(jq -r '.partitiontable.sectorsize // 512' <<<"$sfdisk_json")"
        FIRST_LBA="$(jq -r '.partitiontable.firstlba // 2048' <<<"$sfdisk_json")"
        LAST_LBA="$(jq -r '.partitiontable.lastlba // 0' <<<"$sfdisk_json")"
        parts_tsv="$(jq -r '.partitiontable.partitions // [] | sort_by(.start) | .[] | "\(.start)\t\(.size)\t\(.node)"' <<<"$sfdisk_json")"
    else
        # Unprivileged probe fallback: read partition boundaries directly from world-readable sysfs
        DISK_LABEL="$(lsblk -dno PTTYPE "$ESP_DISK" 2>/dev/null || true)"
        SECTOR_SIZE="$(cat "/sys/class/block/$disk_base/queue/logical_block_size" 2>/dev/null || echo 512)"
        local disk_sectors
        disk_sectors="$(cat "/sys/class/block/$disk_base/size" 2>/dev/null || echo 0)"
        FIRST_LBA=2048
        LAST_LBA=$(( disk_sectors > 34 ? disk_sectors - 34 : 0 ))

        local sys_parts=()
        for p_dir in "/sys/class/block/$disk_base/"*; do
            [[ -f "$p_dir/start" && -f "$p_dir/size" ]] || continue
            local st sz p_name
            st="$(< "$p_dir/start")"
            sz="$(< "$p_dir/size")"
            p_name="/dev/$(basename "$p_dir")"
            sys_parts+=("$st	$sz	$p_name")
        done
        if (( ${#sys_parts[@]} > 0 )); then
            parts_tsv="$(printf '%s\n' "${sys_parts[@]}" | sort -n -k1,1)"
        else
            parts_tsv=""
        fi
    fi

    if [[ "${DISK_LABEL,,}" != "gpt" ]]; then
        REASON="Disk $ESP_DISK uses ${DISK_LABEL:-unknown} partitioning; GPT is required."
        return 1
    fi
    if [[ -z "$parts_tsv" ]]; then
        REASON="Could not read partition table or partitions from $ESP_DISK."
        return 1
    fi

    local align_sec=$(( 1048576 / SECTOR_SIZE ))
    (( align_sec < 1 )) && align_sec=1

    # Check partition count limit (GPT standard table has 128 slots)
    local part_count
    part_count="$(wc -l <<<"$parts_tsv" | tr -d ' ')"

    # 1. Check contiguous free space immediately after ESP (inplace_grow)
    local esp_start=0 esp_size=0 next_after_esp=$(( LAST_LBA + 1 ))
    local prev_Was_esp=0 p_start p_size p_node
    local best_gap_start=0 best_gap_sec=0 cursor="$FIRST_LBA"

    while IFS=$'\t' read -r p_start p_size p_node; do
        [[ -n "$p_start" ]] || continue
        local aligned_cursor=$(( ((cursor + align_sec - 1) / align_sec) * align_sec ))
        if (( p_start > aligned_cursor )); then
            local gap_s=$(( p_start - aligned_cursor ))
            if (( gap_s > best_gap_sec )); then
                best_gap_sec="$gap_s"
                best_gap_start="$aligned_cursor"
            fi
        fi
        if (( prev_Was_esp == 1 )); then
            next_after_esp="$p_start"
            prev_Was_esp=0
        fi
        if [[ "$p_node" == "$ESP_DEV" ]]; then
            esp_start="$p_start"
            esp_size="$p_size"
            prev_Was_esp=1
        fi
        cursor=$(( p_start + p_size ))
        TAIL_START_SEC="$p_start"
        TAIL_SIZE_SEC="$p_size"
        TAIL_DEV="$p_node"
    done <<<"$parts_tsv"

    # Check trailing unallocated gap after the last partition
    local aligned_tail_cursor=$(( ((cursor + align_sec - 1) / align_sec) * align_sec ))
    if (( LAST_LBA + 1 > aligned_tail_cursor )); then
        local tail_gap_s=$(( LAST_LBA + 1 - aligned_tail_cursor ))
        if (( tail_gap_s > best_gap_sec )); then
            best_gap_sec="$tail_gap_s"
            best_gap_start="$aligned_tail_cursor"
        fi
    fi

    if (( esp_start > 0 )); then
        local max_inplace_sec=$(( next_after_esp - esp_start ))
        local max_inplace_bytes=$(( max_inplace_sec * SECTOR_SIZE ))
        if (( max_inplace_bytes >= req_bytes && max_inplace_bytes > ESP_TOTAL_BYTES + 32 * 1024 * 1024 )); then
            STRATEGY="inplace_grow"
            CAN_RESIZE="true"
            MAX_TARGET_BYTES="$max_inplace_bytes"
            GAP_START_SEC="$esp_start"
            GAP_SIZE_SEC="$max_inplace_sec"
            REASON="Contiguous unallocated space follows $ESP_DEV; partition can expand directly in place."
            return 0
        fi
        if (( max_inplace_bytes > MAX_TARGET_BYTES )); then
            MAX_TARGET_BYTES="$max_inplace_bytes"
        fi
    fi

    # 2. Check unallocated GPT gap anywhere on disk for a new dedicated ESP
    local best_gap_bytes=$(( best_gap_sec * SECTOR_SIZE ))
    if (( part_count < 128 && best_gap_bytes >= req_bytes )); then
        STRATEGY="new_esp_unallocated"
        CAN_RESIZE="true"
        MAX_TARGET_BYTES="$best_gap_bytes"
        GAP_START_SEC="$best_gap_start"
        GAP_SIZE_SEC="$best_gap_sec"
        REASON="Unallocated space on $ESP_DISK can host a new dedicated EFI System Partition with zero filesystem shrinking."
        return 0
    fi
    if (( best_gap_bytes > MAX_TARGET_BYTES )); then
        MAX_TARGET_BYTES="$best_gap_bytes"
    fi

    # 3. Check tail partition for online Btrfs shrink + tail ESP creation
    if [[ -n "$TAIL_DEV" && -b "$TAIL_DEV" && "$TAIL_DEV" != "$ESP_DEV" ]] && (( part_count < 128 )); then
        TAIL_PARTN="$(resolve_part_num "$TAIL_DEV" || echo 0)"
        TAIL_FSTYPE="$(lsblk -dno FSTYPE "$TAIL_DEV" 2>/dev/null | tr -d ' ' || true)"
        TAIL_MNT="$(find_mount_for_dev "$TAIL_DEV" || true)"

        if [[ "$TAIL_FSTYPE" == "crypto_LUKS" ]]; then
            REASON="Partition $TAIL_DEV is LUKS-encrypted and no unallocated space exists on $ESP_DISK. Shrink the encrypted partition from a live USB to free disk space first."
            return 1
        fi

        if [[ "$TAIL_FSTYPE" != "btrfs" ]]; then
            REASON="Last partition $TAIL_DEV uses ${TAIL_FSTYPE:-unknown} (online shrink requires mounted Btrfs or unallocated disk space)."
            return 1
        fi

        if [[ -z "$TAIL_MNT" ]]; then
            REASON="Btrfs partition $TAIL_DEV is not currently mounted."
            return 1
        fi

        # Refuse multi-device Btrfs pools
        local btrfs_devs
        btrfs_devs="$(btrfs filesystem show "$TAIL_MNT" 2>/dev/null | awk '/Total devices/ {print $3; exit}' || echo 0)"
        if [[ "$btrfs_devs" != "1" ]]; then
            REASON="Btrfs volume at $TAIL_MNT spans multiple devices ($btrfs_devs); automatic single-disk shrink is disabled."
            return 1
        fi

        TAIL_FREE_BYTES="$(df -B1 --output=avail "$TAIL_MNT" 2>/dev/null | tail -n1 | tr -d ' ' || echo 0)"
        # Account for any trailing unallocated sectors already after TAIL_DEV
        local trailing_unalloc_bytes=$(( (LAST_LBA - (TAIL_START_SEC + TAIL_SIZE_SEC) + 1) * SECTOR_SIZE ))
        (( trailing_unalloc_bytes < 0 )) && trailing_unalloc_bytes=0

        local shrinkable_bytes=$(( TAIL_FREE_BYTES + trailing_unalloc_bytes - BTRFS_SAFETY_MARGIN_BYTES - SHRINK_CUSHION_BYTES ))
        if (( shrinkable_bytes > MAX_TARGET_BYTES )); then
            MAX_TARGET_BYTES="$shrinkable_bytes"
        fi

        if (( shrinkable_bytes >= req_bytes )); then
            STRATEGY="tail_btrfs_relocate"
            CAN_RESIZE="true"
            REASON="Will safely shrink Btrfs volume ($TAIL_MNT) at the end of $ESP_DISK and transition to a dedicated EFI System Partition."
            return 0
        else
            local need_gb=$(( (req_bytes + BTRFS_SAFETY_MARGIN_BYTES + SHRINK_CUSHION_BYTES) / (1024 * 1024 * 1024) + 1 ))
            REASON="Insufficient free space on $TAIL_MNT ($(( TAIL_FREE_BYTES / (1024 * 1024 * 1024) )) GiB available; at least ${need_gb} GiB free required)."
            return 1
        fi
    fi

    REASON="No supported online expansion path found on $ESP_DISK."
    return 1
}

cmd_probe() {
    local req_mb="${1:-2048}"
    if [[ ! "$req_mb" =~ ^[0-9]+$ ]]; then
        req_mb=2048
    fi
    analyze_layout "$req_mb" || true

    jq -nc \
        --arg mount "${ESP_MNT:-}" \
        --arg device "${ESP_DEV:-}" \
        --arg uuid "${ESP_UUID:-}" \
        --arg disk "${ESP_DISK:-}" \
        --argjson part_num "${ESP_PARTN:-0}" \
        --argjson total_bytes "${ESP_TOTAL_BYTES:-0}" \
        --argjson used_bytes "${ESP_USED_BYTES:-0}" \
        --argjson free_bytes "${ESP_FREE_BYTES:-0}" \
        --arg strategy "${STRATEGY:-unsupported}" \
        --argjson can_resize "${CAN_RESIZE:-false}" \
        --arg reason "${REASON:-}" \
        --argjson max_target_bytes "${MAX_TARGET_BYTES:-0}" \
        --arg tail_device "${TAIL_DEV:-}" \
        --arg tail_fstype "${TAIL_FSTYPE:-}" \
        --arg tail_mount "${TAIL_MNT:-}" \
        --argjson tail_free_bytes "${TAIL_FREE_BYTES:-0}" \
        '{
            mount: $mount,
            device: $device,
            uuid: $uuid,
            disk: $disk,
            part_num: $part_num,
            total_bytes: $total_bytes,
            used_bytes: $used_bytes,
            free_bytes: $free_bytes,
            strategy: $strategy,
            can_resize: $can_resize,
            reason: $reason,
            max_target_bytes: $max_target_bytes,
            tail_device: $tail_device,
            tail_fstype: $tail_fstype,
            tail_mount: $tail_mount,
            tail_free_bytes: $tail_free_bytes
        }'
}

refresh_kernel_parttable() {
    local disk="$1"
    if command -v partprobe >/dev/null 2>&1; then
        partprobe "$disk" 2>/dev/null || true
    fi
    if command -v partx >/dev/null 2>&1; then
        partx -u "$disk" 2>/dev/null || true
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle --timeout=10 2>/dev/null || true
    fi
}

copy_esp_tree() {
    local src_dir="$1" dst_dir="$2"
    rsync -rltD --no-perms --no-owner --no-group --modify-window=2 "$src_dir/" "$dst_dir/"
    sync
}

verify_esp_contents() {
    local src_dir="$1" dst_dir="$2"
    local src_count dst_count
    src_count="$(find "$src_dir" -mindepth 1 | wc -l | tr -d ' ')"
    dst_count="$(find "$dst_dir" -mindepth 1 | wc -l | tr -d ' ')"
    if (( dst_count < src_count )); then
        return 1
    fi
    if [[ -f "$dst_dir/limine.conf" ]] && command -v mainstream-boot-verify >/dev/null 2>&1; then
        local rc=0
        MAINSTREAM_ESP="$dst_dir" MAINSTREAM_BOOT_LOCK="/run/lock/efi-resize-inner.lock" \
            mainstream-boot-verify --repair >/dev/null 2>&1 || rc=$?
        # Exit codes 0 (valid) and 3 (repaired from backup) mean bootable
        if (( rc != 0 && rc != 3 )); then
            return 1
        fi
    fi
    return 0
}

# Atomically updates /etc/fstab entry for $1 (mountpoint) to UUID=$2
update_fstab_esp_uuid() {
    local mp="$1" new_uuid="$2" old_dev="$3" old_uuid="$4"
    [[ -f "$FSTAB_PATH" ]] || return 0

    cp -a "$FSTAB_PATH" "${FSTAB_PATH}.bak-efi-resize"
    local tmp_fstab
    tmp_fstab="$(mktemp "${FSTAB_PATH}.efi-resize.XXXXXX")"

    awk -v mp="$mp" -v nuuid="$new_uuid" -v odev="$old_dev" -v ouuid="$old_uuid" '
        BEGIN { updated = 0 }
        /^[[:space:]]*#/ || NF < 3 { print; next }
        $2 == mp {
            $1 = "UUID=" nuuid
            updated = 1
            print
            next
        }
        { print }
        END {
            if (!updated) {
                printf "UUID=%s\t%s\tvfat\tumask=0077\t0 2\n", nuuid, mp
            }
        }
    ' "$FSTAB_PATH" > "$tmp_fstab"

    chmod --reference="$FSTAB_PATH" "$tmp_fstab" 2>/dev/null || chmod 0644 "$tmp_fstab"
    mv -f "$tmp_fstab" "$FSTAB_PATH"
}

register_uefi_boot_entry() {
    local disk="$1" part_num="$2" esp_dir="$3"
    [[ "$SKIP_NVRAM" == "1" ]] && return 0
    [[ -d /sys/firmware/efi/efivars ]] || return 0
    command -v efibootmgr >/dev/null 2>&1 || return 0

    local loader="" label="Mainstream"
    if [[ -f "$esp_dir/EFI/limine/BOOTX64.EFI" ]]; then
        loader='\EFI\limine\BOOTX64.EFI'
    elif [[ -f "$esp_dir/EFI/systemd/systemd-bootx64.efi" ]]; then
        loader='\EFI\systemd\systemd-bootx64.efi'
    elif [[ -f "$esp_dir/EFI/BOOT/BOOTX64.EFI" ]]; then
        loader='\EFI\BOOT\BOOTX64.EFI'
    fi

    if [[ -n "$loader" ]]; then
        efibootmgr --create --disk "$disk" --part "$part_num" \
            --label "$label" --loader "$loader" --unicode >/dev/null 2>&1 || true
    fi
}

find_next_free_partn() {
    local disk="$1" sfdisk_json used_nums n
    sfdisk_json="$(sfdisk -J "$disk")"
    used_nums="$(jq -r '.partitiontable.partitions // [] | .[].node' <<<"$sfdisk_json" | while read -r nd; do
        resolve_part_num "$nd" || true
    done)"
    for (( n = 1; n <= 128; n++ )); do
        if ! grep -qx "$n" <<<"$used_nums"; then
            printf '%s\n' "$n"
            return 0
        fi
    done
    return 1
}

# Variables tracked for emergency rollback
BACKUP_DIR=""
TMP_ESP_MNT=""
SFDISK_BACKUP=""
ROLLBACK_DISK=""
ROLLBACK_BTRFS_MNT=""
ROLLBACK_REMOUNT_DEV=""
ROLLBACK_REMOUNT_TARGET=""
AUTOMOUNT_UNIT=""

cleanup_and_rollback() {
    local exit_code=$?
    if [[ -n "$TMP_ESP_MNT" ]]; then
        umount "$TMP_ESP_MNT" 2>/dev/null || true
        rmdir "$TMP_ESP_MNT" 2>/dev/null || true
    fi
    if (( exit_code != 0 )); then
        if [[ -n "$ROLLBACK_DISK" && -n "$SFDISK_BACKUP" && -f "$SFDISK_BACKUP" ]]; then
            sfdisk --force --no-reread "$ROLLBACK_DISK" < "$SFDISK_BACKUP" >/dev/null 2>&1 || true
            refresh_kernel_parttable "$ROLLBACK_DISK"
        fi
        if [[ -n "$ROLLBACK_BTRFS_MNT" ]]; then
            btrfs filesystem resize max "$ROLLBACK_BTRFS_MNT" >/dev/null 2>&1 || true
        fi
        if [[ -n "$ROLLBACK_REMOUNT_DEV" && -n "$ROLLBACK_REMOUNT_TARGET" ]]; then
            if ! mountpoint -q "$ROLLBACK_REMOUNT_TARGET" 2>/dev/null; then
                mount "$ROLLBACK_REMOUNT_DEV" "$ROLLBACK_REMOUNT_TARGET" 2>/dev/null || true
            fi
        fi
    fi
    if [[ -n "$AUTOMOUNT_UNIT" ]]; then
        systemctl start "$AUTOMOUNT_UNIT" 2>/dev/null || true
    fi
    if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]] && (( exit_code == 0 )); then
        rm -rf "$BACKUP_DIR"
    fi
    [[ -n "$SFDISK_BACKUP" && -f "$SFDISK_BACKUP" ]] && rm -f "$SFDISK_BACKUP" || true
}

cmd_resize() {
    local target_mb="${1:-}"
    if [[ -z "$target_mb" || ! "$target_mb" =~ ^[0-9]+$ ]]; then
        die_json "Invalid target size '${target_mb}'. Expected integer MB."
    fi
    if (( target_mb < MIN_TARGET_MB || target_mb > MAX_TARGET_MB )); then
        die_json "Target size must be between ${MIN_TARGET_MB} MB and ${MAX_TARGET_MB} MB."
    fi

    mkdir -p "$(dirname "$BOOT_LOCK")"
    exec 9>"$BOOT_LOCK"
    if ! flock -w 30 9; then
        die_json "Boot partition is currently locked by another system update or snapshot task. Try again in a moment."
    fi

    emit_progress "preflight" 5 "Inspecting GPT layout and free space..."
    if ! analyze_layout "$target_mb"; then
        die_json "${REASON:-Unsupported partition layout.}"
    fi

    local cur_mb=$(( ESP_TOTAL_BYTES / (1024 * 1024) ))
    if (( target_mb <= cur_mb + 32 )); then
        die_json "EFI partition is already ${cur_mb} MB (choose a larger target size)."
    fi

    local used_mb=$(( ESP_USED_BYTES / (1024 * 1024) ))
    if (( target_mb < used_mb + 128 )); then
        die_json "Target size (${target_mb} MB) is too small for current boot files (${used_mb} MB used)."
    fi

    trap cleanup_and_rollback EXIT

    mkdir -p -m 0700 "$BACKUP_BASE"
    SFDISK_BACKUP="$(mktemp "$BACKUP_BASE/sfdisk-backup.XXXXXX")"
    sfdisk -d "$ESP_DISK" > "$SFDISK_BACKUP"

    local align_sec=$(( 1048576 / SECTOR_SIZE ))
    (( align_sec < 1 )) && align_sec=1
    local target_sec=$(( (target_mb * 1048576) / SECTOR_SIZE ))
    target_sec=$(( (target_sec / align_sec) * align_sec ))

    if [[ "$STRATEGY" == "inplace_grow" ]]; then
        # ── Strategy 1: Grow existing ESP in place ──────────────────────────
        if (( target_sec > GAP_SIZE_SEC )); then
            target_sec="$GAP_SIZE_SEC"
        fi

        emit_progress "backup" 18 "Backing up EFI boot files from ${ESP_MNT}..."
        BACKUP_DIR="$(mktemp -d "$BACKUP_BASE/efi-backup.XXXXXX")"
        chmod 0700 "$BACKUP_DIR"
        cp -a "$ESP_MNT/." "$BACKUP_DIR/"
        sync

        # Stop systemd automount unit if active so it doesn't remount during mkfs
        local unit_escaped
        unit_escaped="$(systemd-escape -p --suffix=automount "$ESP_MNT" 2>/dev/null || true)"
        if [[ -n "$unit_escaped" ]] && systemctl is-active --quiet "$unit_escaped" 2>/dev/null; then
            AUTOMOUNT_UNIT="$unit_escaped"
            systemctl stop "$AUTOMOUNT_UNIT" 2>/dev/null || true
        fi

        emit_progress "partition" 40 "Unmounting ${ESP_MNT} and extending GPT partition ${ESP_DEV}..."
        ROLLBACK_DISK="$ESP_DISK"
        ROLLBACK_REMOUNT_DEV="$ESP_DEV"
        ROLLBACK_REMOUNT_TARGET="$ESP_MNT"

        umount "$ESP_MNT" || die_json "Could not unmount ${ESP_MNT}; close any open files on the boot partition."

        # Extend partition end boundary via sfdisk
        printf ',%s\n' "$target_sec" | sfdisk --force --no-reread -N "$ESP_PARTN" "$ESP_DISK" >/dev/null
        refresh_kernel_parttable "$ESP_DISK"

        emit_progress "format" 60 "Formatting expanded FAT32 EFI System Partition..."
        local clean_vol_id="${ESP_UUID//-/}"
        clean_vol_id="${clean_vol_id^^}"
        if [[ "$clean_vol_id" =~ ^[0-9A-F]{8}$ ]]; then
            mkfs.vfat -F 32 -n "EFI" -i "$clean_vol_id" "$ESP_DEV" >/dev/null
        else
            mkfs.vfat -F 32 -n "EFI" "$ESP_DEV" >/dev/null
            local fresh_uuid
            fresh_uuid="$(blkid -s UUID -o value "$ESP_DEV" 2>/dev/null || true)"
            if [[ -n "$fresh_uuid" ]]; then
                update_fstab_esp_uuid "$ESP_MNT" "$fresh_uuid" "$ESP_DEV" "$ESP_UUID"
            fi
        fi
        refresh_kernel_parttable "$ESP_DISK"

        emit_progress "restore" 78 "Mounting ${ESP_MNT} and restoring boot files..."
        mount "$ESP_DEV" "$ESP_MNT"
        ROLLBACK_DISK="" # Partition has new FS; keep mounted rather than reverting table over formatted FS
        copy_esp_tree "$BACKUP_DIR" "$ESP_MNT"

        emit_progress "verify" 92 "Verifying bootloader integrity and UKI hashes..."
        verify_esp_contents "$BACKUP_DIR" "$ESP_MNT" || die_json "Bootloader verification failed after restore (backup preserved at $BACKUP_DIR)."

        local final_bytes
        final_bytes="$(lsblk -bdno SIZE "$ESP_DEV" 2>/dev/null | tr -d ' ' || echo 0)"
        if (( final_bytes < target_mb * 1024 * 1024 * 90 / 100 )); then
            die_json "Kernel reported unchanged partition size (${final_bytes} bytes) on ${ESP_DEV}."
        fi

        if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
            systemctl daemon-reload 2>/dev/null || true
        fi

        emit_progress "done" 100 "EFI boot partition expanded in place to $(( final_bytes / (1024 * 1024) )) MB."
        return 0
    fi

    # ── Strategy 2 & 3: Build & verify new GPT ESP before atomic cutover ────
    local new_esp_start=0 new_esp_sec="$target_sec"
    local new_partn
    new_partn="$(find_next_free_partn "$ESP_DISK")" || die_json "No free GPT partition number available on $ESP_DISK."
    local new_esp_dev
    new_esp_dev="$(part_path_for_num "$ESP_DISK" "$new_partn")"

    if [[ "$STRATEGY" == "new_esp_unallocated" ]]; then
        new_esp_start="$GAP_START_SEC"
        if (( new_esp_sec > GAP_SIZE_SEC )); then
            new_esp_sec="$GAP_SIZE_SEC"
        fi
        ROLLBACK_DISK="$ESP_DISK"
        emit_progress "partition" 25 "Creating new ${target_mb} MB EFI System Partition (${new_esp_dev})..."
        local updated_dump
        updated_dump="$(cat "$SFDISK_BACKUP")"$'\n'"${new_esp_dev} : start= ${new_esp_start}, size= ${new_esp_sec}, type=${ESP_GPT_TYPE}, name=\"Mainstream EFI\""
        sfdisk --force --no-reread "$ESP_DISK" <<<"$updated_dump" >/dev/null
        refresh_kernel_parttable "$ESP_DISK"

    elif [[ "$STRATEGY" == "tail_btrfs_relocate" ]]; then
        new_esp_start=$(( ((LAST_LBA - new_esp_sec + 1) / align_sec) * align_sec ))
        new_esp_sec=$(( ((LAST_LBA - new_esp_start + 1) / align_sec) * align_sec ))
        local new_tail_end=$(( new_esp_start - 1 ))
        local new_tail_size=$(( new_tail_end - TAIL_START_SEC + 1 ))
        if (( new_tail_size <= align_sec )); then
            die_json "Calculated shrunk partition size for ${TAIL_DEV} is invalid."
        fi

        local old_tail_bytes=$(( TAIL_SIZE_SEC * SECTOR_SIZE ))
        local new_tail_bytes=$(( new_tail_size * SECTOR_SIZE ))
        local shrink_bytes=$(( old_tail_bytes - new_tail_bytes + SHRINK_CUSHION_BYTES ))

        emit_progress "shrink" 20 "Shrinking Btrfs filesystem (${TAIL_MNT}) to free ${target_mb} MB at end of disk..."
        ROLLBACK_BTRFS_MNT="$TAIL_MNT"
        btrfs filesystem resize "-${shrink_bytes}" "$TAIL_MNT" >/dev/null
        btrfs filesystem sync "$TAIL_MNT" >/dev/null 2>&1 || sync

        # Verify Btrfs logical device size is strictly <= new_tail_bytes before touching GPT!
        local btrfs_cur_bytes
        btrfs_cur_bytes="$(btrfs filesystem usage -b "$TAIL_MNT" 2>/dev/null | awk '/Device size:/ {print $3; exit}' || echo 0)"
        if (( btrfs_cur_bytes == 0 || btrfs_cur_bytes > new_tail_bytes )); then
            die_json "Btrfs volume size (${btrfs_cur_bytes}) did not shrink below target boundary (${new_tail_bytes}); aborting safely before partition edit."
        fi

        emit_progress "partition" 42 "Updating GPT boundaries and creating ${new_esp_dev}..."
        ROLLBACK_DISK="$ESP_DISK"
        local rewritten_dump
        rewritten_dump="$(awk -v tdev="$TAIL_DEV" -v nsize="$new_tail_size" '
            $1 == tdev && $2 == ":" {
                sub(/size=[[:space:]]*[0-9]+/, "size= " nsize)
            }
            { print }
        ' "$SFDISK_BACKUP")"$'\n'"${new_esp_dev} : start= ${new_esp_start}, size= ${new_esp_sec}, type=${ESP_GPT_TYPE}, name=\"Mainstream EFI\""

        sfdisk --force --no-reread "$ESP_DISK" <<<"$rewritten_dump" >/dev/null
        refresh_kernel_parttable "$ESP_DISK"

        emit_progress "reexpand" 55 "Snapping Btrfs filesystem to updated partition boundary..."
        btrfs filesystem resize max "$TAIL_MNT" >/dev/null
        btrfs filesystem sync "$TAIL_MNT" >/dev/null 2>&1 || sync
    else
        die_json "Unhandled resize strategy '${STRATEGY}'."
    fi

    # Wait for kernel block node for $new_esp_dev
    local tries=0
    while [[ ! -b "$new_esp_dev" ]] && (( tries < 20 )); do
        sleep 0.2
        refresh_kernel_parttable "$ESP_DISK"
        tries=$(( tries + 1 ))
    done
    [[ -b "$new_esp_dev" ]] || die_json "Kernel block device ${new_esp_dev} did not appear after GPT update."

    emit_progress "format" 68 "Formatting new EFI System Partition (${new_esp_dev}) as FAT32..."
    mkfs.vfat -F 32 -n "MSEFI" "$new_esp_dev" >/dev/null
    refresh_kernel_parttable "$ESP_DISK"
    local new_uuid=""
    tries=0
    while [[ -z "$new_uuid" ]] && (( tries < 15 )); do
        new_uuid="$(blkid -s UUID -o value "$new_esp_dev" 2>/dev/null || lsblk -dno UUID "$new_esp_dev" 2>/dev/null | tr -d ' ' || true)"
        [[ -n "$new_uuid" ]] && break
        sleep 0.2
        tries=$(( tries + 1 ))
    done
    [[ -n "$new_uuid" ]] || die_json "Could not read FAT32 UUID from ${new_esp_dev}."

    emit_progress "copy" 80 "Copying bootloader and UKI images to ${new_esp_dev}..."
    mkdir -p /run/mainstream
    TMP_ESP_MNT="$(mktemp -d /run/mainstream/new-esp.XXXXXX)"
    mount "$new_esp_dev" "$TMP_ESP_MNT"
    copy_esp_tree "$ESP_MNT" "$TMP_ESP_MNT"

    emit_progress "verify" 90 "Verifying UKIs, Limine pins, and registering UEFI boot entry..."
    verify_esp_contents "$ESP_MNT" "$TMP_ESP_MNT" || die_json "Verification of new EFI partition failed; rolling back cleanly."

    register_uefi_boot_entry "$ESP_DISK" "$new_partn" "$TMP_ESP_MNT"
    update_fstab_esp_uuid "$ESP_MNT" "$new_uuid" "$ESP_DEV" "$ESP_UUID"

    emit_progress "cutover" 96 "Switching ${ESP_MNT} mount to ${new_esp_dev}..."
    umount "$TMP_ESP_MNT"
    rmdir "$TMP_ESP_MNT"
    TMP_ESP_MNT=""

    local unit_escaped
    unit_escaped="$(systemd-escape -p --suffix=automount "$ESP_MNT" 2>/dev/null || true)"
    if [[ -n "$unit_escaped" ]] && systemctl is-active --quiet "$unit_escaped" 2>/dev/null; then
        AUTOMOUNT_UNIT="$unit_escaped"
        systemctl stop "$AUTOMOUNT_UNIT" 2>/dev/null || true
    fi

    umount "$ESP_MNT" || die_json "New EFI partition is ready and configured in fstab, but ${ESP_MNT} was busy; reboot to activate."
    mount "$new_esp_dev" "$ESP_MNT"

    # Commit succeeded — disarm rollback!
    ROLLBACK_DISK=""
    ROLLBACK_BTRFS_MNT=""

    if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload 2>/dev/null || true
    fi
    if command -v mainstream-limine-windows >/dev/null 2>&1 && [[ -f "$ESP_MNT/limine.conf" ]]; then
        mainstream-limine-windows >/dev/null 2>&1 || true
    fi

    local final_bytes
    final_bytes="$(lsblk -bdno SIZE "$new_esp_dev" 2>/dev/null | tr -d ' ' || echo 0)"
    emit_progress "done" 100 "EFI boot partition expanded to $(( final_bytes / (1024 * 1024) )) MB on ${new_esp_dev}."
}

case "${1:-}" in
    probe)
        cmd_probe "${2:-2048}"
        ;;
    resize)
        cmd_resize "${2:-}"
        ;;
    *)
        echo "Usage: $0 {probe [target_mb]|resize <target_mb>}" >&2
        exit 1
        ;;
esac
