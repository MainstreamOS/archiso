#!/usr/bin/env bash
# =============================================================================
# finalize-install
# Calamares shellprocess — runs inside the installed system chroot AFTER
# install-gpu-drivers and BEFORE desktopcleanup.
#
# Post-install cleanup pass. GPU drivers are no longer shipped on the live
# ISO — install-gpu-drivers installs the right stack on the TARGET — but
# generic provides can still leak the wrong vendor in (see the wrong-vendor
# prune below). What runs here:
#
#   - Live-only tooling (arch-install-scripts, archinstall, syslinux,
#     mkinitcpio-archiso, calamares, memtest86+, edk2-shell, etc.)
#   - Wrong-vendor GPU driver prune (defense in depth against --noconfirm
#     provider auto-selection, e.g. Steam pulling lib32-nvidia-utils)
#   - Wrong CPU microcode (intel-ucode on AMD, amd-ucode on Intel) — the
#     ISO ships both; keep only the one the detected CPU uses
#   - Live-only sudoers drop-ins (g_wheel NOPASSWD, liveuser) and the
#     /home/liveuser directory Calamares' removeuser leaves behind
#
# CPU detection mirrors post-install — vendor_id from /proc/cpuinfo.
# =============================================================================

set -uo pipefail

log()  { echo "[finalize-install] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; }

remove_pkgs() {
    # Filter to packages that are actually installed first: pacman -Rns is
    # all-or-nothing, so one absent name ("target not found") would abort the
    # whole removal and silently prune NOTHING.
    local installed=() p
    for p in "$@"; do
        pacman -Qq "$p" >/dev/null 2>&1 && installed+=("$p")
    done
    [[ ${#installed[@]} -eq 0 ]] && return 0
    info "Removing: ${installed[*]}"
    # -Rns: cascade unused deps + remove config files. --noconfirm for
    # automation. -Rns is also all-or-nothing on dependency refusals: if ONE
    # target is still required by something, the whole batch is vetoed. Fall
    # back to per-package removal so a single refusal can't shield the rest.
    # A package that still can't be removed is kept — better a stray package
    # than a broken install.
    if ! pacman -Rns --noconfirm "${installed[@]}" 2>&1 | sed 's/^/[cleanup] /'; then
        warn "Batch removal refused — retrying per package."
        for p in "${installed[@]}"; do
            pacman -Qq "$p" >/dev/null 2>&1 || continue
            pacman -Rns --noconfirm "$p" 2>&1 | sed 's/^/[cleanup] /' \
                || warn "Could not remove $p (still required by something) — keeping it."
        done
    fi
    return 0
}

# ── CPU detection ────────────────────────────────────────────────────────────
CPU_VENDOR=$(awk -F: '/vendor_id/ {gsub(/ /,"",$2); print $2; exit}' /proc/cpuinfo)
info "CPU vendor: $CPU_VENDOR"

# ── Live-only tooling ────────────────────────────────────────────────────────
# These are needed during install but useless on the target. Removing them
# saves ~250 MB of disk and a pile of pacman update churn the user would
# otherwise hit on every -Syu.
#
# NOT included here even though they look live-only:
#   - dosfstools: needed if user creates FAT partitions post-install
#   - testdisk, os-prober, nano, openssh, less, man-db, terminus-font:
#     genuinely useful on the installed system
LIVEONLY=(
    arch-install-scripts
    archinstall
    mkinitcpio-archiso
    mkinitcpio-nfs-utils
    syslinux
    mtools
    squashfs-tools
    nbd
    memtest86+
    memtest86+-efi
    livecd-sounds
    edk2-shell
    reflector
    pv
    calamares-mainstream
    ckbcomp
    hwinfo
    kcrash
    kpmcore
    b43-fwcutter
)

# Calamares: only present on the live ISO, but if a user re-runs Calamares
# from inside their installed system somehow we don't want to nuke it.
# Defensive shape — never abort the install on a package that wasn't there.
remove_pkgs "${LIVEONLY[@]}"

# ── Wrong-vendor GPU driver prune (defense in depth) ─────────────────────────
# install-gpu-drivers installs the right stack for the detected hardware, but
# generic provides can still leak the wrong vendor in: with --noconfirm,
# pacman resolves an unsatisfied lib32-vulkan-driver / opengl-driver dep to
# the alphabetically-first provider — e.g. Steam pulling lib32-nvidia-utils
# (→ nvidia-utils, egl-*) onto an AMD-only machine. By the time we run, the
# correct vendor's providers are installed, so removing the wrong vendor's
# packages cannot break dependencies — and -Rns refuses (|| true) rather than
# breaks if something genuinely still needs one. mesa / lib32-mesa are shared
# by every vendor path and are never touched. Firmware (linux-firmware-*) is
# left alone: the linux-firmware meta-package depends on all vendor splits.
GPU_INFO=$(lspci 2>/dev/null | grep -iE "VGA|3D|Display" || true)
HAS_NVIDIA=false; HAS_AMD=false; HAS_INTEL=false
if [[ -n "$GPU_INFO" ]]; then
    lspci -nn 2>/dev/null | grep -iE "VGA|3D|Display" | grep -q "\[10de:" && HAS_NVIDIA=true || true
    lspci -nn 2>/dev/null | grep -iE "VGA|3D|Display" | grep -q "\[1002:" && HAS_AMD=true    || true
    lspci -nn 2>/dev/null | grep -iE "VGA|3D|Display" | grep -q "\[8086:" && HAS_INTEL=true  || true
    info "Detected GPUs: NVIDIA=$HAS_NVIDIA AMD=$HAS_AMD Intel=$HAS_INTEL"

    # egl-wayland/egl-gbm/egl-x11/egl-wayland2 are intentionally NOT listed:
    # they're dependencies of nvidia-utils, so -Rns cascades them away — and
    # listing them explicitly would let any future outside dependent (mutter
    # depends on egl-wayland) veto the batch.
    NVIDIA_PKGS=(
        nvidia nvidia-open nvidia-dkms nvidia-open-dkms
        nvidia-utils lib32-nvidia-utils nvidia-settings nvidia-prime
        libva-nvidia-driver opencl-nvidia lib32-opencl-nvidia
        nvidia-580xx-dkms nvidia-580xx-utils lib32-nvidia-580xx-utils
        nvidia-580xx-settings opencl-nvidia-580xx libxnvctrl-580xx
        nvidia-470xx-dkms nvidia-470xx-utils lib32-nvidia-470xx-utils
        opencl-nvidia-470xx
        nvidia-390xx-dkms nvidia-390xx-utils opencl-nvidia-390xx
    )
    AMD_PKGS=(
        vulkan-radeon lib32-vulkan-radeon xf86-video-amdgpu xf86-video-ati
    )
    INTEL_PKGS=(
        vulkan-intel lib32-vulkan-intel intel-media-driver
        intel-compute-runtime libva-intel-driver xf86-video-intel
    )

    if ! $HAS_NVIDIA; then
        info "No NVIDIA GPU — removing NVIDIA driver stack."
        remove_pkgs "${NVIDIA_PKGS[@]}"
    fi
    if ! $HAS_AMD; then
        info "No AMD GPU — removing AMD driver stack."
        remove_pkgs "${AMD_PKGS[@]}"
    fi
    if ! $HAS_INTEL; then
        info "No Intel GPU — removing Intel driver stack."
        remove_pkgs "${INTEL_PKGS[@]}"
    fi
else
    warn "No GPU detected via lspci — skipping wrong-vendor driver prune."
fi

# ── CPU microcode prune ──────────────────────────────────────────────────────
# The bootloader entries reference both microcode initrds; the CPU
# applies the matching one and ignores the other. Removing the wrong one
# costs nothing — boot still finds and applies the right one. ~10 MB saved.
case "$CPU_VENDOR" in
    GenuineIntel) info "Intel CPU — removing amd-ucode."; remove_pkgs amd-ucode ;;
    AuthenticAMD) info "AMD CPU — removing intel-ucode.";  remove_pkgs intel-ucode ;;
    *) warn "Unknown CPU vendor — keeping both microcode packages." ;;
esac

# ── Live-only loose files (not pacman-owned) ─────────────────────────────────
# Shipped via airootfs/etc/ but useless on the installed system. pacman
# -Rns can't touch these (no owning package); rm them by hand.
LOOSE_FILES=(
    # /etc/sudoers.d/builduser is dropped by install-yay at the end of
    # its run, but if that script aborted mid-flight the file might
    # still be here. Removing again is safe.
    /etc/sudoers.d/builduser
    # /etc/sudoers.d/g_wheel grants %wheel passwordless sudo for the
    # live ISO so the liveuser can run the installer. Carrying it
    # forward to the installed system would silently give every
    # wheel-group user NOPASSWD sudo, which is a hard "no" for a
    # general-audience desktop. Calamares' users module will generate
    # a proper wheel sudoers entry that DOES prompt for a password
    # (sudoersGroup: wheel in users.conf).
    /etc/sudoers.d/g_wheel
    # /etc/sudoers.d/liveuser grants the liveuser passwordless sudo.
    # The liveuser account itself is removed by calamares' removeuser
    # module, but the sudoers file isn't owned by any package so it
    # lingers on disk pointing at a non-existent user.
    /etc/sudoers.d/liveuser
)
for f in "${LOOSE_FILES[@]}"; do
    if [[ -e "$f" ]]; then
        info "Removing live-only file: $f"
        rm -f "$f" || warn "Could not remove $f"
    fi
done

# ── Live-only directories ───────────────────────────────────────────────────
LOOSE_DIRS=(
    # /home/liveuser is the home directory for the live ISO's
    # liveuser account. Calamares' removeuser module deletes the
    # account from /etc/passwd but invokes `userdel` without `-r`,
    # so the home directory itself stays on disk pointing at a
    # non-existent user. Sweep it.
    /home/liveuser
)
for d in "${LOOSE_DIRS[@]}"; do
    if [[ -d "$d" ]]; then
        info "Removing live-only directory: $d"
        rm -rf "$d" || warn "Could not remove $d"
    fi
done

# ── Passwordless-sudo cleanup ───────────────────────────────────────────────
# /etc/sudoers.d/g_wheel is shipped in the airootfs with
# `%wheel ALL=(ALL:ALL) NOPASSWD: ALL` so the live ISO's installer
# (Calamares and its post-install scripts, including the packages
# module that drives yay-based netinstall) can run sudo without
# prompting on a TTY-less install. By the time finalize-install runs,
# all those passwordless-sudo consumers have completed. Replace
# g_wheel with the standard password-requiring %wheel rule
# synchronously — no first-boot oneshot, no deferred dependency.
if [[ -f /etc/sudoers.d/g_wheel ]]; then
    info "Replacing passwordless g_wheel with standard wheel sudoers rule..."
    {
        wheel_tmp=$(mktemp)
        printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$wheel_tmp"
        if visudo -cf "$wheel_tmp" >/dev/null 2>&1; then
            install -m 0440 -o root -g root "$wheel_tmp" /etc/sudoers.d/wheel
            rm -f /etc/sudoers.d/g_wheel
        else
            warn "Generated wheel sudoers file failed visudo validation; leaving g_wheel in place."
        fi
        rm -f "$wheel_tmp"
    }
fi

info "Cleanup done."
exit 0
