#!/usr/bin/env bash
# =============================================================================
# post-install (Universal GPU, SDDM-Hyprland, Speed & Cleanup)
# =============================================================================

set -euo pipefail

# Merge stderr into stdout so every message — including output from subprocesses
# like uv, find, ls, and sed — appears in the Calamares log in order.
# Calamares captures the shellprocess stdout; without this, stderr lines are
# either interleaved unpredictably or dropped entirely depending on the version.
exec 2>&1

log()  { echo "[post-install] $*"; }
info() { log "INFO:  $*"; }
warn() { log "WARN:  $*"; }


write_limine_defaults() {
    mkdir -p /etc/default
    cat > /etc/default/limine << 'LIMINEDEF'
TARGET_OS_NAME="Mainstream OS\\"
FIND_BOOTLOADERS=no
SNAPPER_CONFIG_NAME=root
ENABLE_UKI=yes
CUSTOM_UKI_NAME="mainstream"
LIMINEDEF
}

# NOTE: refresh_limine_uki_entry was removed. limine-mkinitcpio-hook owns the
# single branded "/+Mainstream OS\\" entry (machine-id tracked, with the real
# UKI hash + cmdline), so hand-writing a "/Mainstream OS\\" entry only produced
# a hash-less duplicate (the hook's entry starts "/+", which the old awk never
# matched). The branded entry now comes straight from the hook; see the prune +
# brand step after limine-mkinitcpio below.

parse_disk_part_from_source() {
    local source="$1"

    if [[ "$source" =~ ^(/dev/nvme[0-9]+n[0-9]+)p([0-9]+)$ ]]; then
        printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    elif [[ "$source" =~ ^(/dev/mmcblk[0-9]+)p([0-9]+)$ ]]; then
        printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    elif [[ "$source" =~ ^(/dev/[a-z]+)([0-9]+)$ ]]; then
        printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    else
        return 1
    fi
}

cleanup_limine_boot_entries() {
    local esp_path=""
    local label="Mainstream"
    local loader_path="\\EFI\\limine\\BOOTX64.EFI"
    local loader_path_normalized="/efi/limine/bootx64.efi"

    [[ -d /boot/efi ]] && esp_path="/boot/efi"
    [[ -z "$esp_path" && -d /boot ]] && esp_path="/boot"
    [[ -n "$esp_path" ]] || { warn "No ESP mount found — skipping boot entry cleanup."; return 0; }

    write_limine_defaults

    if [[ -d "$esp_path/EFI" ]]; then
        info "Removing stale fallback and old bootloader files from $esp_path..."
        rm -rf \
            "$esp_path/EFI/BOOT" \
            "$esp_path/EFI/grub" \
            "$esp_path/EFI/GRUB" \
            "$esp_path/EFI/systemd" \
            "$esp_path/EFI/refind" \
            "$esp_path/loader" \
            "$esp_path/grub" \
            2>/dev/null || true
    fi

    if [[ -f "$esp_path/EFI/Linux/mainstream_linux.efi" ]]; then
        rm -f \
            "$esp_path/vmlinuz-linux" \
            "$esp_path/initramfs-linux.img" \
            "$esp_path/initramfs-linux-fallback.img" \
            2>/dev/null || true
    fi

    command -v efibootmgr >/dev/null 2>&1 || { warn "efibootmgr not found — skipping NVRAM cleanup."; return 0; }

    local source part_uuid disk part
    source=$(findmnt -n -o SOURCE "$esp_path" 2>/dev/null) || { warn "findmnt failed for $esp_path — skipping NVRAM cleanup."; return 0; }
    part_uuid=$(findmnt -n -o PARTUUID "$esp_path" 2>/dev/null) || { warn "PARTUUID lookup failed for $esp_path — skipping NVRAM cleanup."; return 0; }
    [[ -n "$part_uuid" ]] || { warn "Empty PARTUUID for $esp_path — skipping NVRAM cleanup."; return 0; }

    read -r disk part < <(parse_disk_part_from_source "$source") || {
        warn "Could not parse disk/partition from $source — skipping NVRAM cleanup."
        return 0
    }

    local efibootmgr_output line bootnum normalized keep_existing=false
    efibootmgr_output=$(efibootmgr -v 2>/dev/null) || { warn "efibootmgr read failed — skipping NVRAM cleanup."; return 0; }

    while IFS= read -r line; do
        [[ "$line" =~ ^Boot([0-9A-Fa-f]{4})\*?[[:space:]] ]] || continue
        bootnum="${BASH_REMATCH[1]}"
        grep -Fqi "$part_uuid" <<< "$line" || continue

        normalized="$(tr '[:upper:]' '[:lower:]' <<< "$line" | tr '\\' '/')"

        if grep -Eqi "^Boot${bootnum}\\*?[[:space:]]+${label}[[:space:]]" <<< "$line" \
                && [[ "$normalized" == *"$loader_path_normalized"* ]]; then
            if $keep_existing; then
                efibootmgr -b "$bootnum" -B >/dev/null 2>&1 || true
            else
                keep_existing=true
            fi
            continue
        fi

        case "$normalized" in
            *"/efi/limine/bootx64.efi"*|*"/efi/boot/bootx64.efi"*|*"/efi/grub/"*|*"/efi/systemd/"*|*"/efi/refind/"*|*"/shimx64.efi"*|*"/grubx64.efi"*|*"/systemd-bootx64.efi"*)
                efibootmgr -b "$bootnum" -B >/dev/null 2>&1 || true
                ;;
        esac

        # Also delete any entry labelled bare "Limine" (the default label that
        # limine-install uses) regardless of path — these are stale live-ISO entries.
        if grep -Eqi "^Boot${bootnum}\*?[[:space:]]+Limine[[:space:]]" <<< "$line"; then
            efibootmgr -b "$bootnum" -B >/dev/null 2>&1 || true
        fi
    done <<< "$efibootmgr_output"

    if ! $keep_existing; then
        if efibootmgr --create \
            --disk "$disk" \
            --part "$part" \
            --label "$label" \
            --loader "$loader_path" \
            --unicode >/dev/null 2>&1; then
            info "Created single NVRAM entry '$label' for $loader_path (PARTUUID=$part_uuid)."
        else
            warn "Failed to create '$label' NVRAM entry."
        fi
    else
        info "Kept single NVRAM entry '$label' for Limine."
    fi
}

# ---------------------------------------------------------------------------
# 1. IDENTIFY USERS (SAFETY CHECK)
# ---------------------------------------------------------------------------
# Identify the actual user created by Calamares (UID 1000)
MAIN_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 <= 1001 {print $1}' | grep -vE '(liveuser|builduser|nobody|root)' | head -n 1 || true)
MAIN_USER_HOME="/home/$MAIN_USER"

info "Verifying target environment..."
if [[ -z "$MAIN_USER" ]]; then
    log "ERROR: Primary user (UID 1000) not detected. Check Calamares logs."
elif [[ "$MAIN_USER" == "builduser" ]]; then
    log "WARNING: UID 1000 is 'builduser'. Skipping account purge to prevent lockout."
fi

# ---------------------------------------------------------------------------
# 2. THE CALAMARES & BOOT PURGE
# ---------------------------------------------------------------------------
info "Removing installer artifacts and masking redundant setup..."

# Remove Calamares and its autostart triggers
pacman -Rs --noconfirm calamares-mainstream || true
rm -f /etc/xdg/autostart/calamares* || true
rm -f /usr/share/applications/calamares.desktop || true

if [[ -n "$MAIN_USER" && "$MAIN_USER" != "builduser" ]]; then
    rm -rf "$MAIN_USER_HOME/.config/autostart/calamares"* || true
    rm -f "$MAIN_USER_HOME/Desktop/install-arch.desktop" || true
fi

# ---------------------------------------------------------------------------
# 3. LIVE SERVICE CLEANUP
# ---------------------------------------------------------------------------
info "Removing live-only services..."

# Remove live-ISO-only unit files entirely — disabling is not enough because
# etc-pacman.d-gnupg.mount mounts a tmpfs over the keyring directory,
# destroying any keys written there on every reboot.
for unit in \
    /etc/systemd/system/etc-pacman.d-gnupg.mount \
    /etc/systemd/system/pacman-init.service; do
    if [[ -f "$unit" ]]; then
        systemctl disable "$(basename "$unit")" 2>/dev/null || true
        rm -f "$unit"
        info "Removed live-only unit: $(basename "$unit")"
    fi
done

# Disable other live-ISO-only services (unit files owned by packages, so
# disable only — don't delete).
for svc in \
    reflector.service \
    reflector.timer \
    sshd.service; do
    if systemctl is-enabled "$svc" &>/dev/null; then
        info "Disabling live-only service: $svc"
        systemctl disable "$svc" || true
    fi
done

# Mask systemd-networkd — redundant alongside NetworkManager and can
# cause conflicts if both try to manage the same interface.
# Does NOT affect DNS resolution or keyring connectivity.
systemctl mask systemd-networkd.service || true
systemctl mask systemd-networkd.socket || true
systemctl mask systemd-networkd-persistent-storage.service || true

# ---------------------------------------------------------------------------
# 4. MKINITCPIO PREP
# GPU detection, module injection, modprobe config, and env vars are all
# handled by the install-gpu-drivers shellprocess which runs before this.
# Here we only: position the resume hook, clean up archiso preset, and
# restore the standard linux.preset before the final mkinitcpio -P call.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 4b. PLYMOUTH WITH MAINSTREAM THEME
# ---------------------------------------------------------------------------
info "Installing Plymouth boot splash..."
if pacman -S --noconfirm --needed plymouth; then
    THEME_SRC="/tmp/dotfiles-setup/sdata/plymouth/mainstream"
    THEME_DST="/usr/share/plymouth/themes/mainstream"

    if [[ -d "$THEME_SRC" ]]; then
        info "Deploying Mainstream Plymouth theme..."
        rm -rf "$THEME_DST"
        cp -r "$THEME_SRC" "$THEME_DST"
        chown -R root:root "$THEME_DST"
        find "$THEME_DST" -type d -exec chmod 755 {} +
        find "$THEME_DST" -type f -exec chmod 644 {} +
        plymouth-set-default-theme mainstream
        info "Mainstream Plymouth theme configured."
    else
        warn "Mainstream Plymouth theme not found in cloned dotfiles repo — falling back to BGRT."
        plymouth-set-default-theme bgrt
        info "Plymouth BGRT theme configured."
    fi

else
    warn "Plymouth failed to install — boot splash will be skipped."
fi

# Remove archiso-specific mkinitcpio config — it is only valid on the live ISO.
# If left in place, mkinitcpio -P will attempt to build with archiso hooks
# (archiso, archiso_loop_mnt, etc.) that do not exist on the installed system.
info "Removing archiso-specific mkinitcpio config..."
rm -f /etc/mkinitcpio.conf.d/archiso.conf


# ---------------------------------------------------------------------------
# 4c. GPU DETECTION & CONFIGURATION (shared library)
# Runs after archiso.conf is removed so mkinitcpio.conf changes are safe.
# Sources the single source of truth shared with the dots ./setup path
# (sdata/lib/gpu-config.sh, preserved at /tmp/dotfiles-setup). In this
# Calamares chroot we run as root (GPU_SUDO=''), drop the kms hook and apply
# the UKI-on-small-ESP early-KMS guard (skip early KMS when the reused ESP is
# under 512 MiB so the UKI still fits), and target the install user's home for
# the Hyprland tweaks. The initramfs is rebuilt later by the unconditional
# mkinitcpio -P below, so this only stages the config.
# ---------------------------------------------------------------------------
GPU_LIB="/tmp/dotfiles-setup/sdata/lib/gpu-config.sh"
if [[ -r "$GPU_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$GPU_LIB"
    GPU_SUDO=''
    GPU_EARLY_KMS_REMOVE_HOOK=true
    GPU_EARLY_KMS_ESP_THRESHOLD=512

    # Override the swap probe with the install-aware version: pick the swap
    # partition on the SAME DISK as root (multi-drive safe), resolving a
    # LUKS-on-root mapper back to its real GPT entry first. The library's
    # generic blkid probe cannot tell which disk is the install target.
    _gpu_swap_partuuid() {
        local root_dev root_disk
        root_dev=$(findmnt -n -o SOURCE / 2>/dev/null | sed 's/\[.*\]//')
        [[ -n "$root_dev" ]] || return 0
        if [[ "$root_dev" == /dev/mapper/* ]]; then
            root_dev=$(cryptsetup status "$(basename "$root_dev")" 2>/dev/null \
                | awk '/^[[:space:]]*device:/ {print $2; exit}')
            [[ -n "$root_dev" ]] || return 0
        fi
        root_disk=$(lsblk -no PKNAME "$root_dev" 2>/dev/null)
        [[ -n "$root_disk" ]] || return 0
        lsblk -nlpo NAME,FSTYPE,PARTUUID "/dev/$root_disk" 2>/dev/null \
            | awk '$2 == "swap" {print $3; exit}'
    }

    info "Detecting GPU hardware..."
    if gpu_detect; then
        info "Detected GPU(s):"
        lspci 2>/dev/null | grep -iE "VGA|3D|Display" | while read -r line; do info "  $line"; done || true
        info "GPU autoconfig — Intel=$HAS_INTEL AMD=$HAS_AMD NVIDIA=$HAS_NVIDIA Hybrid=$IS_HYBRID"
        gpu_apply_autoconfig
        if [[ -n "${MAIN_USER:-}" ]]; then
            gpu_apply_hypr_tweaks "$MAIN_USER_HOME"
        fi
        info "GPU configuration complete. Intel=$HAS_INTEL AMD=$HAS_AMD NVIDIA=$HAS_NVIDIA Hybrid=$IS_HYBRID"
    else
        warn "No GPU detected via lspci — skipping GPU configuration."
    fi
else
    warn "Shared GPU library not found at $GPU_LIB — skipping GPU configuration."
fi

# Restore a standard installed-system mkinitcpio preset. On UEFI installs,
# also emit UKIs that Limine can chainload from the ESP.
if [[ -d /boot/efi ]]; then
    mkdir -p /boot/efi/EFI/Linux
    # UEFI: build only the default UKI; no fallback entry means no fallback in menu
    cat > /etc/mkinitcpio.d/linux.preset << 'PRESET'
PRESETS=('default')
ALL_kver='/boot/vmlinuz-linux'
default_config='/etc/mkinitcpio.conf'
default_image='/boot/initramfs-linux.img'
default_uki='/boot/efi/EFI/Linux/mainstream_linux.efi'
PRESET
else
    cat > /etc/mkinitcpio.d/linux.preset << 'PRESET'
PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-linux'
default_config='/etc/mkinitcpio.conf'
default_image='/boot/initramfs-linux.img'
fallback_config='/etc/mkinitcpio.conf'
fallback_image='/boot/initramfs-linux-fallback.img'
fallback_options='-S autodetect'
PRESET
fi

# ---------------------------------------------------------------------------
# ENSURE VALID MACHINE-ID (required by limine-mkinitcpio-hook)
# ---------------------------------------------------------------------------
# mkarchiso sets /etc/machine-id to "uninitialized" (13 chars) for systemd
# first-boot semantics.  limine-mkinitcpio-hook requires a valid 32-char hex
# machine-id to place kernel/initramfs on the EFI partition.  Calamares'
# machineid module should have generated one, but verify and fix if needed.
if ! grep -qE '^[0-9a-f]{32}$' /etc/machine-id 2>/dev/null; then
    warn "Invalid or missing machine-id — generating one..."
    systemd-machine-id-setup 2>/dev/null || \
        printf '%s\n' "$(cat /proc/sys/kernel/random/uuid | tr -d '-')" > /etc/machine-id
    info "Machine-id set to: $(cat /etc/machine-id)"
fi

# Write Limine's config (branded TARGET_OS_NAME + FIND_BOOTLOADERS=no) BEFORE
# installing limine-mkinitcpio-hook below. The package's deploy hook fixes the
# OS entry's display name and fallback handling at creation time during that
# pacman transaction, so the config must already be in place — otherwise the
# entry is created unbranded ("Mainstream OS", not "Mainstream OS\\") and a
# stray "EFI fallback" entry gets added.
write_limine_defaults

# ---------------------------------------------------------------------------
# INSTALL SNAPPER + LIMINE AUR PACKAGES (before mkinitcpio -P)
# ---------------------------------------------------------------------------
# These can't be in packages.x86_64 (limine-mkinitcpio-hook breaks the
# archiso build chroot). snapper/snap-pac are in the official repos and the
# two limine packages are pre-built into the [mainstream] file repo
# (file:///usr/local/share/pkgs, on the target's pacman.conf), so pacman -S
# resolves all four — no AUR helper needed.
#
# IMPORTANT: limine-mkinitcpio-hook must be installed BEFORE mkinitcpio -P
# so the hook can manage kernel/initramfs placement on the EFI partition and
# generate proper //linux sub-entries in limine.conf.
info "Installing snapper and limine integration packages..."
# -Sy first so the [mainstream] file-repo db is in the sync dir even if an
# earlier step didn't refresh it. Fall back to the two official packages so
# a [mainstream] hiccup can't block the install outright.
pacman -Sy --noconfirm 2>/dev/null || true
pacman -S --noconfirm --needed snapper snap-pac limine-mkinitcpio-hook limine-snapper-sync 2>&1 \
    || pacman -S --noconfirm --needed snapper snap-pac 2>&1 \
    || true

# ---------------------------------------------------------------------------
# MKINITCPIO — build the target initramfs in-chroot for every GPU path
# ---------------------------------------------------------------------------
# Used to need a first-boot deferral here for the legacy NVIDIA DKMS
# generations (580xx / 470xx / 390xx): DKMS post-install runs `dkms install`
# without -k, picks up the chroot host's `uname -r` (which is the build
# machine's kernel, not the target's), fails to find that kernel's headers,
# and leaves /lib/modules/<target>/extra/ empty. Then mkinitcpio -P built
# an initramfs missing nvidia.ko, the user booted to a kernel panic, and
# we worked around it with a firstboot systemd unit that rebuilt the
# initramfs after DKMS had a real running kernel to compile against —
# followed by an auto-reboot prompt the user had to accept on first login.
#
# install-gpu-drivers now pre-builds the DKMS source packages into the
# airootfs (build.sh's AUR_DEPS section), pacman -U's them at chroot time,
# and calls `dkms install -k <target_kernel>` so modules land in
# /lib/modules/<target>/extra/ during the install. With modules present,
# mkinitcpio -P succeeds in chroot for every GPU generation — no deferral,
# no firstboot unit, no auto-reboot.

# Free the ESP before building the UKI: drop any stale standalone kernel +
# initramfs left on the ESP root (e.g. from an earlier failed attempt on a
# reused dual-boot ESP). UEFI boots the UKI, so these aren't needed, and on a
# small shared ESP they can fill it and make the UKI write fail.
if [[ -d /boot/efi ]]; then
    rm -f /boot/efi/vmlinuz-linux /boot/efi/initramfs-linux.img \
          /boot/efi/initramfs-linux-fallback.img 2>/dev/null || true
fi

info "Regenerating initramfs..."
if ! mkinitcpio -P; then
    warn "mkinitcpio -P returned non-zero (limine hook issue?) — checking if images were built..."
    if [ -f /boot/initramfs-linux.img ]; then
        info "Initramfs images exist — continuing despite hook warning."
    else
        warn "Initramfs images missing — mkinitcpio truly failed."
        exit 1
    fi
fi

if command -v limine-mkinitcpio &>/dev/null; then
    info "Updating Limine boot entries via limine-mkinitcpio..."
    limine-mkinitcpio 2>/dev/null || warn "limine-mkinitcpio returned non-zero (may be OK in chroot)."
fi

# limine-mkinitcpio-hook owns the OS entry (machine-id tracked, real UKI hash +
# cmdline). Two cleanups leave the menu as exactly that entry + Windows:
#   - prune the install-limine bootstrap "/Mainstream OS\\" entry (no "+",
#     protocol: linux) and any generic "/EFI fallback" entry. The hook entry
#     starts "/+", so "^/Mainstream"/"^/EFI fallback" match only the strays.
#   - force the branded name on the hook entry in case it was created before
#     write_limine_defaults set TARGET_OS_NAME (idempotent if already branded).
if [[ -f /boot/efi/limine.conf ]]; then
    awk '
        /^\/Mainstream OS/ { skip=1; next }
        /^\/EFI fallback/  { skip=1; next }
        /^\/[^\/]/         { if (skip) skip=0 }
        skip { next }
        { print }
    ' /boot/efi/limine.conf > /boot/efi/limine.conf.tmp \
        && mv /boot/efi/limine.conf.tmp /boot/efi/limine.conf
    sed -i -E 's,^/\+Mainstream OS\\*$,/+Mainstream OS\\\\,; s,^comment: Mainstream OS\\*$,comment: Mainstream OS\\\\,' \
        /boot/efi/limine.conf
    info "Pruned stray limine entries; hook 'Mainstream OS\\' entry branded."
fi

# Add a Windows boot entry when Windows shares this ESP (Install alongside).
# limine's FIND_BOOTLOADERS only probes systemd-boot/rEFInd/the generic
# EFI/BOOT fallback — never Microsoft's bootmgfw.efi — so a dual-boot Windows
# install is invisible in the menu unless we register it explicitly. The
# limine-entry-tool EFI entry persists across kernel updates like the others.
if [[ -f /boot/efi/EFI/Microsoft/Boot/bootmgfw.efi ]] && command -v limine-entry-tool &>/dev/null; then
    info "Windows detected on the ESP — adding a 'Windows' limine boot entry..."
    limine-entry-tool --add-efi "Windows" "/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi" \
        --comment "Windows Boot Manager" --priority 15 --quiet --no-mutex --no-hooks 2>&1 \
        || warn "Could not add the Windows boot entry."
fi

# Clean up plain kernel/initramfs from ESP root now that UKI is in place.
# These were copied by install-limine as a bootstrap fallback; the UKI
# supersedes them and limine-mkinitcpio will only generate entries for
# files it finds, so removing them prevents the stale non-UKI menu entry.
if [ -d "/boot/efi" ] && [ -f "/boot/efi/EFI/Linux/mainstream_linux.efi" ]; then
    rm -f /boot/efi/vmlinuz-linux /boot/efi/initramfs-linux.img || true
fi

# ---------------------------------------------------------------------------
# 5. SDDM THEME, WAYLAND CONFIG & BTRFS FIXES
# ---------------------------------------------------------------------------
info "Installing pixie SDDM theme..."

SDDM_THEME_DIR="/usr/share/sddm/themes/pixie"
if ping -c1 -W3 github.com &>/dev/null; then
    if git clone --depth=1 https://github.com/MainstreamOS/pixie-sddm.git "$SDDM_THEME_DIR"; then
        info "pixie SDDM theme installed successfully."
    else
        warn "Failed to clone pixie-sddm — SDDM will use default theme."
    fi
else
    warn "No network — skipping pixie SDDM theme install."
fi

info "Configuring SDDM-Hyprland and correcting fstab..."

# SDDM Wayland Handshake + pixie theme
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-wayland.conf <<SDDMEOF
[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Wayland]
CompositorCommand=start-hyprland

[Theme]
Current=pixie
SDDMEOF

# Remove any live ISO autologin configs. If the user enabled autologin on the
# Calamares users page, the displaymanager module writes that choice to
# /etc/sddm.conf before this script runs.
#
# We only remove drop-ins that explicitly target 'liveuser' to avoid
# clobbering a valid user-requested autologin if it was written to a drop-in.
find /etc -name "autologin.conf" -type f | while read -r f; do
    if grep -q "liveuser" "$f"; then
        rm -f "$f"
        info "Removed live ISO autologin config: $f"
    fi
done

# SDDM user home directory, Hyprland greeter config, and permissions
mkdir -p /var/lib/sddm/.config/hypr
cat > /var/lib/sddm/.config/hypr/hyprland.conf <<HYPREOF
monitor=,preferred,auto,1

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}

animations {
    enabled = false
}

windowrule = match:class ^(sddm-greeter-qt6)$, fullscreen on
HYPREOF
chown -R sddm:sddm /var/lib/sddm
chmod 700 /var/lib/sddm/.config
chmod 700 /var/lib/sddm/.config/hypr
chmod 600 /var/lib/sddm/.config/hypr/hyprland.conf

# Fix Btrfs subvolume naming mismatch (@ vs /@)
sed -i 's|subvol=/@|subvol=@|g' /etc/fstab || true

# ---------------------------------------------------------------------------
# 5b. SDDM BACKGROUND POLKIT SETUP
# ---------------------------------------------------------------------------
# Install the polkit helper + rules so wallpaper switches can update the
# SDDM login screen background without a password prompt
DOTFILES_REPO="/tmp/dotfiles-setup"
if [[ -d "$DOTFILES_REPO" ]]; then
    info "Installing SDDM background polkit helper..."

    HELPER_SRC="$DOTFILES_REPO/dots/.config/quickshell/ii/scripts/colors/sddm-bg-helper.sh"
    POLICY_SRC="$DOTFILES_REPO/sdata/polkit/org.illogicalimpulse.sddm-bg.policy"
    RULES_SRC="$DOTFILES_REPO/sdata/polkit/50-sddm-bg.rules"

    if [[ -f "$HELPER_SRC" ]]; then
        cp "$HELPER_SRC" /usr/local/bin/sddm-bg-helper
        chmod 755 /usr/local/bin/sddm-bg-helper
        info "sddm-bg-helper installed."
    else
        warn "sddm-bg-helper.sh not found in dotfiles repo — SDDM background updates may prompt for password."
    fi

    if [[ -f "$POLICY_SRC" ]]; then
        mkdir -p /usr/share/polkit-1/actions
        cp "$POLICY_SRC" /usr/share/polkit-1/actions/
        info "Polkit policy installed."
    fi

    if [[ -f "$RULES_SRC" ]]; then
        mkdir -p /usr/share/polkit-1/rules.d
        cp "$RULES_SRC" /usr/share/polkit-1/rules.d/
        info "Polkit rules installed."
    fi
else
    warn "/tmp/dotfiles-setup not found — skipping SDDM polkit setup."
fi

# ---------------------------------------------------------------------------
# 6. CLEANUP BUILDUSER
# ---------------------------------------------------------------------------
# Precision purge: Only remove builduser if it isn't our primary account
if id "builduser" &>/dev/null && [[ "$MAIN_USER" != "builduser" ]]; then
    info "Purging temporary build user..."
    userdel -rf builduser || true
fi

# Remove builduser sudoers immediately — builduser has been deleted above.
rm -f /etc/sudoers.d/builduser 2>/dev/null || true

# g_wheel grants %wheel passwordless sudo for the duration of the
# Calamares install. The netinstall packages module no longer needs it
# (it runs pacman directly as root in the chroot — the yay-as-user path
# that called sudo pacman internally is gone), but the cleanup still
# happens synchronously at the end of finalize-install, which Calamares
# runs after the packages module. See finalize-install for the cleanup
# block. Stale pacman lock can still appear if a previous step
# crashed; clear it defensively here.
rm -f /var/lib/pacman/db.lck 2>/dev/null || true

# Visual feedback ('*' per keystroke) at sudo prompts. Default sudo gives no
# echo at all, which catches new users out — they can't tell whether the
# keyboard is being read. Drop-in lives under sudoers.d so package upgrades
# to /etc/sudoers can never clobber it; validated with visudo -cf so a syntax
# error never lands on the installed system.
info "Installing /etc/sudoers.d/pwfeedback (visual feedback at sudo prompts)..."
{
    pwf_tmp=$(mktemp)
    printf 'Defaults pwfeedback\n' > "$pwf_tmp"
    if visudo -cf "$pwf_tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g root "$pwf_tmp" /etc/sudoers.d/pwfeedback
    else
        warn "pwfeedback drop-in failed visudo validation; not installing."
    fi
    rm -f "$pwf_tmp"
}

# ---------------------------------------------------------------------------
# 6b. PACMAN KEYRING INIT + [mainstream] REPO SWITCH (first boot)
# ---------------------------------------------------------------------------
# pacman-key --init often fails in a chroot (no gpg-agent, limited entropy).
# Try it here as a best-effort, but the real guarantee is the first-boot
# oneshot service created below — which also trusts the [mainstream] signing
# key and repoints the repo from the baked-in local file copy to the signed
# GitHub-hosted repo so the prebuilt packages update via pacman -Syu.
info "Initializing pacman keyring (best-effort in chroot)..."
pacman-key --init 2>/dev/null || true
pacman-key --populate archlinux 2>/dev/null || true

# Create a first-boot oneshot that (re-)initializes the keyring with proper
# entropy and a running gpg-agent (unlike the unreliable chroot attempt), then
# trusts the [mainstream] key and switches its repo to GitHub. Logic lives in
# /usr/local/bin/mainstream-keyring-init.
info "Scheduling pacman keyring init + [mainstream] repo switch for first boot..."
cat > /etc/systemd/system/pacman-keyring-init.service << 'KEYRINGEOF'
[Unit]
Description=Initialize pacman keyring and switch [mainstream] to the GitHub repo on first boot
# gpg signature validity needs a synced clock, so this Wants systemd-time-wait-
# sync — but it must NOT gate the boot. It is triggered by
# pacman-keyring-init.timer, NOT WantedBy=multi-user.target. A oneshot wanted by
# multi-user.target makes multi-user.target WAIT for it; because this unit blocks
# on the NTP round-trip (~40s on first boot) that froze multi-user.target to ~45s.
# That delayed power-profiles-daemon (After=multi-user.target, dbus-activated),
# which the quickshell bar synchronously activates at startup via UtilButtons'
# PowerProfiles binding — so the bar could not paint for ~21s. Off the critical
# path, multi-user.target reaches early, PPD activates immediately, and this
# keyring rebuild runs in the background after the desktop is already up.
# No ConditionPathExists gate: it must run on first boot even when the chroot's
# best-effort pacman-key --init succeeded, because it ALSO trusts the [mainstream]
# key and repoints the repo. Runs exactly once: ExecStartPost disables the timer.
After=network-online.target systemd-time-wait-sync.service
Wants=network-online.target systemd-time-wait-sync.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mainstream-keyring-init
ExecStartPost=-/usr/bin/systemctl disable pacman-keyring-init.timer pacman-keyring-init.service
KEYRINGEOF
cat > /etc/systemd/system/pacman-keyring-init.timer << 'KEYRINGTIMEREOF'
[Unit]
Description=Trigger the first-boot pacman keyring init off the boot-critical path

[Timer]
OnBootSec=20
AccuracySec=2s

[Install]
WantedBy=timers.target
KEYRINGTIMEREOF
systemctl enable pacman-keyring-init.timer 2>/dev/null || true
info "Pacman keyring init + [mainstream] repo switch scheduled (timer, off critical path)."

# ---------------------------------------------------------------------------
# 6c. ZRAM CONFIGURATION
# ---------------------------------------------------------------------------
# zram-generator needs a config file to create compressed swap in RAM
if command -v zram-generator &>/dev/null || pacman -Q zram-generator &>/dev/null 2>&1; then
    info "Configuring zram swap..."
    cat > /etc/systemd/zram-generator.conf << 'ZRAMEOF'
[zram0]
zram-size = min(ram, 8192)
compression-algorithm = zstd
ZRAMEOF
    info "zram configured."
fi

# ---------------------------------------------------------------------------
# 6d. SYSCTL PERFORMANCE TUNING
# ---------------------------------------------------------------------------
info "Applying sysctl performance tuning..."
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-performance.conf << 'SYSCTLEOF'
# Keep more data in RAM — less aggressive swapping to zram
vm.swappiness = 10

# Start flushing dirty pages earlier to avoid big write spikes
vm.dirty_background_ratio = 5
vm.dirty_ratio = 15

# Retain more dentries/inodes in cache — faster file lookups
vm.vfs_cache_pressure = 50

# Raise inotify watch limit for Quickshell file watchers
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512
SYSCTLEOF
info "sysctl tuning applied."

# ---------------------------------------------------------------------------
# 7. SERVICES, SHELL & FINAL PERMISSIONS
# ---------------------------------------------------------------------------
info "Enabling core services and finalizing user shell..."
systemctl set-default graphical.target
systemctl enable sddm.service -f

for svc in NetworkManager bluetooth; do
    systemctl enable "$svc" 2>/dev/null || true
done

# Auto-power-on Bluetooth so paired devices reconnect on boot.
if [[ -f /etc/bluetooth/main.conf ]]; then
    sed -i 's/^#\?AutoEnable\s*=.*/AutoEnable=true/' /etc/bluetooth/main.conf
    grep -q '^AutoEnable' /etc/bluetooth/main.conf || sed -i '/^\[Policy\]/a AutoEnable=true' /etc/bluetooth/main.conf
fi

if [[ -n "$MAIN_USER" ]]; then
    # Add to essential groups. i2c + the i2c-dev module are needed for ddcutil
    # external-monitor brightness (mainstream-backlight); input drives the
    # uinput virtual-input devices.
    groupadd -f render
    groupadd -f video
    groupadd -f i2c
    usermod -aG video,render,wheel,i2c,input "$MAIN_USER"
    # Load i2c-dev at boot so ddcutil can reach the monitor's DDC/CI bus.
    echo i2c-dev > /etc/modules-load.d/i2c-dev.conf

    # Change user shell to Zsh if installed
    if [ -f /usr/bin/zsh ]; then
        info "Setting default shell to Zsh for $MAIN_USER..."
        chsh -s /usr/bin/zsh "$MAIN_USER" || true
    fi

    # Remove quickshell first-run sentinel copied from skel so the installed
    # user sees the welcome message on their first login.
    rm -f "$MAIN_USER_HOME/.local/state/quickshell/user/first_run.txt"

    # Final ownership guarantee
    chown -R "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME"

    # Add hyprpolkitagent autostart if not already present in dotfiles
    EXECS_LUA="$MAIN_USER_HOME/.config/hypr/custom/execs.lua"
    if [[ -f "$EXECS_LUA" ]] && ! grep -q "hyprpolkitagent" "$EXECS_LUA"; then
        info "Adding hyprpolkitagent to Hyprland autostart..."
        echo 'hl.on("hyprland.start", function() hl.exec_cmd("hyprpolkitagent") end)' >> "$EXECS_LUA"
    elif [[ ! -f "$EXECS_LUA" ]]; then
        warn "Could not find $EXECS_LUA — hyprpolkitagent will not autostart."
    fi

    # ---------------------------------------------------------------------------
    # Deploy dotfiles-first-login using Hyprland + user systemd.
    # XDG autostart depends on a session helper being present and running; the
    # one thing we know the installed desktop will parse is Hyprland's exec-once.
    # Hyprland starts the user service so the setup has journal visibility, and
    # falls back to the script directly if the user systemd manager is not ready.
    # ---------------------------------------------------------------------------
    if [[ -f /usr/local/bin/dotfiles-first-login ]]; then
        info "Deploying dotfiles-first-login first-session triggers..."
        SYSTEMD_USER_DIR="$MAIN_USER_HOME/.config/systemd/user"
        mkdir -p "$SYSTEMD_USER_DIR"
        cat > "$SYSTEMD_USER_DIR/dotfiles-first-login.service" << 'SERVICEEOF'
[Unit]
Description=Dotfiles first graphical login setup
Documentation=man:systemd.service(5)
ConditionPathExists=%h/.dotfiles-pending-user-setup
After=graphical-session.target

[Service]
Type=oneshot
KillMode=process
Environment=DOTFILES_FIRST_LOGIN_FOREGROUND=1
ExecStart=/usr/local/bin/dotfiles-first-login
SERVICEEOF
        chown -R "$MAIN_USER:$MAIN_USER" "$SYSTEMD_USER_DIR"

        EXECS_LUA="$MAIN_USER_HOME/.config/hypr/custom/execs.lua"
        mkdir -p "$(dirname "$EXECS_LUA")"
        touch "$EXECS_LUA"
        sed -i \
            -e '\|dotfiles-first-login.service|d' \
            -e '\|/usr/local/bin/dotfiles-first-login|d' \
            "$EXECS_LUA" 2>/dev/null || true
        cat >> "$EXECS_LUA" << 'EXECSEOF'
hl.on("hyprland.start", function() hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user start dotfiles-first-login.service || /usr/local/bin/dotfiles-first-login") end)
EXECSEOF
        chown "$MAIN_USER:$MAIN_USER" "$EXECS_LUA"

        # Keep an XDG autostart entry as a harmless backup for sessions that do
        # run an autostart helper.
        AUTOSTART_DIR="$MAIN_USER_HOME/.config/autostart"
        mkdir -p "$AUTOSTART_DIR"
        cat > "$AUTOSTART_DIR/dotfiles-first-login.desktop" << 'AUTOSTARTEOF'
[Desktop Entry]
Type=Application
Name=Dotfiles First-Login Setup
Exec=sh -c 'dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user start dotfiles-first-login.service || /usr/local/bin/dotfiles-first-login'
X-GNOME-Autostart-enabled=true
NoDisplay=true
AUTOSTARTEOF
        chown -R "$MAIN_USER:$MAIN_USER" "$AUTOSTART_DIR"
    else
        warn "dotfiles-first-login not found in /usr/local/bin — skipping first-session trigger deploy."
    fi

    # ---------------------------------------------------------------------------
    # Fix Nautilus home directory and set as default file manager
    # ---------------------------------------------------------------------------
    info "Configuring Nautilus as default file manager..."

    # Generate XDG user directories (creates ~/Downloads, ~/Documents etc.)
    # Run as the real user so paths resolve correctly
    su -s /bin/bash "$MAIN_USER" -c "xdg-user-dirs-update --force" || true

    # Set Nautilus as default file manager
    su -s /bin/bash "$MAIN_USER" -c "xdg-mime default org.gnome.Nautilus.desktop inode/directory" || true

    # Set Loupe as default image viewer for all common image types
    IMAGE_TYPES=(
        image/png image/jpeg image/gif image/bmp image/webp image/tiff
        image/svg+xml image/svg+xml-compressed image/x-icon image/vnd.microsoft.icon
        image/avif image/heif image/heic image/jxl
    )
    for mime in "${IMAGE_TYPES[@]}"; do
        su -s /bin/bash "$MAIN_USER" -c "xdg-mime default org.gnome.Loupe.desktop $mime" || true
    done
    info "Loupe set as default image viewer."

    # Compile dconf system database so dark mode is default before first login
    dconf update 2>/dev/null || true

    # Set gsettings defaults — dark mode + Nautilus preferences
    su -s /bin/bash "$MAIN_USER" -c "
        export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u '$MAIN_USER')/bus
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface font-name 'Google Sans Flex Medium 11 @opsz=11,wght=500' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface document-font-name 'Readex Pro 11' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono NF 11' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Classic' 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-size 24 2>/dev/null || true
        gsettings set org.gnome.nautilus.preferences default-folder-viewer 'icon-view' 2>/dev/null || true
        gsettings set org.gnome.nautilus.preferences show-hidden-files false 2>/dev/null || true
    " || true

    # ---------------------------------------------------------------------------
    # Use pre-baked Python venv from skel, or create one if missing
    # ---------------------------------------------------------------------------
    VENV_PATH="$MAIN_USER_HOME/.local/state/quickshell/.venv"

    # Operational milestones go to the calamares install log via info().
    setup_log() { info "[setup] $*"; }
    setup_log "=== venv/theme setup start; VENV_PATH=$VENV_PATH; venv interpreter=$(/usr/bin/python3.12 -V 2>&1) ==="

    if [[ -e "$VENV_PATH/bin/python" || -L "$VENV_PATH/bin/python" ]]; then
        # Verify the baked venv matches the python312 package on the target
        # (/usr/bin/python3.12). build.sh stamps .python-version=3.12. If the
        # package is missing or the stamp mismatches, discard the venv so the
        # scratch-build path below runs against the correct interpreter.
        _target_py="/usr/bin/python3.12"
        _target_ver=$("$_target_py" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || true)
        _baked_ver=$(cat "$VENV_PATH/.python-version" 2>/dev/null || true)
        setup_log "pre-baked venv present; baked python=${_baked_ver:-<none>}, $_target_py=${_target_ver:-<missing>}"

        _abi_ok=false
        if [[ ! -x "$_target_py" ]]; then
            warn "python312 ($_target_py) missing on target — discarding pre-baked venv."
            rm -rf "$VENV_PATH"
            setup_log "pre-baked venv DISCARDED ($_target_py missing) — will scratch-build or defer"
        elif [[ -z "$_baked_ver" || "$_baked_ver" == "$_target_ver" ]]; then
            _abi_ok=true
        else
            warn "Venv ABI mismatch (baked=$_baked_ver, $_target_py=$_target_ver) — discarding pre-baked venv."
            rm -rf "$VENV_PATH"
            setup_log "pre-baked venv DISCARDED (ABI mismatch baked=$_baked_ver vs $_target_py=$_target_ver) — will scratch-build or defer"
        fi

        if [[ "$_abi_ok" == true ]]; then
            # Venv was pre-baked into skel by build.sh --refresh — fix paths only
            info "Pre-baked Python venv found — fixing paths for $MAIN_USER..."

            # Rewrite all SKEL_USER placeholder paths (bin/ scripts + activate)
            find "$VENV_PATH/bin" -type f -exec \
                sed -i -E "s|/[^\"'[:space:]]*\\.local/state/quickshell/\\.venv|$VENV_PATH|g" {} + 2>/dev/null || true
            find "$VENV_PATH/bin" -maxdepth 1 -type f -exec chmod 755 {} + 2>/dev/null || true

            # Fix pyvenv.cfg — home/python already point at /usr/bin/python3.12
            # (a fixed package path build.sh set, which this .venv-path regex
            # leaves alone); this only rewrites a leftover venv-dir placeholder.
            sed -i -E "s|/[^\"'[:space:]]*\\.local/state/quickshell/\\.venv|$VENV_PATH|g" \
                "$VENV_PATH/pyvenv.cfg" 2>/dev/null || true

            chown -R "$MAIN_USER:$MAIN_USER" "$VENV_PATH"
            info "Python venv ready (pre-baked)."
            setup_log "pre-baked venv KEPT and path-fixed."
        fi
        # If _abi_ok=false, VENV_PATH was rm -rf'd above; fall through to scratch build.
    fi

    if [[ ! -e "$VENV_PATH/bin/python" && ! -L "$VENV_PATH/bin/python" ]]; then
        # Fallback: create venv from scratch (slower, ~2-5 min)
        REQUIREMENTS="/tmp/dotfiles-setup/sdata/uv/requirements.txt"
        if [[ ! -f "$REQUIREMENTS" ]]; then
            REQUIREMENTS="$MAIN_USER_HOME/.local/share/quickshell/sdata/uv/requirements.txt"
        fi

        # Resolve uv to an absolute path. It is a system binary (/usr/bin/uv),
        # but be defensive about the user's ~/.local/bin and pass the absolute
        # path into the su helper so the scratch build never depends on the
        # (non-login) shell's PATH.
        UV_BIN="$(command -v uv 2>/dev/null || true)"
        [[ -z "$UV_BIN" && -x /usr/bin/uv ]] && UV_BIN="/usr/bin/uv"
        [[ -z "$UV_BIN" && -x "$MAIN_USER_HOME/.local/bin/uv" ]] && UV_BIN="$MAIN_USER_HOME/.local/bin/uv"

        if [[ -n "$UV_BIN" ]] && [[ -f "$REQUIREMENTS" ]]; then
            info "No pre-baked venv — creating Python venv at $VENV_PATH (uv: $UV_BIN)..."
            mkdir -p "$MAIN_USER_HOME/.local/state/quickshell"
            chown "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME/.local/state/quickshell"

            # Use the python312 package's /usr/bin/python3.12 (shipped on the
            # target) so numpy/pillow install as self-contained cp312 wheels — no
            # source build, no system liblapack/libimagequant, no interpreter
            # download. Reached only if the prebake was absent or discarded.
            VENV_HELPER="/tmp/create-venv-$MAIN_USER.sh"
            cat > "$VENV_HELPER" << VENVEOF
#!/usr/bin/env bash
"$UV_BIN" venv --prompt .venv -p /usr/bin/python3.12 "$VENV_PATH"
"$UV_BIN" pip install --python "$VENV_PATH/bin/python" -r "$REQUIREMENTS"
VENVEOF
            chmod 755 "$VENV_HELPER"
            chown "$MAIN_USER:$MAIN_USER" "$VENV_HELPER"

            setup_log "scratch venv build START (uv=$UV_BIN, requirements=$REQUIREMENTS)"
            su -s /bin/bash "$MAIN_USER" -c "bash $VENV_HELPER" 2>&1
            if [[ ${PIPESTATUS[0]} -eq 0 ]]; then
                find "$VENV_PATH/bin" -maxdepth 1 -type f -exec chmod 755 {} + 2>/dev/null || true
                chown -R "$MAIN_USER:$MAIN_USER" "$VENV_PATH" 2>/dev/null || true
                info "Python venv created successfully."
                setup_log "scratch venv build SUCCEEDED"
            else
                warn "venv creation failed — will retry on first login"
                setup_log "scratch venv build FAILED — deferring to first login"
            fi
            rm -f "$VENV_HELPER"
        else
            warn "venv scratch-build skipped — uv=${UV_BIN:-<not found>}, requirements=$REQUIREMENTS (exists: $([[ -f "$REQUIREMENTS" ]] && echo yes || echo no)); venv will be created on first login"
            setup_log "scratch venv build SKIPPED (uv=${UV_BIN:-<none>}, requirements exists=$([[ -f "$REQUIREMENTS" ]] && echo yes || echo no)) — deferring to first login"
        fi
    fi

    # Rebuild font cache as the target user so custom fonts are found
    info "Rebuilding font cache for $MAIN_USER..."
    su -s /bin/bash "$MAIN_USER" -c "fc-cache -fv" 2>/dev/null || true

    # Generate initial matugen color scheme from default wallpaper
    # This ensures theming works correctly on first login without requiring
    # the user to manually set a wallpaper
    DEFAULT_WALL="$MAIN_USER_HOME/.config/quickshell/ii/assets/images/default_wallpaper.png"
    SWITCHWALL="$MAIN_USER_HOME/.config/quickshell/ii/scripts/colors/switchwall.sh"
    VENV_PATH="$MAIN_USER_HOME/.local/state/quickshell/.venv"

    if [[ -f "$DEFAULT_WALL" ]] && command -v matugen &>/dev/null; then
        info "Generating initial Material You colors from default wallpaper..."
        mkdir -p "$MAIN_USER_HOME/.local/state/quickshell/user/generated/wallpaper"
        chown -R "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME/.local/state"

        # Run full switchwall pipeline if venv is ready — generates all color files
        # including material_colors.scss and terminal/kitty-theme.conf
        if [[ -f "$VENV_PATH/bin/activate" ]] && [[ -f "$SWITCHWALL" ]]; then
            info "Running full color pipeline via switchwall.sh..."
            setup_log "running full color pipeline (switchwall, venv ready)"
            SW_HELPER="/tmp/switchwall-$MAIN_USER.sh"
            cat > "$SW_HELPER" << SWEOF
#!/usr/bin/env bash
export ILLOGICAL_IMPULSE_VIRTUAL_ENV="$VENV_PATH"
# Redirect stdin from /dev/null to avoid stty/ioctl errors
bash "$SWITCHWALL" --image "$DEFAULT_WALL" --mode dark </dev/null
SWEOF
            chmod 755 "$SW_HELPER"
            chown "$MAIN_USER:$MAIN_USER" "$SW_HELPER"
            su -s /bin/bash "$MAIN_USER" -c "bash $SW_HELPER" 2>&1 ||                 warn "switchwall failed — falling back to matugen only"
            rm -f "$SW_HELPER"
        else
            # Fallback: just run matugen for the basic color templates (neutral)
            su -s /bin/bash "$MAIN_USER" -c "matugen image $DEFAULT_WALL" --mode dark --prefer less-saturation --type scheme-neutral 2>/dev/null || true
            warn "Venv not ready — terminal colors will be set on first login"
        fi
        info "Initial color scheme generated."
        setup_log "initial color scheme generated."
    else
        warn "Default wallpaper or matugen not found — skipping initial color generation."
    fi

    # Create the marker file so the first-login script knows to run
    touch "$MAIN_USER_HOME/.dotfiles-pending-user-setup"
    chown "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME/.dotfiles-pending-user-setup"
    info "Created first-login marker for $MAIN_USER."

    # Preserve the cloned dotfiles repo so first-login script can find it
    if [[ -d /tmp/dotfiles-setup ]]; then
        info "Preserving dotfiles repo to $MAIN_USER_HOME/dots-hyprland..."
        cp -a /tmp/dotfiles-setup "$MAIN_USER_HOME/dots-hyprland"
        chown -R "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME/dots-hyprland"
    else
        warn "/tmp/dotfiles-setup not found — first-login uv venv setup may be skipped."
    fi
fi
# ---------------------------------------------------------------------------
# KILL-FPRINTD SERVICE
# ---------------------------------------------------------------------------
# Kills fprintd before sleep to prevent fingerprint reader issues
info "Creating kill-fprintd service..."
cat > /etc/systemd/system/kill-fprintd.service << 'FPRINTEOF'
[Unit]
Description=Kill fprintd before sleep
Before=sleep.target

[Service]
ExecStart=killall fprintd

[Install]
WantedBy=sleep.target
FPRINTEOF
systemctl enable kill-fprintd.service 2>/dev/null || true

# ---------------------------------------------------------------------------
# SNAPPER + LIMINE-SNAPPER-SYNC SETUP
# ---------------------------------------------------------------------------
# Detect btrfs — findmnt may not work inside a Calamares chroot because
# /proc/self/mountinfo reflects the host, not the chrooted root.  Fall back
# to checking /etc/fstab (written by Calamares before post-install runs) or
# testing with the btrfs tool directly.
_root_is_btrfs=false
if findmnt -n -o FSTYPE / 2>/dev/null | grep -q btrfs; then
    _root_is_btrfs=true
elif grep -qE '^\s*[^#]\S+\s+/\s+btrfs\s' /etc/fstab 2>/dev/null; then
    _root_is_btrfs=true
elif btrfs filesystem usage / &>/dev/null; then
    _root_is_btrfs=true
fi

if ! $_root_is_btrfs; then
    warn "Root filesystem is NOT btrfs — skipping snapper configuration."
fi

if $_root_is_btrfs; then
    info "Btrfs detected on / — preparing snapper for firstboot setup..."

    # IMPORTANT: We do NOT create /.snapshots, write config files, or call
    # any snapper commands in this chroot.  snapper create-config sets up
    # internal btrfs metadata that manual file writes cannot replicate,
    # causing "Snapshot.cc reading failed" errors.  All snapper setup is
    # deferred to snapper-firstboot which runs on the real booted system.

    # Remove any /.snapshots that Calamares may have created as a plain
    # directory — snapper create-config needs it to NOT exist.
    if [[ -d "/.snapshots" ]] && ! btrfs subvolume show /.snapshots &>/dev/null; then
        info "Removing plain /.snapshots directory (snapper will recreate it)..."
        rm -rf /.snapshots 2>/dev/null || true
    elif btrfs subvolume show /.snapshots &>/dev/null; then
        info "Removing pre-existing /.snapshots subvolume (snapper will recreate it)..."
        btrfs subvolume delete /.snapshots 2>/dev/null || true
    fi

    # Deploy limine-snapper-sync config
    if command -v limine-snapper-sync &>/dev/null; then
        info "Configuring limine-snapper-sync..."
        cat > /etc/limine-snapper-sync.conf << 'LSSCONF'
LIMIT_USAGE_PERCENT=85
MAX_SNAPSHOT_ENTRIES=8
ROOT_SUBVOLUME_PATH="/@"
ROOT_SNAPSHOTS_PATH="/@/.snapshots"
RESTORE_METHOD=replace
SET_SNAPSHOT_AS_DEFAULT=no
SNAPSHOT_FORMAT_CHOICE=2
COMMANDS_BEFORE_SAVE="limine-reset-enroll"
COMMANDS_AFTER_SAVE="limine-enroll-config"
NOTIFICATION_ICON="/usr/share/icons/hicolor/128x128/apps/LimineSnapperSync.png"
LSSCONF

        # Tell limine-snapper-sync which snapper config to use, so it never
        # tries to auto-create one via "snapper create-config" (which deletes
        # existing configs as a side effect).
        write_limine_defaults
        info "limine-snapper-sync config deployed."
    else
        warn "limine-snapper-sync not found — skipping Limine snapshot integration."
    fi

    # NOTE: snapper timers and limine-snapper-sync are NOT enabled here.
    # They are enabled by snapper-firstboot on first boot AFTER configs are
    # fully set up.  Enabling them here causes a race condition where
    # snapperd starts via D-Bus activation before configs exist, deleting them.

    # --- Firstboot service ---
    # All snapper setup happens on first boot where D-Bus, btrfs, and the
    # real filesystem are fully available.  snapper create-config sets up
    # internal btrfs metadata that manual config file writes cannot replicate.
    cat > /etc/systemd/system/snapper-init.service << 'SNAPPERUNITEOF'
[Unit]
Description=Initialize snapper configs and create first snapshot
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/snapper-firstboot

[Install]
WantedBy=multi-user.target
SNAPPERUNITEOF

    cat > /usr/local/bin/snapper-firstboot << 'FIRSTBOOTEOF'
#!/usr/bin/env bash
set -euo pipefail
log() { echo "[snapper-firstboot] $*"; }

# --- Root config via snapper create-config ---
if snapper list-configs 2>/dev/null | grep -q "^root"; then
    log "Root config already exists."
elif [[ -f /etc/snapper/configs/root ]]; then
    # Config file exists but snapper doesn't recognize it (stale manual config).
    # Remove it so create-config can start fresh.
    log "Removing stale root config..."
    rm -f /etc/snapper/configs/root
    if btrfs subvolume show /.snapshots &>/dev/null; then
        btrfs subvolume delete /.snapshots 2>/dev/null || true
    fi
    rm -rf /.snapshots 2>/dev/null || true
    log "Creating root config via snapper create-config..."
    snapper create-config / || log "WARN: snapper create-config / failed."
else
    # Clean slate — let snapper create everything
    if btrfs subvolume show /.snapshots &>/dev/null; then
        btrfs subvolume delete /.snapshots 2>/dev/null || true
    fi
    rm -rf /.snapshots 2>/dev/null || true
    log "Creating root config via snapper create-config..."
    snapper create-config / || log "WARN: snapper create-config / failed."
fi

# Customize root config
if [[ -f /etc/snapper/configs/root ]]; then
    sed -i 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="yes"/' /etc/snapper/configs/root
    sed -i 's/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="5"/' /etc/snapper/configs/root
    sed -i 's/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="7"/' /etc/snapper/configs/root
    # Set ALLOW_USERS to the first non-system user
    _user=$(getent passwd | awk -F: '$3 >= 1000 && $3 <= 1100 {print $1}' | grep -vE '(nobody)' | head -n1 || true)
    if [[ -n "$_user" ]]; then
        sed -i "s/^ALLOW_USERS=.*/ALLOW_USERS=\"$_user\"/" /etc/snapper/configs/root
    fi
    log "Root config customized."
fi

# --- Initial snapshot ---
if snapper -c root list 2>/dev/null | grep -q "Fresh install"; then
    log "Fresh install snapshot already exists."
else
    log "Creating initial 'Fresh install' snapshot..."
    snapper -c root create --description "Fresh install" 2>/dev/null || \
        log "WARN: Could not create initial snapshot."
fi

# --- Enable snapper timers NOW that configs are set up ---
log "Enabling snapper timers and limine-snapper-sync..."
systemctl enable --now snapper-timeline.timer 2>/dev/null || true
systemctl enable --now snapper-cleanup.timer 2>/dev/null || true
systemctl enable limine-snapper-sync.service 2>/dev/null || true

# Disable ourselves — one-shot job done
systemctl disable snapper-init.service 2>/dev/null || true
log "Firstboot snapper init complete."
FIRSTBOOTEOF
    chmod +x /usr/local/bin/snapper-firstboot
    systemctl enable snapper-init.service 2>/dev/null || true

    info "Snapper setup complete."
else
    info "Root filesystem is not btrfs — skipping snapper setup."
fi

# ---------------------------------------------------------------------------
# NAUTILUS BOOKMARKS
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_USER" && -n "$MAIN_USER_HOME" ]]; then
    info "Writing Nautilus bookmarks for $MAIN_USER..."
    mkdir -p "$MAIN_USER_HOME/.config/gtk-3.0"
    cat > "$MAIN_USER_HOME/.config/gtk-3.0/bookmarks" << EOF
file://$MAIN_USER_HOME/Desktop Desktop
file://$MAIN_USER_HOME/Downloads Downloads
file://$MAIN_USER_HOME/Documents Documents
file://$MAIN_USER_HOME/Music Music
file://$MAIN_USER_HOME/Pictures Pictures
file://$MAIN_USER_HOME/Videos Videos
EOF
    chown "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME/.config/gtk-3.0/bookmarks"
    info "Nautilus bookmarks written."
fi

# ---------------------------------------------------------------------------
# Note: $HOME/dots-hyprland is intentionally left in place here.
# dotfiles-first-login needs sdata/uv/requirements.txt to (re)build the python
# venv on first session, and self-removes the repo after success.
# ---------------------------------------------------------------------------



# ---------------------------------------------------------------------------
# GPG KEYBOX CLEANUP
# Clear any stale lock files left by GPG operations during the chroot install.
# A ghost lock on pubring.kbx/keyboxd causes AUR key imports to fail on first
# post-install update. Safe to run unconditionally — no keys are deleted.
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_USER" ]]; then
    info "Clearing stale GPG locks for $MAIN_USER..."
    find "$MAIN_USER_HOME/.gnupg" -name "*.lock" -delete 2>/dev/null || true
    runuser -l "$MAIN_USER" -c 'gpgconf --kill all' 2>/dev/null || true
    info "GPG lock cleanup complete."
fi

# ---------------------------------------------------------------------------
# Gaming Mode (Super+G) is delivered by the mainstream-gaming package (listed in
# packages.x86_64): the gaming-mode helpers, /usr/lib/os-session-select, the
# scoped sudoers rule, and the gamescope Steam session as a dependency. Steam
# itself installs on first use. No firstboot service or extra privileges here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# HYPRLAND PLUGINS — build hyprbars from source at install time (chroot)
#
# hyprpm requires HYPRLAND_INSTANCE_SIGNATURE (a live session) and cannot run
# in chroot. Instead, we mirror setup_hyprland_plugins() from 3_files.sh:
#   1. Remove any artifacts from a previous hyprpm-based approach.
#   2. Check that the required pkg-config deps are present in the chroot.
#   3. Clone MainstreamOS/hyprland-plugins and compile hyprbars with `make`.
#   4. Install hyprbars.so to $MAIN_USER_HOME/.local/share/hyprland/plugins/.
#   5. Prepend a *commented-out* `hl.plugin.load(...)` directive to
#      custom/general.lua so the user can enable Title Bars via the settings
#      toggle without any manual path lookup.
#   6. Fix ownership — everything under $MAIN_USER_HOME must belong to the user.
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_USER" ]]; then
    info "Building hyprbars plugin from source for $MAIN_USER..."

    _PLUGIN_DATA_DIR="$MAIN_USER_HOME/.local/share/hyprland/plugins"
    _PLUGIN_PATH="$_PLUGIN_DATA_DIR/hyprbars.so"
    _GENERAL_LUA="$MAIN_USER_HOME/.config/hypr/custom/general.lua"
    _BUILD_LOG="$_PLUGIN_DATA_DIR/hyprbars-build.log"
    _SRC_DIR="$(mktemp -d /tmp/hyprland-plugins-build.XXXXXX)"

    # --- 1. Remove artifacts from earlier hyprpm-based approaches ---
    # These may not exist on a fresh install, but are removed unconditionally
    # so a reinstall always starts from a clean slate (mirrors 3_files.sh).
    rm -f /usr/local/bin/hyprland-plugins-setup
    rm -f /etc/sudoers.d/hyprpm
    # Also clean the exec-once trigger from execs.lua if it slipped through.
    _EXECS_LUA="$MAIN_USER_HOME/.config/hypr/custom/execs.lua"
    if [[ -f "$_EXECS_LUA" ]] && grep -q 'hyprland-plugins-setup' "$_EXECS_LUA"; then
        sed -i '/-- Defer hyprpm to first login/d; /hyprland-plugins-setup/d' "$_EXECS_LUA"
        info "Removed stale hyprland-plugins-setup hl.on entry from execs.lua."
    fi

    # Strip live-only exec-once triggers that must not run on the installed
    # system: calamares-autostart launches the (now-removed) installer, and
    # live-setup is a live-ISO no-op. Keep dotfiles-first-login. Clean both the
    # installed user's execs.lua and /etc/skel (for users created later).
    for _el in "$_EXECS_LUA" /etc/skel/.config/hypr/custom/execs.lua; do
        [[ -f "$_el" ]] && sed -i '/calamares-autostart/d; /local\/bin\/live-setup/d' "$_el"
    done
    info "Removed live-only exec-once entries (calamares-autostart, live-setup) from execs.lua."

    # --- 2. Check build-time pkg-config deps ---
    # hyprbars' Makefile requires each of these. `hyprland` ships its own
    # hyprland.pc together with the development headers on Arch.
    _missing_deps=()
    for _pc in hyprland pixman-1 libdrm pangocairo libinput libudev wayland-server xkbcommon; do
        pkg-config --exists "$_pc" 2>/dev/null || _missing_deps+=("$_pc")
    done
    if (( ${#_missing_deps[@]} > 0 )); then
        warn "Missing pkg-config deps for hyprbars: ${_missing_deps[*]}"
        warn "Install the corresponding -devel packages and re-run the installer."
        warn "Skipping hyprbars build — plugin will not be available on first boot."
        rm -rf "$_SRC_DIR"
    else
        # --- 3. Clone and build ---
        mkdir -p "$_PLUGIN_DATA_DIR"
        mkdir -p "$(dirname "$_BUILD_LOG")"

        {
            echo "=== hyprbars build @ $(date '+%Y-%m-%d %H:%M:%S') ==="
            echo "Build host: $(uname -r)"
            echo "---"
        } > "$_BUILD_LOG"

        info "Cloning MainstreamOS/hyprland-plugins (mainstream) into $_SRC_DIR..."
        if ! git -C "$_SRC_DIR" clone --depth=1 --branch mainstream https://github.com/MainstreamOS/hyprland-plugins . \
                >> "$_BUILD_LOG" 2>&1; then
            warn "git clone failed — check network and retry. Build log: $_BUILD_LOG"
            rm -rf "$_SRC_DIR"
        else
            echo "Plugin commit: $(git -C "$_SRC_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)" \
                >> "$_BUILD_LOG"

            info "Compiling hyprbars ($(nproc) jobs)..."
            if ! make -C "$_SRC_DIR/hyprbars" all -j"$(nproc)" >> "$_BUILD_LOG" 2>&1; then
                warn "hyprbars make failed — build log: $_BUILD_LOG"
                rm -rf "$_SRC_DIR"
            else
                # --- 4. Install the .so ---
                cp -f "$_SRC_DIR/hyprbars/hyprbars.so" "$_PLUGIN_PATH"
                info "Installed hyprbars.so to $_PLUGIN_PATH"
                rm -rf "$_SRC_DIR"

                # --- 5. Prepend commented-out plugin directive to general.lua ---
                # Hyprland requires the .so to be loaded *before* its settings block
                # is parsed, so the directive goes at the top of the file.
                # It is left commented out — the Title Bars toggle enables it.
                if [[ -f "$_GENERAL_LUA" ]]; then
                    if ! grep -qE 'hl\.plugin\.load.*hyprbars\.so' "$_GENERAL_LUA"; then
                        _tmp=$(mktemp)
                        {
                            echo "-- hyprbars plugin — built from source at install time"
                            echo "-- TitleBars.qml toggles the comment prefix on this exact line."
                            echo "-- hl.plugin.load(\"${_PLUGIN_PATH}\")"
                            echo ""
                            cat "$_GENERAL_LUA"
                        } > "$_tmp"
                        mv "$_tmp" "$_GENERAL_LUA"
                        info "Prepended commented hl.plugin.load(\"${_PLUGIN_PATH}\") to $_GENERAL_LUA (enable via Title Bars toggle)."
                    else
                        info "$_GENERAL_LUA already references hyprbars — skipping directive."
                    fi
                else
                    warn "$_GENERAL_LUA not found — add this line manually to a sourced hypr config:"
                    warn "  hl.plugin.load(\"${_PLUGIN_PATH}\")"
                fi
            fi
        fi

        # --- 6. Fix ownership ---
        # Everything written under $MAIN_USER_HOME must belong to the user,
        # not root (we are running in chroot as root).
        chown -R "$MAIN_USER:$MAIN_USER" "$_PLUGIN_DATA_DIR" 2>/dev/null || true
        [[ -f "$_GENERAL_LUA" ]] && \
            chown "$MAIN_USER:$MAIN_USER" "$_GENERAL_LUA" 2>/dev/null || true
        info "Ownership of plugin directory set to $MAIN_USER."
    fi
fi


# ---------------------------------------------------------------------------
# HYPRLAND PLUGINS — build scrolloverview from source at install time (chroot)
#
# Same shape as the hyprbars block above: clone the MainstreamOS fork, build
# scrolloverview.so with `make all`, drop it under
# $MAIN_USER_HOME/.local/share/hyprland/plugins/, and prepend a `plugin = ...`
# directive to the user's custom/general.lua. Difference vs hyprbars: this
# directive is left UNCOMMENTED — the bar's top-left hot corner dispatches
# `scrolloverview:overview on`, so the plugin needs to be loaded by default
# for that interaction to work. There is no equivalent "Title Bars" toggle.
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_USER" ]]; then
    info "Building hyprland-scroll-overview plugin from source for $MAIN_USER..."

    _PLUGIN_DATA_DIR="$MAIN_USER_HOME/.local/share/hyprland/plugins"
    _PLUGIN_PATH="$_PLUGIN_DATA_DIR/scrolloverview.so"
    _GENERAL_LUA="$MAIN_USER_HOME/.config/hypr/custom/general.lua"
    _BUILD_LOG="$_PLUGIN_DATA_DIR/scrolloverview-build.log"
    _SRC_DIR="$(mktemp -d /tmp/hyprland-scroll-overview-build.XXXXXX)"

    # --- 1. Check build-time pkg-config deps ---
    # Same set as hyprbars (the plugin uses the same Hyprland headers +
    # pixman/pango/libdrm). The cairo include used by the wallpaper loader
    # comes in via pangocairo. gdk-pixbuf is needed for the wallpaper_path
    # config to load any image format other than PNG.
    _missing_deps=()
    for _pc in hyprland pixman-1 libdrm pangocairo libinput libudev wayland-server xkbcommon gdk-pixbuf-2.0; do
        pkg-config --exists "$_pc" 2>/dev/null || _missing_deps+=("$_pc")
    done
    if (( ${#_missing_deps[@]} > 0 )); then
        warn "Missing pkg-config deps for scrolloverview: ${_missing_deps[*]}"
        warn "Install the corresponding -devel packages and re-run the installer."
        warn "Skipping scrolloverview build — plugin will not be available on first boot."
        rm -rf "$_SRC_DIR"
    else
        # --- 2. Clone and build ---
        mkdir -p "$_PLUGIN_DATA_DIR"
        mkdir -p "$(dirname "$_BUILD_LOG")"

        {
            echo "=== scrolloverview build @ $(date '+%Y-%m-%d %H:%M:%S') ==="
            echo "Build host: $(uname -r)"
            echo "---"
        } > "$_BUILD_LOG"

        info "Cloning MainstreamOS/hyprland-scroll-overview (mainstream) into $_SRC_DIR..."
        if ! git -C "$_SRC_DIR" clone --depth=1 --branch mainstream https://github.com/MainstreamOS/hyprland-scroll-overview . \
                >> "$_BUILD_LOG" 2>&1; then
            warn "git clone failed — check network and retry. Build log: $_BUILD_LOG"
            rm -rf "$_SRC_DIR"
        else
            echo "Plugin commit: $(git -C "$_SRC_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)" \
                >> "$_BUILD_LOG"

            info "Compiling scrolloverview ($(nproc) jobs)..."
            if ! make -C "$_SRC_DIR" all -j"$(nproc)" >> "$_BUILD_LOG" 2>&1; then
                warn "scrolloverview make failed — build log: $_BUILD_LOG"
                rm -rf "$_SRC_DIR"
            else
                # --- 3. Install the .so ---
                cp -f "$_SRC_DIR/scrolloverview.so" "$_PLUGIN_PATH"
                info "Installed scrolloverview.so to $_PLUGIN_PATH"
                rm -rf "$_SRC_DIR"

                # --- 4. Prepend ACTIVE plugin directive to general.lua ---
                # Hyprland requires the .so to be loaded *before* its settings
                # block is parsed, so the directive goes at the top of the
                # file. Unlike hyprbars, this is uncommented because the bar's
                # hot corner depends on the plugin being loaded by default.
                if [[ -f "$_GENERAL_LUA" ]]; then
                    if ! grep -qE 'hl\.plugin\.load.*scrolloverview\.so' "$_GENERAL_LUA"; then
                        _tmp=$(mktemp)
                        {
                            echo "-- scrolloverview plugin — built from source at install time"
                            echo "hl.plugin.load(\"${_PLUGIN_PATH}\")"
                            echo ""
                            cat "$_GENERAL_LUA"
                        } > "$_tmp"
                        mv "$_tmp" "$_GENERAL_LUA"
                        info "Prepended hl.plugin.load(\"${_PLUGIN_PATH}\") to $_GENERAL_LUA"
                    else
                        info "$_GENERAL_LUA already references scrolloverview — skipping directive."
                    fi
                else
                    warn "$_GENERAL_LUA not found — add this line manually to a sourced hypr config:"
                    warn "  hl.plugin.load(\"${_PLUGIN_PATH}\")"
                fi
            fi
        fi

        # --- 5. Fix ownership ---
        chown -R "$MAIN_USER:$MAIN_USER" "$_PLUGIN_DATA_DIR" 2>/dev/null || true
        [[ -f "$_GENERAL_LUA" ]] && \
            chown "$MAIN_USER:$MAIN_USER" "$_GENERAL_LUA" 2>/dev/null || true
        info "Ownership of plugin directory set to $MAIN_USER."
    fi
fi


# ---------------------------------------------------------------------------
# GE-PROTON — install latest release and preseed Steam compat-tool default
#
# Mirrors setup_proton_ge() from 3_files.sh, adapted for chroot (root context):
#   1. Fetch the latest release tag from the GitHub API.
#   2. Download + extract the tarball into compatibilitytools.d if not present.
#   3. Seed ~/.steam/root/config/config.vdf with the global CompatToolMapping
#      default; or patch the existing file's "0" entry without touching
#      per-game overrides or any other Steam settings.
#   4. Fix ownership — everything written under $MAIN_USER_HOME must belong
#      to the user, not root.
#
# Notes:
#   - Steam is not running in chroot, so config.vdf writes are safe.
#   - ~/.steam/root is a symlink Steam creates on first launch pointing to
#     ~/.local/share/Steam — pre-creating it as a real directory is fine;
#     Steam will normalise it on first run.
#   - Variables are pre-initialised to "" so set -u is satisfied throughout.
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_USER" ]]; then
    info "GE-Proton: Installing latest release for $MAIN_USER..."

    _GE_COMPAT_DIR="$MAIN_USER_HOME/.steam/root/compatibilitytools.d"
    _GE_CFG_DIR="$MAIN_USER_HOME/.steam/root/config"
    _GE_CFG="$_GE_CFG_DIR/config.vdf"
    _GE_API="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"

    # --- 1. Resolve latest tag (e.g. "GE-Proton10-5") ---
    _GE_JSON=""
    _GE_JSON=$(curl -fsSL "$_GE_API" 2>/dev/null) || true

    if [[ -z "$_GE_JSON" ]]; then
        warn "GE-Proton: GitHub API query failed — check network. Skipping."
    else
        _GE_TAG=""
        if command -v jq &>/dev/null; then
            _GE_TAG=$(echo "$_GE_JSON" | jq -r '.tag_name' 2>/dev/null) || true
        else
            _GE_TAG=$(echo "$_GE_JSON" | python3 -c \
                "import sys,json; print(json.load(sys.stdin)['tag_name'])" 2>/dev/null) || true
        fi

        if [[ -z "$_GE_TAG" || "$_GE_TAG" == "null" ]]; then
            warn "GE-Proton: Could not determine latest tag — skipping."
        else
            info "GE-Proton: Latest tag is $_GE_TAG"

            # --- 2. Download + extract ---
            _GE_INSTALL_DIR="$_GE_COMPAT_DIR/$_GE_TAG"
            if [[ -d "$_GE_INSTALL_DIR" ]]; then
                info "GE-Proton: $_GE_TAG already present — skipping download."
            else
                # GE-Proton now ships an -aarch64 tarball alongside the x86_64
                # build; a broad endswith(".tar.gz") match returns two urls and
                # corrupts the curl arg. Match the exact x86_64 asset name.
                _GE_URL=""
                if command -v jq &>/dev/null; then
                    _GE_URL=$(echo "$_GE_JSON" | \
                        jq -r --arg tag "$_GE_TAG" '.assets[] | select(.name == ($tag + ".tar.gz")) | .browser_download_url' \
                        2>/dev/null) || true
                else
                    _GE_URL=$(echo "$_GE_JSON" | python3 -c "
import sys, json
tag = '$_GE_TAG'
for a in json.load(sys.stdin)['assets']:
    if a['name'] == tag + '.tar.gz':
        print(a['browser_download_url']); break
" 2>/dev/null) || true
                fi

                if [[ -z "$_GE_URL" ]]; then
                    warn "GE-Proton: No .tar.gz asset found for $_GE_TAG — skipping."
                else
                    mkdir -p "$_GE_COMPAT_DIR"
                    _GE_TMP=$(mktemp --suffix=.tar.gz)
                    info "GE-Proton: Downloading $_GE_TAG..."
                    if curl -fL --progress-bar -o "$_GE_TMP" "$_GE_URL"; then
                        info "GE-Proton: Extracting to $_GE_COMPAT_DIR..."
                        tar -xzf "$_GE_TMP" -C "$_GE_COMPAT_DIR"
                        rm -f "$_GE_TMP"
                        info "GE-Proton: Installed $_GE_TAG to $_GE_INSTALL_DIR"
                    else
                        warn "GE-Proton: Download failed — skipping."
                        rm -f "$_GE_TMP"
                    fi
                fi
            fi

            # --- 3. Seed / patch config.vdf ---
            mkdir -p "$_GE_CFG_DIR"
            if [[ ! -f "$_GE_CFG" ]]; then
                info "GE-Proton: Creating $_GE_CFG seeded with $_GE_TAG..."
                cat > "$_GE_CFG" <<EOF
"InstallConfigStore"
{
	"Software"
	{
		"Valve"
		{
			"Steam"
			{
				"CompatToolMapping"
				{
					"0"
					{
						"name"		"$_GE_TAG"
						"config"	""
						"priority"	"1"
					}
				}
			}
		}
	}
}
EOF
                info "GE-Proton: $_GE_CFG created — global default: $_GE_TAG"
            else
                info "GE-Proton: Patching existing $_GE_CFG → global default: $_GE_TAG..."
                python3 - "$_GE_CFG" "$_GE_TAG" <<'PYEOF' \
                    || warn "GE-Proton: config.vdf patch failed — set Proton version manually in Steam."
import sys, re
vdf_path, tag = sys.argv[1], sys.argv[2]
with open(vdf_path) as f:
    content = f.read()
zero_block = (
    '\n\t\t\t\t\t"0"\n'
    '\t\t\t\t\t{\n'
    f'\t\t\t\t\t\t"name"\t\t"{tag}"\n'
    '\t\t\t\t\t\t"config"\t""\n'
    '\t\t\t\t\t\t"priority"\t"1"\n'
    '\t\t\t\t\t}\n\t\t\t\t'
)
ctm_re = re.compile(r'("CompatToolMapping"\s*\{)(.*?)(\})', re.DOTALL)
m = ctm_re.search(content)
if m:
    body = re.sub(r'\s*"0"\s*\{[^}]*\}', '', m.group(2), flags=re.DOTALL)
    new_content = (
        content[:m.start()] + m.group(1) + zero_block + body + m.group(3) + content[m.end():]
    )
    with open(vdf_path, 'w') as f:
        f.write(new_content)
    print(f"Patched: global Proton default → {tag}")
else:
    sys.stderr.write("Warning: CompatToolMapping not found in config.vdf — skipping patch.\n")
PYEOF
            fi

            # --- 4. Fix ownership ---
            # Everything written under $MAIN_USER_HOME must belong to the user,
            # not root (we are running in chroot as root).
            chown -R "$MAIN_USER:$MAIN_USER" "$MAIN_USER_HOME/.steam" 2>/dev/null || true
            info "GE-Proton: Ownership of Steam dirs set to $MAIN_USER."
        fi
    fi
fi

# =============================================================================
# mpris-hyprland
# =============================================================================
# Per-tab MPRIS bridge for Firefox/Zen/LibreWolf/etc. — gives the Hyprland
# media-control panel full track info, position, and YouTube thumbnails for
# any Firefox-based browser. Lightweight alternative to plasma-browser-
# integration (which would drag in ~600MB of KDE deps).
#
# Strategy: clone repo into the target user's ~/Documents/GitHub. If `cargo`
# is available in the chroot, build the host now and install it system-wide
# (binary + native-messaging manifest for every Firefox fork detected) so
# the user only has to load the WebExtension on first browser launch. If
# cargo is missing, leave install.sh for the user to run after first boot.

setup_mpris_hyprland() {
    if [[ -z "${MAIN_USER:-}" || -z "${MAIN_USER_HOME:-}" ]]; then
        warn "mpris-hyprland: MAIN_USER unset; skipping."
        return 0
    fi
    info "mpris-hyprland: configuring per-tab MPRIS bridge for Firefox-based browsers..."

    # The [mainstream] repo already ships the mpris-hyprland package (host binary
    # + native-messaging manifests) and install-dotfiles installs it, so don't
    # re-clone and source-build over the package-owned files. Mirror the dots
    # guard: skip entirely when the package is already present.
    if pacman -Qq mpris-hyprland &>/dev/null; then
        info "mpris-hyprland: package already installed — skipping source build."
        return 0
    fi

    local repo_url="https://github.com/MainstreamOS/mpris-hyprland"
    local target_parent="${MAIN_USER_HOME}/Documents/GitHub"
    local target_dir="${target_parent}/mpris-hyprland"

    install -d -m 0755 -o "$MAIN_USER" -g "$MAIN_USER" \
        "${MAIN_USER_HOME}/Documents" "$target_parent"

    if [[ ! -d "$target_dir/.git" ]]; then
        if ! command -v git >/dev/null 2>&1; then
            warn "mpris-hyprland: git not in chroot; skipping pre-clone."
            return 0
        fi
        if ! sudo -u "$MAIN_USER" git clone --depth 1 "$repo_url" "$target_dir"; then
            warn "mpris-hyprland: clone failed (network?); user can clone manually after first boot."
            return 0
        fi
        info "mpris-hyprland: cloned to $target_dir"
    else
        info "mpris-hyprland: reusing existing checkout at $target_dir"
    fi

    if ! command -v cargo >/dev/null 2>&1; then
        info "mpris-hyprland: rust toolchain not present in chroot — deferring build."
        info "                User runs after first boot:"
        info "                  sudo pacman -S rust && cd '$target_dir' && ./install.sh"
        return 0
    fi

    info "mpris-hyprland: building host (cargo build --release as $MAIN_USER)..."
    if ! sudo -u "$MAIN_USER" bash -lc "cd '$target_dir/host' && cargo build --release"; then
        warn "mpris-hyprland: build failed; user can retry after first boot via $target_dir/install.sh"
        return 0
    fi

    install -Dm0755 "$target_dir/host/target/release/mpris-hyprland-host" \
        /usr/bin/mpris-hyprland-host

    local manifest_src="$target_dir/packaging/firefox-host.json.in"
    local manifest_name="io.github.mainstreamos.firefox_mpris_hyprland.json"

    _mpris_hyprland_write_manifest() {
        local dest_dir="$1"
        install -d -m 0755 "$dest_dir"
        sed 's|@HOST_BINARY@|/usr/bin/mpris-hyprland-host|g' "$manifest_src" > "$dest_dir/$manifest_name"
        chmod 0644 "$dest_dir/$manifest_name"
    }

    _mpris_hyprland_write_manifest /usr/lib/mozilla/native-messaging-hosts
    info "mpris-hyprland: installed system manifest at /usr/lib/mozilla/native-messaging-hosts/"

    # Mirror to every other Firefox-fork system path that exists. Each fork
    # reads native-messaging hosts from a different directory; writing here
    # means the user gets working MPRIS even before the per-user install.sh
    # runs. (zen-browser-bin AUR puts itself at /opt/zen-browser-bin/.)
    local fork
    for fork in /opt/zen-browser-bin/distribution \
                /usr/lib/zen \
                /usr/lib/librewolf \
                /usr/lib/floorp \
                /usr/lib/waterfox; do
        if [[ -d "$fork" ]]; then
            _mpris_hyprland_write_manifest "$fork/native-messaging-hosts"
            info "mpris-hyprland: installed system manifest for $(basename "$fork")."
        fi
    done

    info "mpris-hyprland: system-wide setup complete."
    info "                Final user step (one-time, per browser):"
    info "                  about:debugging#/runtime/this-firefox"
    info "                  → 'Load Temporary Add-on…'"
    info "                  → $target_dir/extension/manifest.json"
}

setup_mpris_hyprland

cleanup_limine_boot_entries

info "Post-install synchronization complete. System is ready for reboot."
