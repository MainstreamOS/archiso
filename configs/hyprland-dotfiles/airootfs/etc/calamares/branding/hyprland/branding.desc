---
componentName: hyprland

### WINDOW CONFIGURATION
# noexpand here is enforced by our CalamaresWindow.cpp fork: when not
# expanding, the main window is locked via setFixedSize() rather than the
# stock resize() hint. setFixedSize sets WM_NORMAL_HINTS minSize == maxSize,
# which tiling compositors (Hyprland) interpret as non-resizable and float
# automatically — no per-WM window rule needed. windowSize must match the
# pane geometry the slideshow PNGs and stylesheet padding were designed
# against (1500x800 → 1232x672 = 1.833:1 slideshow pane).
windowExpanding:    noexpand
windowSize:         1500px,800px
windowPlacement:    center

### PANELS — vertical M3 nav rail on the left, widget Back/Next/Cancel
### at the bottom of the rounded content frame. Side hints are advisory:
### the Mainstream CalamaresWindow fork hardcodes the M3 settings layout.
sidebar:    qml,left
navigation: widget

strings:
    productName:         Mainstream
    shortProductName:    Mainstream OS
    version:             Rolling
    shortVersion:        Rolling
    versionedName:       Mainstream OS
    shortVersionedName:  Mainstream OS
    bootloaderEntryName: Mainstream
    productUrl:          https://mainstreamos.github.io
    supportUrl:          https://github.com/sponsors/MainstreamOS
    knownIssuesUrl:      https://github.com/MainstreamOS/dots-hyprland/issues
    releaseNotesUrl:     https://github.com/MainstreamOS/dots-hyprland/releases

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

slideshow:    "show.qml"
slideshowAPI: 2

# These style keys apply to the fallback widget sidebar only.
# The QML sidebar (calamares-sidebar.qml) defines its own colors inline.
# M3 dark tokens (mirrored from Appearance.qml — m3background, m3onSurfaceVariant,
# m3onSecondaryContainer, m3secondaryContainer).
style:
    SidebarBackground:        "#141313"
    SidebarText:              "#cbc5ca"
    SidebarTextCurrent:       "#ece6e9"
    SidebarBackgroundCurrent: "#4d4b4d"
