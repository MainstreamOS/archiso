/*
 * stylesheet.qss — Mainstream OS Calamares Theme
 *
 * Mainstream OS brand palette (Night base + quiet graphite surfaces).
 *
 * Token reference (see brand.html in MainstreamOS.github.io):
 *   #0B0D12  Abyss        — available brand surface, not the installer base
 *   #191A1F  Night        — installer base / background
 *   #2A2B32  Slate        — elevated / hover / selection container
 *   #40434A  Graphite     — chrome / lines / outlines
 *   #5B5E66  Graphite-soft
 *   #9397A0  Mist         — secondary text
 *   #C9CCD4  Bone         — primary text
 *   #ECE9E3  Ink          — emphasis text on dark
 *   #008DC3  Stream B     — ocean-blue action/focus accent
 *   #009CA5  Stream A     — cyan-teal hover/gradient pair
 *   #9397A0  Mist         — progress track
 *   #C9CCD4  Bone         — progress fill
 */

/* ═══════════════════════════════════════════════════════════════════════════
   BASE
   ═══════════════════════════════════════════════════════════════════════════ */

* {
    outline: none;
}

QWidget {
    background-color: #191A1F;
    color:            #C9CCD4;
    font-family:      "DM Sans", "Google Sans Flex", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size:        14px;
    selection-background-color: #2A2B32;
    selection-color:            #ECE9E3;
}

QWidget:disabled {
    color: #5B5E66;
}

/* ═══════════════════════════════════════════════════════════════════════════
   MAIN WINDOW
   ═══════════════════════════════════════════════════════════════════════════ */

#mainApp {
    background-color: #191A1F;
}

/* ═══════════════════════════════════════════════════════════════════════════
   PAGE CONTENT PADDING
   #viewManager / #viewManagerStack — confirmed objectNames from ViewManager.cpp.
   #viewManager is a plain QWidget whose QVBoxLayout uses contentsRect(), which
   propagates QSS padding so each page is inset 56px from the side rails.
   ═══════════════════════════════════════════════════════════════════════════ */

#viewManager {
    padding-left:  56px;
    padding-right: 56px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════════════════════════════════════ */

QPushButton {
    background-color: #1F2026;
    color:            #C9CCD4;
    border:           1px solid #40434A;
    border-radius:    25px;
    padding:          8px 24px;
    font-size:        14px;
    font-weight:      400;
    min-width:        80px;
    min-height:       36px;
}

QPushButton:hover {
    background-color: #2A2B32;
    color:            #ECE9E3;
    border-color:     #5B5E66;
}

QPushButton:pressed {
    background-color: #40434A;
    color:            #ECE9E3;
}

QPushButton:disabled {
    background-color: #1F2026;
    color:            #5B5E66;
    border-color:     #40434A;
}

/* Primary / default button (Next, Install Now) — Stream B filled */
QPushButton:default,
QPushButton[type="primary"] {
    background-color: #008DC3;
    color:            #ffffff;
    border:           none;
    font-weight:      500;
}

QPushButton:default:hover {
    background-color: #009CA5;
    color:            #ffffff;
}

QPushButton:default:pressed {
    background-color: #007AA8;
}

QPushButton:default:disabled {
    background-color: #2A2B32;
    color:            #5B5E66;
    border:           none;
}

/* ═══════════════════════════════════════════════════════════════════════════
   NAVIGATION BUTTON ICONS
   ═══════════════════════════════════════════════════════════════════════════ */

QPushButton#view-button-back {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/arrow_back.svg);
    icon-size:      18px 18px;
}

QPushButton#view-button-next {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/arrow_forward.svg);
    icon-size:      18px 18px;
}

QPushButton#view-button-cancel {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/close.svg);
    icon-size:      18px 18px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   WELCOME PAGE BUTTON ICONS
   ═══════════════════════════════════════════════════════════════════════════ */

QPushButton#supportButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/help_outline.svg);
    icon-size:      18px 18px;
}

QPushButton#knownIssuesButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/bug_report.svg);
    icon-size:      18px 18px;
}

QPushButton#releaseNotesButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/article.svg);
    icon-size:      18px 18px;
}

QPushButton#donateButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/favorite.svg);
    icon-size:      18px 18px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   LABELS
   ═══════════════════════════════════════════════════════════════════════════ */

QLabel {
    background-color: transparent;
    color:            #C9CCD4;
}

/* ═══════════════════════════════════════════════════════════════════════════
   TEXT INPUT FIELDS — outlined style
   ═══════════════════════════════════════════════════════════════════════════ */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #1F2026;
    color:            #ECE9E3;
    border:           1px solid #40434A;
    border-radius:    12px;
    padding:          10px 16px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #5B5E66;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #008DC3;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #191A1F;
    color:            #5B5E66;
    border-color:     #40434A;
}

/* ═══════════════════════════════════════════════════════════════════════════
   COMBO BOX
   ═══════════════════════════════════════════════════════════════════════════ */

QComboBox {
    background-color: #1F2026;
    color:            #ECE9E3;
    border:           1px solid #40434A;
    border-radius:    12px;
    padding:          7px 14px;
    min-width:        120px;
}

QComboBox:hover  { border-color: #5B5E66; }
QComboBox:focus  { border-color: #008DC3; }

QComboBox::drop-down {
    border:       none;
    width:        32px;
    padding-right: 8px;
}

QComboBox::down-arrow {
    image:  url(/etc/calamares/branding/hyprland/icons/expand_more.svg);
    width:  18px;
    height: 18px;
}

QComboBox QAbstractItemView {
    background-color: #1F2026;
    color:            #ECE9E3;
    border:           1px solid #40434A;
    border-radius:    16px;
    selection-background-color: #2A2B32;
    selection-color:            #ECE9E3;
    padding:          6px;
    outline:          none;
}

QComboBox QAbstractItemView::item {
    border-radius: 10px;
    padding:       8px 12px;
    min-height:    32px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2A2B32;
    color:            #ECE9E3;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2A2B32;
    color:            #ECE9E3;
}

/* ═══════════════════════════════════════════════════════════════════════════
   LISTS, TREES, TABLES
   ═══════════════════════════════════════════════════════════════════════════ */

QListView,
QTreeView,
QTableView {
    background-color: #1F2026;
    color:            #C9CCD4;
    border:           1px solid #40434A;
    border-radius:    12px;
    outline:          none;
    gridline-color:   #40434A;
    alternate-background-color: #1F2026;
}

QListView::item,
QTreeView::item,
QTableView::item {
    padding:       6px 8px;
    border-radius: 8px;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #2A2B32;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #2A2B32;
    color:            #ECE9E3;
}

QHeaderView {
    background-color: #191A1F;
    border:           none;
}

QHeaderView::section {
    background-color: #1F2026;
    color:            #9397A0;
    border:           none;
    border-bottom:    1px solid #40434A;
    padding:          7px 10px;
    font-weight:      500;
}

QHeaderView::section:hover {
    background-color: #2A2B32;
}

/* ═══════════════════════════════════════════════════════════════════════════
   SCROLL BARS
   ═══════════════════════════════════════════════════════════════════════════ */

QScrollBar:vertical {
    background-color: transparent;
    width:            8px;
    margin:           0;
}

QScrollBar::handle:vertical {
    background-color: #40434A;
    border-radius:    4px;
    min-height:       24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5B5E66;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height:           8px;
    margin:           0;
}

QScrollBar::handle:horizontal {
    background-color: #40434A;
    border-radius:    4px;
    min-width:        24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5B5E66;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ═══════════════════════════════════════════════════════════════════════════
   GROUP BOX
   ═══════════════════════════════════════════════════════════════════════════ */

QGroupBox {
    background-color: #191A1F;
    color:            #C9CCD4;
    border-radius:    12px;
    margin-top:       22px;
    padding-top:      12px;
    font-weight:      500;
}

QGroupBox::title {
    subcontrol-origin:   margin;
    subcontrol-position: top left;
    padding:             2px 10px;
    color:               #008DC3;
    background-color:    #191A1F;
    border-radius:       6px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   TREE / LIST VIEW CHECKBOX INDICATORS
   ═══════════════════════════════════════════════════════════════════════════ */

QTreeView::indicator,
QListView::indicator {
    width:  18px;
    height: 18px;
}

QTreeView::indicator:unchecked,
QListView::indicator:unchecked {
    border:           2px solid #40434A;
    border-radius:    4px;
    background-color: transparent;
}

QTreeView::indicator:unchecked:hover,
QListView::indicator:unchecked:hover {
    border-color: #008DC3;
}

QTreeView::indicator:checked,
QListView::indicator:checked {
    border:           2px solid #008DC3;
    border-radius:    4px;
    background-color: #008DC3;
    image: url(/etc/calamares/branding/hyprland/icons/check.svg);
}

QTreeView::indicator:indeterminate,
QListView::indicator:indeterminate {
    border:           2px solid #008DC3;
    border-radius:    4px;
    background-color: #2A2B32;
}

QTreeView::indicator:unchecked:disabled,
QListView::indicator:unchecked:disabled {
    border-color: #40434A;
}

QTreeView::indicator:checked:disabled,
QListView::indicator:checked:disabled {
    background-color: #40434A;
    border-color:     #40434A;
}

/* ═══════════════════════════════════════════════════════════════════════════
   CHECK BOX & RADIO BUTTON
   ═══════════════════════════════════════════════════════════════════════════ */

QCheckBox,
QRadioButton {
    background-color: transparent;
    color:            #C9CCD4;
    spacing:          10px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #5B5E66;
}

QCheckBox::indicator {
    width:         18px;
    height:        18px;
    border:        2px solid #40434A;
    border-radius: 4px;
    background-color: transparent;
}

QCheckBox::indicator:hover {
    border-color: #008DC3;
}

QCheckBox::indicator:checked {
    background-color: #008DC3;
    border-color:     #008DC3;
    image: url(/etc/calamares/branding/hyprland/icons/check.svg);
}

QCheckBox::indicator:checked:disabled {
    background-color: #40434A;
    border-color:     #40434A;
}

QRadioButton::indicator {
    width:         18px;
    height:        18px;
    border:        2px solid #40434A;
    border-radius: 9px;
    background-color: transparent;
}

QRadioButton::indicator:hover {
    border-color: #008DC3;
}

QRadioButton::indicator:checked {
    background-color: #008DC3;
    border-color:     #008DC3;
}

/* ═══════════════════════════════════════════════════════════════════════════
   PROGRESS BAR
   ═══════════════════════════════════════════════════════════════════════════ */

QProgressBar {
    background-color: #9397A0;
    border:           none;
    border-radius:    6px;
    text-align:       center;
    color:            #191A1F;
    font-size:        13px;
    font-weight:      700;
    min-height:       8px;
}

QProgressBar::chunk {
    background-color: #C9CCD4;
    border-radius:    6px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   TAB WIDGET
   ═══════════════════════════════════════════════════════════════════════════ */

QTabWidget::pane {
    background-color: #191A1F;
    border-radius:    12px;
    top:              -1px;
}

QTabBar::tab {
    background-color: transparent;
    color:            #9397A0;
    border:           none;
    padding:          8px 18px;
    border-radius:    8px;
    min-width:        60px;
}

QTabBar::tab:selected {
    background-color: #2A2B32;
    color:            #ECE9E3;
    font-weight:      500;
}

QTabBar::tab:hover:!selected {
    background-color: #2A2B32;
    color:            #C9CCD4;
}

/* ═══════════════════════════════════════════════════════════════════════════
   SPIN BOX
   ═══════════════════════════════════════════════════════════════════════════ */

QSpinBox,
QDoubleSpinBox {
    background-color: #1F2026;
    color:            #ECE9E3;
    border:           1px solid #40434A;
    border-radius:    12px;
    padding:          7px 12px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #008DC3;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border:           none;
    width:            18px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   TOOLTIP
   ═══════════════════════════════════════════════════════════════════════════ */

QToolTip {
    background-color: #2A2B32;
    color:            #ECE9E3;
    border-radius:    8px;
    padding:          6px 10px;
    font-size:        13px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   FRAME / SEPARATOR
   ═══════════════════════════════════════════════════════════════════════════ */

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color:            #40434A;
    background-color: #40434A;
}

/* ═══════════════════════════════════════════════════════════════════════════
   MENU
   ═══════════════════════════════════════════════════════════════════════════ */

QMenu {
    background-color: #1F2026;
    color:            #ECE9E3;
    border:           1px solid #40434A;
    border-radius:    12px;
    padding:          6px;
}

QMenu::item {
    padding:       8px 16px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #2A2B32;
    color:            #ECE9E3;
}

QMenu::separator {
    height:           1px;
    background-color: #40434A;
    margin:           4px 8px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   CALAMARES-SPECIFIC PARTITION VIEW
   ═══════════════════════════════════════════════════════════════════════════ */

#partitionBarView {
    background-color: #191A1F;
    border-radius:    8px;
}

PartitionBarsView {
    color:            #C9CCD4;
    background-color: transparent;
}

PartitionLabelsView {
    color:            #C9CCD4;
    background-color: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════════
   QUICK WIDGET HOST
   ═══════════════════════════════════════════════════════════════════════════ */

QQuickWidget {
    background-color: #191A1F;
    border:           none;
}
