/* =============================================================================
 * stylesheet.qss — Mainstream OS Calamares theme
 *
 * Material 3 dark palette mirrored from the live Quickshell appearance system
 * (~/.config/quickshell/ii/modules/common/Appearance.qml). The intent is for
 * Calamares to look and feel like a native dotfiles app: pill buttons, M3
 * filled/tonal/text variants, outlined inputs with primary focus underline,
 * surface-container popups, layer-aware hover/pressed states.
 *
 * Token map (kept in comments so future palette syncs stay greppable):
 *   m3background           #141313  page bg
 *   m3onBackground         #e6e1e1  primary text
 *   m3surfaceContainerLow  #1c1b1c  layer1 (cards, inputs)
 *   m3surfaceContainer     #201f20  layer2 (sections)
 *   m3surfaceContainerHigh #2b2a2a  layer3 (popups, hover)
 *   m3surfaceContainerHighest #363435 spin/active inputs
 *   m3onSurface            #e6e1e1  text on surfaces
 *   m3onSurfaceVariant     #cbc5ca  secondary text / labels
 *   m3outline              #948f94  borders
 *   m3outlineVariant       #49464a  dividers / idle indicator borders
 *   m3primary              #cbc4cb  primary action bg / focus ring
 *   m3onPrimary            #322f34  text on primary
 *   m3secondaryContainer   #4d4b4d  tonal button bg, combo bg
 *   m3onSecondaryContainer #ece6e9  text on tonal
 *   m3error                #ffb4ab  error fg
 *   m3errorContainer       #93000a  error bg
 *   m3onErrorContainer     #ffdad6  text on error bg
 *   m3success              #B5CCBA  success fg
 *
 * Shapes:
 *   button.pill            border-radius: 9999px  (Appearance.rounding.full)
 *   verysmall              8px                    (chip / small popup item)
 *   small                  12px                   (input / list / tree)
 *   normal                 17px                   (popup, card)
 *   large                  23px                   (window-level container)
 *
 * Fonts: Google Sans Flex is set globally by main.cpp (Mainstream font patch).
 * ============================================================================= */

* {
    outline: none;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * BASE
 *
 * Container QWidgets default to transparent so the rounded #contentFrame
 * surface shows through. Top-level chrome (#mainApp, #titleBar) and named
 * styled widgets explicitly set their own backgrounds below.
 * ──────────────────────────────────────────────────────────────────────────── */
QWidget {
    background-color: transparent;
    color:            #e6e1e1;                     /* m3onBackground */
    font-family:      "Google Sans Flex", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size:        15px;                        /* Appearance.font.pixelSize.small */
    selection-background-color: #4d4b4d;           /* m3secondaryContainer */
    selection-color:            #ece6e9;           /* m3onSecondaryContainer */
}

QWidget:disabled {
    color: rgba(230, 225, 225, 0.38);              /* m3onSurface @ 38% (M3 disabled spec) */
}

/* ─────────────────────────────────────────────────────────────────────────────
 * MAIN WINDOW + TITLE BAR + CONTENT FRAME
 *
 * Mirrors dots-hyprland Quickshell settings.qml:
 *   #mainApp      = m3background canvas, 8px outer margin (set in C++)
 *   #titleBar     = transparent strip, centered title + close button
 *   #contentFrame = rounded m3surfaceContainerLow card holding the install
 *                   step UI and the bottom Back/Next/Cancel row
 * ──────────────────────────────────────────────────────────────────────────── */
#mainApp {
    background-color: #141313;                     /* m3background */
    border-radius:    18px;                        /* Appearance.rounding.windowRounding */
}

#titleBar {
    background-color: transparent;
}

#titleLabel {
    color:       #e6e1e1;
    font-size:   18px;                             /* Appearance.font.pixelSize.title */
    font-weight: 500;
    background-color: transparent;
}

/* Frameless-window close button — round, transparent until hovered */
QPushButton#titleCloseButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/close.svg);
    icon-size:      20px 20px;
    background-color: transparent;
    color:            #cbc5ca;
    border:           1px solid transparent;       /* Qt6 needs an explicit border for radius */
    border-radius:    17px;                        /* 35/2 = pill */
    min-width:        35px;
    min-height:       35px;
    max-width:        35px;
    max-height:       35px;
    padding:          0;
}

QPushButton#titleCloseButton:hover {
    background-color: #2b2a2a;                     /* m3surfaceContainerHigh */
}

QPushButton#titleCloseButton:pressed {
    background-color: #363435;                     /* m3surfaceContainerHighest */
}

#contentFrame {
    background-color: #1c1b1c;                     /* m3surfaceContainerLow */
    border-radius:    14px;                        /* windowRounding (18) − contentPadding (8) ≈ 10–14 */
}

/* Central widget sits inside #contentFrame — let the frame's color show through. */
#viewManager {
    background-color: transparent;
    padding-left:     32px;                        /* trimmed from 56: the frame already provides visual containment */
    padding-right:    32px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * BUTTONS
 *
 * Material 3 button variants mapped to Calamares roles:
 *   #view-button-next   → filled (primary action)
 *   #view-button-back   → tonal  (secondary)
 *   #view-button-cancel → text   (tertiary; transparent)
 *   default QPushButton → tonal
 *   support/issues/notes/donate → tonal
 * ──────────────────────────────────────────────────────────────────────────── */

/* Default + nav buttons — sized and coloured to match the toggled state of
 * a dots-hyprland QuickConfig SelectionGroupButton (e.g. the "Bar position"
 * row under "Bar & screen").
 *
 * The QML pill's actual rendered height comes from
 *   Button.implicitHeight = contentItem.implicitHeight + verticalPadding * 2
 * (≈ 38px once the StyledText label is laid out). The Rectangle background
 * inside it has implicitHeight: 50 but that does NOT propagate to the Button
 * itself, so QuickConfig pills end up around 38px tall — visibly shorter
 * and tighter than the 50-px-tall slabs the previous QSS produced.
 *
 * Match the Quickshell pill exactly:
 *   • min-height 38                → Button.implicitHeight
 *   • padding    4px 14px          → verticalPadding 4, horizontalPadding 14
 *                                   (Qt's box model adds padding on top of
 *                                    min-height, so a 4-px vertical pad on a
 *                                    38-min keeps total ≈ 38–46 — same band
 *                                    as the QML pill once content is laid in)
 *   • border-radius 19px           → height/2, full pill
 *   • min-width 60                 → loose enough not to force "Back" wider
 *                                   than its content + 2*horizontalPadding
 *   • font-size 14, weight 500     → matches Appearance.font.pixelSize.normal
 *   • toggled background           → colPrimary  #cbc4cb
 *   • toggled foreground           → colOnPrimary #322f34
 * Hover / pressed state layers approximate colPrimaryHover / colPrimaryActive.
 * Qt6 QPushButton drops border-radius unless an explicit border is set
 * (even transparent), hence the 1px transparent border on every state. */
QPushButton {
    background-color: #cbc4cb;                     /* m3primary — "selected" group-button fill */
    color:            #322f34;                     /* m3onPrimary — darker text/icon */
    border:           1px solid transparent;
    border-radius:    19px;                        /* full pill on a ~38px tall button */
    padding:          4px 14px;                    /* matches Quickshell pill content padding */
    font-size:        14px;
    font-weight:      500;
    min-width:        60px;
    min-height:       38px;
}

QPushButton:hover {
    background-color: #beb6be;                     /* m3primary + ~8% onPrimary state layer */
}

QPushButton:pressed {
    background-color: #b6aeb6;                     /* m3primary + ~12% onPrimary state layer */
}

QPushButton:disabled {
    background-color: rgba(230, 225, 225, 0.12);   /* m3onSurface @ 12% */
    color:            rgba(230, 225, 225, 0.38);
}

/* Back / Next / Cancel — same dimensions and colours as the default. The
 * separate selector exists so future per-action tweaks have a hook without
 * touching every other QPushButton. */
QPushButton#view-button-back,
QPushButton#view-button-next,
QPushButton#view-button-cancel {
    background-color: #cbc4cb;                     /* m3primary */
    color:            #322f34;                     /* m3onPrimary */
    border:           1px solid transparent;
    border-radius:    19px;
    padding:          4px 14px;
    font-size:        14px;
    font-weight:      500;
    min-width:        60px;
    min-height:       38px;
}

QPushButton#view-button-back:hover,
QPushButton#view-button-next:hover,
QPushButton#view-button-cancel:hover {
    background-color: #beb6be;
}

QPushButton#view-button-back:pressed,
QPushButton#view-button-next:pressed,
QPushButton#view-button-cancel:pressed {
    background-color: #b6aeb6;
}

QPushButton#view-button-back:disabled,
QPushButton#view-button-next:disabled,
QPushButton#view-button-cancel:disabled {
    background-color: rgba(230, 225, 225, 0.12);
    color:            rgba(230, 225, 225, 0.38);
}

/* QPushButton:default still picks up the generic tonal style above — no
 * primary-filled override now that all three nav buttons match the rail. */

/* About / Debug sidebar buttons render flat */
QPushButton#aboutButton,
QPushButton#debugButton {
    background-color: transparent;
    color:            #cbc5ca;                     /* m3onSurfaceVariant */
    border:           none;
    border-radius:    9999px;
    padding:          8px 12px;
    min-width:        0;
    min-height:       32px;
    text-align:       left;
}

QPushButton#aboutButton:hover,
QPushButton#debugButton:hover {
    background-color: rgba(230, 225, 225, 0.08);
}

/* ─────────────────────────────────────────────────────────────────────────────
 * NAVIGATION BUTTON ICONS
 * ──────────────────────────────────────────────────────────────────────────── */
QPushButton#view-button-back {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/arrow_back.svg);
    icon-size:      18px 18px;
}
QPushButton#view-button-next {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/arrow_forward.svg);
    icon-size:      18px 18px;
}
QPushButton#view-button-cancel {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/close-dark.svg);
    icon-size:      18px 18px;
}

/* Welcome page link buttons */
QPushButton#supportButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/help_outline.svg);
    icon-size:      18px 18px;
}
QPushButton#knownIssuesButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/bug_report.svg);
    icon-size:      18px 18px;
}
QPushButton#releaseNotesButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/article.svg);
    icon-size:      18px 18px;
}
QPushButton#donateButton {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/favorite.svg);
    icon-size:      18px 18px;
}

/* Keyboard page — "restore defaults" button next to the model dropdown.
 * The default Calamares keyboard module bakes a light-grey restore.png
 * into its Qt resource bundle; that icon disappears against the filled
 * m3primary button surface, so swap in the dark M3 refresh glyph. */
QPushButton#buttonRestore {
    qproperty-icon: url(/etc/calamares/branding/hyprland/icons/restore.svg);
    icon-size:      18px 18px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * LABELS
 * ──────────────────────────────────────────────────────────────────────────── */
QLabel {
    background-color: transparent;
    color:            #e6e1e1;                     /* m3onSurface */
}

/* Section headers and helper text */
QLabel[heading="true"] {
    color:       #e6e1e1;
    font-size:   19px;                             /* font.pixelSize.larger */
    font-weight: 500;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * TEXT INPUTS — M3 outlined
 * ──────────────────────────────────────────────────────────────────────────── */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: transparent;                 /* outlined variant has no fill */
    color:            #e6e1e1;
    border:           1px solid #948f94;           /* m3outline */
    border-radius:    12px;                        /* Appearance.rounding.small */
    padding:          10px 16px;
    selection-background-color: #4d4b4d;
    selection-color:            #ece6e9;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #cbc5ca;                         /* m3onSurfaceVariant — hover state */
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border:        2px solid #cbc4cb;              /* m3primary 2px focus ring */
    padding:       9px 15px;                       /* compensate for thicker border */
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color:        rgba(230, 225, 225, 0.38);
    border-color: rgba(148, 143, 148, 0.38);
}

/* Validation error styling — Calamares sets `_error` dynamic property on bad input */
QLineEdit[_error="true"] {
    border-color: #ffb4ab;                         /* m3error */
}
QLineEdit[_error="true"]:focus {
    border:  2px solid #ffb4ab;
    padding: 9px 15px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * COMBO BOX — M3 tonal pill, surfaceContainerHigh popup
 * ──────────────────────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #4d4b4d;                     /* m3secondaryContainer */
    color:            #ece6e9;
    border:           none;
    border-radius:    20px;                        /* pill at 40px tall */
    padding:          8px 16px;
    min-width:        120px;
    min-height:       24px;
}

QComboBox:hover {
    background-color: #5a585a;
}

QComboBox:focus,
QComboBox:on {
    background-color: #67656a;
}

QComboBox:disabled {
    background-color: rgba(230, 225, 225, 0.12);
    color:            rgba(230, 225, 225, 0.38);
}

QComboBox::drop-down {
    border:        none;
    width:         32px;
    padding-right: 8px;
    background:    transparent;
}

QComboBox::down-arrow {
    image:  url(/etc/calamares/branding/hyprland/icons/expand_more.svg);
    width:  18px;
    height: 18px;
}

/* QComboBox popup — translated from dots-hyprland StyledComboBox.qml:
 *   • surfaceContainerHigh elevated container at Appearance.rounding.normal
 *     (16px). The popup *window* itself is masked to the same 16px rounded
 *     rect by ComboBoxPopupStyler in CalamaresApplication.cpp, so nothing
 *     is drawn outside the rounded shape — the dark installer surface no
 *     longer leaks through the corners.
 *   • 8px padding so items inset cleanly inside the rounded container.
 *   • 40px tall delegate rows with 2px gap between items (popup ListView
 *     `spacing: 2`).
 *   • Item background radius = Appearance.rounding.small (8px), with a 4px
 *     horizontal margin so the rounded selection sits visibly inside the
 *     popup edge — mirrors the welcome page's QListView behaviour and stops
 *     QComboBox dropdowns (region, zone, keyboard model, switch keyboard,
 *     select storage device) from rendering an edge-to-edge square highlight.
 *   • An explicit `selection-background-color` is required: leaving it
 *     transparent causes Qt to paint its native blue selection over the
 *     `::item:selected` layer for QComboBox-internal views. */
QComboBox QAbstractItemView {
    background-color: #2b2a2a;                     /* m3surfaceContainerHigh — popup elevated surface */
    color:            #cbc5ca;                     /* m3onSurfaceVariant — onLayer3 in dots-hyprland */
    border:           none;                        /* shadow-only frame, no outline */
    border-radius:    16px;                        /* Appearance.rounding.normal — outer popup window also masked to this radius */
    selection-background-color: #4d4b4d;           /* m3secondaryContainer — matches ::item:selected below */
    selection-color:  #ece6e9;                     /* m3onSecondaryContainer */
    padding:          8px;                         /* matches popup.padding */
    outline:          none;
}

QComboBox QAbstractItemView::item {
    margin:        1px 4px;                        /* horizontal inset matches QListView item highlight */
    border-radius: 8px;                            /* Appearance.rounding.small */
    padding:       0 12px;                         /* 12px insets — anchors.{left,right}Margin */
    min-height:    40px;                           /* delegate implicitHeight */
    color:         #cbc5ca;                        /* onLayer3 for non-current rows */
}

/* Non-current row state layers — colLayer3 at increasing opacity. */
QComboBox QAbstractItemView::item:hover {
    background-color: rgba(230, 225, 225, 0.08);   /* colLayer3Hover  ≈ onSurface @ 8%  */
}

QComboBox QAbstractItemView::item:pressed {
    background-color: rgba(230, 225, 225, 0.12);   /* colLayer3Active ≈ onSurface @ 12% */
}

/* Current row — solid secondaryContainer with its own state layers, mirroring
 * the QML delegate's `(root.currentIndex === itemDelegate.index)` branch. */
QComboBox QAbstractItemView::item:selected {
    background-color: #4d4b4d;                     /* colSecondaryContainer */
    color:            #ece6e9;                     /* colOnSecondaryContainer */
}

QComboBox QAbstractItemView::item:selected:hover {
    background-color: #5a585a;                     /* colSecondaryContainerHover */
}

QComboBox QAbstractItemView::item:selected:pressed {
    background-color: #67656a;                     /* colSecondaryContainerActive */
}

/* ─────────────────────────────────────────────────────────────────────────────
 * LISTS / TREES / TABLES
 * ──────────────────────────────────────────────────────────────────────────── */
QListView,
QTreeView,
QTableView {
    background-color: #1c1b1c;                     /* m3surfaceContainerLow */
    color:            #e6e1e1;
    border:           1px solid #49464a;           /* m3outlineVariant */
    border-radius:    12px;
    outline:          none;
    gridline-color:   #49464a;
    alternate-background-color: #1c1b1c;
    padding:          4px;                         /* breathing room so :selected highlight stays inside rounded view */
}

QListView::item,
QTreeView::item,
QTableView::item {
    margin:        1px 4px;                        /* horizontal inset for rounded selection */
    padding:       8px 8px;
    border-radius: 8px;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: rgba(230, 225, 225, 0.08);
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #4d4b4d;                     /* m3secondaryContainer */
    color:            #ece6e9;
}

/* Branch cell — chevrons render with no backdrop in any state on the
 * netinstall / packagechooser tree. Hover and selection highlights stay
 * on QTreeView::item only, so the dropdown arrows themselves never get
 * a coloured pill behind them. */
QTreeView::branch,
QTreeView::branch:hover,
QTreeView::branch:selected,
QTreeView::branch:selected:active,
QTreeView::branch:selected:!active {
    background-color: transparent;
    border:           none;
}

/* Custom chevrons replace the default Qt branch dotted-line indicator.
 * The four selectors are required to cover the full Qt branch state matrix
 * (siblings/no-siblings × open/closed). Ditto image-position drawing. */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:has-children:has-siblings:closed {
    image: url(/etc/calamares/branding/hyprland/icons/chevron_right.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(/etc/calamares/branding/hyprland/icons/expand_more.svg);
}

QHeaderView {
    background-color: transparent;
    border:           none;
}

QHeaderView::section {
    background-color: #201f20;                     /* m3surfaceContainer */
    color:            #cbc5ca;                     /* m3onSurfaceVariant */
    border:           none;
    border-bottom:    1px solid #49464a;
    padding:          8px 12px;
    font-weight:      500;
}

QHeaderView::section:hover {
    background-color: #2b2a2a;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * TREE / LIST CHECKBOX INDICATORS (used by netinstall / packagechooser)
 * ──────────────────────────────────────────────────────────────────────────── */
QTreeView::indicator,
QListView::indicator {
    width:  18px;
    height: 18px;
}

QTreeView::indicator:unchecked,
QListView::indicator:unchecked {
    border:           2px solid #948f94;           /* m3outline */
    border-radius:    2px;                         /* M3 checkbox radius */
    background-color: transparent;
}

QTreeView::indicator:unchecked:hover,
QListView::indicator:unchecked:hover {
    border-color: #e6e1e1;
}

QTreeView::indicator:checked,
QListView::indicator:checked {
    border:           2px solid #cbc4cb;
    border-radius:    2px;
    background-color: #cbc4cb;                     /* m3primary */
    image:            url(/etc/calamares/branding/hyprland/icons/check.svg);
}

QTreeView::indicator:indeterminate,
QListView::indicator:indeterminate {
    border:           2px solid #cbc4cb;
    border-radius:    2px;
    background-color: #cbc4cb;
}

QTreeView::indicator:disabled,
QListView::indicator:disabled {
    border-color:     rgba(148, 143, 148, 0.38);
    background-color: transparent;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * CHECK BOX & RADIO BUTTON
 * ──────────────────────────────────────────────────────────────────────────── */
QCheckBox,
QRadioButton {
    background-color: transparent;
    color:            #e6e1e1;
    spacing:          12px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: rgba(230, 225, 225, 0.38);
}

/* M3 checkbox: 18×18, 2px outline, primary fill on checked */
QCheckBox::indicator {
    width:            18px;
    height:           18px;
    border:           2px solid #948f94;           /* m3outline */
    border-radius:    2px;
    background-color: transparent;
}

QCheckBox::indicator:hover {
    border-color: #e6e1e1;
}

QCheckBox::indicator:checked {
    background-color: #cbc4cb;                     /* m3primary */
    border-color:     #cbc4cb;
    image:            url(/etc/calamares/branding/hyprland/icons/check.svg);
}

QCheckBox::indicator:checked:disabled {
    background-color: rgba(230, 225, 225, 0.12);
    border-color:     rgba(230, 225, 225, 0.12);
}

QCheckBox::indicator:unchecked:disabled {
    border-color: rgba(148, 143, 148, 0.38);
}

/* M3 radio: 20×20 outer ring, 10×10 inner dot when checked */
QRadioButton::indicator {
    width:            20px;
    height:           20px;
    border:           2px solid #948f94;
    border-radius:    10px;
    background-color: transparent;
}

QRadioButton::indicator:hover {
    border-color: #e6e1e1;
}

QRadioButton::indicator:checked {
    border:           2px solid #cbc4cb;
    background-color: transparent;
    image:            url(/etc/calamares/branding/hyprland/icons/radio_dot.svg);
}

QRadioButton::indicator:disabled {
    border-color: rgba(148, 143, 148, 0.38);
}

/* ─────────────────────────────────────────────────────────────────────────────
 * GROUP BOX
 * ──────────────────────────────────────────────────────────────────────────── */
QGroupBox {
    background-color: #1c1b1c;                     /* m3surfaceContainerLow */
    color:            #e6e1e1;
    border:           1px solid #49464a;
    border-radius:    17px;                        /* Appearance.rounding.normal */
    margin-top:       18px;
    padding:          18px 16px 12px 16px;
    font-weight:      500;
}

QGroupBox::title {
    subcontrol-origin:   margin;
    subcontrol-position: top left;
    left:                14px;
    padding:             2px 8px;
    color:               #cbc5ca;                  /* m3onSurfaceVariant */
    background-color:    #141313;
    border-radius:       6px;
    font-size:           13px;                     /* font.pixelSize.smallie */
}

/* ─────────────────────────────────────────────────────────────────────────────
 * PROGRESS BAR
 * ──────────────────────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #49464a;                     /* m3outlineVariant — track */
    border:           none;
    border-radius:    3px;                         /* near-square corners */
    text-align:       center;
    color:            #141313;                     /* m3background — darkest, sits on light chunk */
    font-size:        13px;
    font-weight:      600;
    min-height:       22px;
}

QProgressBar::chunk {
    background-color: #cbc4cb;                     /* m3primary — fill */
    border-radius:    3px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * SCROLL BARS — minimal track, pill-style handle
 * ──────────────────────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: transparent;
    width:            8px;
    margin:           0;
}

QScrollBar::handle:vertical {
    background-color: #49464a;                     /* m3outlineVariant */
    border-radius:    4px;
    min-height:       24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #948f94;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height:           8px;
    margin:           0;
}

QScrollBar::handle:horizontal {
    background-color: #49464a;
    border-radius:    4px;
    min-width:        24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #948f94;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * TAB BAR (used by partition core + a few wizards)
 * ──────────────────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    background-color: transparent;
    border:           none;
    top:              -1px;
}

QTabBar::tab {
    background-color: transparent;
    color:            #cbc5ca;                     /* m3onSurfaceVariant */
    border:           none;
    padding:          8px 18px;
    border-radius:    9999px;                      /* M3 secondary tab pill */
    min-width:        60px;
    margin-right:     4px;
}

QTabBar::tab:selected {
    background-color: #4d4b4d;                     /* m3secondaryContainer */
    color:            #ece6e9;
    font-weight:      500;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(230, 225, 225, 0.08);
    color:            #e6e1e1;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * SPIN BOX
 * ──────────────────────────────────────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: transparent;
    color:            #e6e1e1;
    border:           1px solid #948f94;
    border-radius:    12px;
    padding:          8px 12px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #cbc5ca;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border:  2px solid #cbc4cb;
    padding: 7px 11px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border:           none;
    width:            18px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * SLIDER
 * ──────────────────────────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #49464a;
    height:           4px;
    border-radius:    2px;
}

QSlider::sub-page:horizontal {
    background-color: #cbc4cb;
    border-radius:    2px;
}

QSlider::handle:horizontal {
    background-color: #cbc4cb;
    width:            16px;
    height:           16px;
    margin:           -6px 0;
    border-radius:    8px;
}

QSlider::handle:horizontal:hover {
    background-color: #d6d0d6;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * TOOLTIP
 * ──────────────────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #2b2a2a;                     /* m3surfaceContainerHigh */
    color:            #e6e1e1;
    border:           1px solid #49464a;
    border-radius:    8px;
    padding:          6px 10px;
    font-size:        13px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * FRAME / SEPARATOR — HLine / VLine
 * ──────────────────────────────────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color:            #49464a;
    background-color: #49464a;
    max-height:       1px;
    max-width:        1px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * MENU
 * ──────────────────────────────────────────────────────────────────────────── */
QMenu {
    background-color: #2b2a2a;                     /* m3surfaceContainerHigh */
    color:            #e6e1e1;
    border:           1px solid #49464a;
    border-radius:    17px;                        /* Appearance.rounding.normal */
    padding:          6px;
}

QMenu::item {
    padding:       8px 16px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: rgba(230, 225, 225, 0.08);
}

QMenu::separator {
    height:           1px;
    background-color: #49464a;
    margin:           4px 8px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * MESSAGE BOX (warnings, partition confirmations)
 * ──────────────────────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #201f20;                     /* m3surfaceContainer */
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * CALAMARES-SPECIFIC PARTITION VIEW
 * ──────────────────────────────────────────────────────────────────────────── */
#partitionBarView {
    background-color: transparent;
    border:           none;
}

PartitionBarsView,
PartitionLabelsView {
    background-color: transparent;
    color:            #e6e1e1;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * QQUICK WIDGET HOST
 * ──────────────────────────────────────────────────────────────────────────── */
QQuickWidget {
    background-color: transparent;
    border:           none;
}
