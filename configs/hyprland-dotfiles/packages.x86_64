# ==============================================================================
# Calamares installer (live only — removed by packages.conf on install)
# Built from pkgbuilds/calamares-mainstream/ — patches state-ok/error SVGs
# with the Mainstream branding icons before compilation.
# ==============================================================================
calamares-mainstream
ckbcomp
hwinfo
kcrash
kpmcore
qt6-declarative
yaml-cpp
kcoreaddons
# flatpak on the LIVE side so the pacmanflatpak backend can run
# `flatpak ... install` from the live env — bwrap in the live kernel
# context has the namespace permissions that the same call lacks inside
# the target chroot, so apply_extra refs (Chrome, Spotify) install cleanly.
flatpak

# ==============================================================================
# Web browser
# ==============================================================================
# Shipped on the live ISO so the welcome/dock/browser buttons work. Removed
# from the target in pre-install and re-added by netinstall (pre-checked) if
# the user keeps it — so unchecking it in the installer cleanly omits it.
chromium

# ==============================================================================
# Live environment extras (live only — removed by packages.conf on install)
# ==============================================================================
nano
openssh
less
man-db
terminus-font
testdisk
os-prober
