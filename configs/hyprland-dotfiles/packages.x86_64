# flatpak on the LIVE side so PMYay can run `flatpak --sysroot=<target>
# install ...` from the live env — bwrap in the live kernel context has
# the namespace permissions that the same call lacks inside the target
# chroot, so apply_extra refs (Chrome, Spotify) install cleanly.
flatpak

