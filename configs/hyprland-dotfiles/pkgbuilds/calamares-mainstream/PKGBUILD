# Maintainer: Mainstream <https://github.com/MainstreamOS>
#
# Builds Calamares directly from the MainstreamOS fork's `mainstream`
# branch (https://github.com/MainstreamOS/calamares). The fork carries
# all Mainstream-specific source patches as proper commits, so this
# PKGBUILD is now a thin wrapper: clone, cmake, install. No prepare()
# step.
#
# Versioning:
#   - pkgver tracks upstream Calamares CMakeLists.txt CALAMARES_VERSION.
#   - pkgrel is bumped manually when only the Mainstream patches change
#     and upstream is unchanged.
#   - Run `sudo ./build.sh --cleancal` to force a rebuild from the tip
#     of mainstream regardless of pkgver/pkgrel — the existing pkg cache
#     is wiped first, so the next ISO build picks up the new clone.
#
# To pin to an older known-good commit during incidents, set
# CALAMARES_REF in the build environment, e.g.:
#   CALAMARES_REF=v3.4.3 sudo ./build.sh --cleancal

pkgname=calamares-mainstream
pkgver=3.4.3
pkgrel=3
pkgdesc='Distribution-independent installer framework (Mainstream edition)'
arch=('x86_64')
url='https://github.com/MainstreamOS/calamares'
license=('GPL-3.0-only' 'LGPL-2.1-or-later')

depends=(
    # KDE Frameworks 6 — Arch packages use bare names (no kf6- prefix)
    'kconfig'
    'kcoreaddons'
    'kiconthemes'
    'ki18n'
    'kio'
    'solid'
    'kpackage'
    # Qt 6
    'qt6-base'
    'qt6-svg'
    'qt6-declarative'
    'qt6-5compat'
    # Disk / partition tools
    'kpmcore'
    'parted'
    'udisks2'
    'polkit-qt6'
    # Misc runtime
    'boost-libs'
    'yaml-cpp'
    'hwinfo'
    'libpwquality'
    'squashfs-tools'
    'efibootmgr'
    'gtk-update-icon-cache'
    'icu'
    'python'
    # Note: ckbcomp (keyboard layout tool) is AUR-only on Arch.
    # It is listed in packages.x86_64 and built via AUR_DEPS in
    # build.sh --refresh rather than declared here to avoid dep-resolution
    # failures during makepkg -s.
)

makedepends=(
    'extra-cmake-modules'
    'qt6-tools'
    'boost'
    'cmake'
    'ninja'
    'git'
)

provides=('calamares')
conflicts=('calamares')

# Source the mainstream branch directly. The #branch= fragment makes
# makepkg track the tip of that branch; pkgver() below derives a
# repeatable version string from the working tree.
_branch="${CALAMARES_REF:-mainstream}"
source=("calamares::git+https://github.com/MainstreamOS/calamares.git#branch=${_branch}")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/calamares"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DWITH_QT6=ON \
        -DWITH_PYBIND11=ON \
        -DWITH_PYTHONQT=OFF \
        -DBoost_NO_BOOST_CMAKE=ON \
        -DSKIP_MODULES="tracking webview interactiveterminal \
                        dracut dracutlukscfg \
                        dummyprocess dummypython dummycpp dummypythonqt \
                        services-openrc"

    cmake --build build
}

package() {
    cd "${srcdir}/calamares"
    DESTDIR="${pkgdir}" cmake --install build
}
